@rendermode InteractiveServer
@implements IDisposable
@using System.Security.Claims
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav

<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
         Dense="true" ListClass="notification-list">
    <ActivatorContent>
        <MudTooltip Text="Notifications">
            <MudBadge Content="_unread" Max="99" Color="Color.Error" Overlap="true"
                      Visible="_unread > 0">
                <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" />
            </MudBadge>
        </MudTooltip>
    </ActivatorContent>

    <ChildContent>
        <div class="d-flex align-center px-4 py-2" style="min-width:340px;">
            <MudText Typo="Typo.subtitle2">Notifications</MudText>
            <MudSpacer />
            @if (_unread > 0)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="MarkAllReadAsync">
                    Mark all read
                </MudButton>
            }
        </div>
        <MudDivider />

        @if (_items.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="pa-6 text-center mud-text-secondary"
                     Style="max-width:340px;">
                Nothing waiting.
            </MudText>
        }
        else
        {
            @foreach (var item in _items)
            {
                <MudMenuItem OnClick="@(() => OpenAsync(item))">
                    <div style="max-width:320px;white-space:normal;">
                        <MudText Typo="Typo.body2"><b>@item.Subject</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @Summarise(item.Body)
                        </MudText>
                    </div>
                </MudMenuItem>
            }
        }
    </ChildContent>
</MudMenu>

@code {
    // The bell polls rather than pushing. A push would mean the dispatcher
    // reaching into live circuits, and this costs one indexed count per user
    // per interval - the index on (UserId, ReadUtc, DismissedUtc) exists for it.
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);

    /// <summary>
    /// Not <c>ICurrentUser</c>: that reads <c>IHttpContextAccessor</c>, and there
    /// is no HttpContext once this component is running over its circuit. It
    /// would report nobody, and the bell would sit silently empty for ever.
    /// </summary>
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private readonly List<Notification> _items = [];
    private string? _userId;
    private int _unread;
    private Timer? _timer;

    /// <summary>
    /// The bell sits in the layout, so it renders beside every page.
    ///
    /// It must therefore never touch the request's scoped DbContext: during
    /// prerender its work and the page's own run inside one scope, and two
    /// awaited queries on one context throw "a second operation was started on
    /// this context instance". The polling timer makes it worse again, firing on
    /// a thread pool thread against that same context. A scope per operation is
    /// what the dispatcher already does, and for the same reason.
    /// </summary>
    private async Task<T> WithNotifierAsync<T>(Func<INotifier, Task<T>> work)
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await work(scope.ServiceProvider.GetRequiredService<INotifier>());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Nothing is loaded during prerender: the badge would be thrown away and
        // redrawn a moment later over the circuit anyway, and querying there is
        // what put this component in the page's scope in the first place.
        await RefreshAsync();
        StateHasChanged();

        _timer = new Timer(
            async void (_) =>
            {
                try
                {
                    await RefreshAsync();
                    await InvokeAsync(StateHasChanged);
                }
                catch (ObjectDisposedException)
                {
                    // The circuit went away between the tick and the render.
                    // Ordinary on a closed tab, and not worth logging.
                }
            },
            null, PollInterval, PollInterval);
    }

    private async Task RefreshAsync()
    {
        _userId ??= AuthState is null
            ? null
            : (await AuthState).User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (_userId is not { } userId) return;

        var snapshot = await WithNotifierAsync(async notifier => (
            Count: await notifier.UnreadCountAsync(userId),
            Items: await notifier.UnreadAsync(userId, 10)));

        _unread = snapshot.Count;

        _items.Clear();
        _items.AddRange(snapshot.Items);
    }

    private async Task OpenAsync(Notification item)
    {
        await WithNotifierAsync(async notifier =>
        {
            await notifier.MarkReadAsync(item.Id);
            return true;
        });

        await RefreshAsync();

        if (!string.IsNullOrWhiteSpace(item.Url))
            Nav.NavigateTo(item.Url);
    }

    private async Task MarkAllReadAsync()
    {
        if (_userId is not { } userId) return;

        await WithNotifierAsync(async notifier =>
        {
            await notifier.MarkAllReadAsync(userId);
            return true;
        });

        await RefreshAsync();
    }

    /// <summary>First line only - the body carries the detail for email.</summary>
    private static string Summarise(string body)
    {
        var firstLine = body.Split('\n', 2)[0];
        return firstLine.Length <= 90 ? firstLine : firstLine[..90] + "…";
    }

    public void Dispose() => _timer?.Dispose();
}
