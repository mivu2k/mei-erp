@inherits LayoutComponentBase
@inject IModuleCatalog Catalog
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider Theme="Theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout Class="app-shell">
            <MudBreakpointProvider OnBreakpointChanged="BreakpointChanged" />
            <MudAppBar Elevation="0" Class="app-header border-b">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               Edge="Edge.Start" OnClick="ToggleNavigation"
                               Class="app-header-menu" aria-label="Toggle navigation" />
                <a href="/" class="app-brand" aria-label="MEI ERP home">
                    <span class="app-brand-mark">M</span>
                    <span class="app-brand-copy">
                        <span>MEI</span>
                        <small>Enterprise</small>
                    </span>
                </a>

                <div class="app-header-search"><GlobalSearch /></div>

                <MudSpacer />

                @if (!_isMobile)
                {
                <div class="app-header-tools">
                <div class="app-desktop-header-action"><MudTooltip Text="Print, save PDF, or export this page"><PageOutputTools /></MudTooltip></div>

                @* One inbox across every module. A manager checks one queue, not eight. *@
                <div class="app-desktop-header-action"><MudTooltip Text="Approvals waiting for you">
                    <MudIconButton Icon="@Icons.Material.Outlined.FactCheck"
                                   Color="Color.Inherit" Href="/approvals" />
                </MudTooltip></div>

                @* Module-declared shortcuts - the attendance QR code being the
                   one that forced this. A module contributes them through its
                   descriptor, so this file never learns about HR. *@
                @if (Catalog.All.SelectMany(m => m.QuickActions).Any())
                {
                    <div class="app-desktop-header-action"><MudTooltip Text="Quick actions">
                        <MudMenu Icon="@Icons.Material.Outlined.Bolt" Color="Color.Inherit"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            @foreach (var action in Catalog.All.SelectMany(m => m.QuickActions))
                            {
                                @if (action.Permission is null)
                                {
                                    <MudMenuItem Href="@action.Path" Icon="@ResolveIcon(action.Icon)">@action.Tooltip</MudMenuItem>
                                }
                                else
                                {
                                    <AuthorizeView Policy="@action.Permission" Context="quick">
                                        <Authorized><MudMenuItem Href="@action.Path" Icon="@ResolveIcon(action.Icon)">@action.Tooltip</MudMenuItem></Authorized>
                                    </AuthorizeView>
                                }
                            }
                        </MudMenu>
                    </MudTooltip></div>
                }

                @* The bell the approval engine finally has. Without it, someone
                   raises a request and their manager never finds out unless they
                   happen to open the inbox. *@
                <NotificationBell />

                <div class="app-desktop-header-action"><MudTooltip Text="@(_dark ? "Light mode" : "Dark mode")">
                    <MudIconButton Color="Color.Inherit"
                                   Icon="@(_dark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                                   OnClick="@(() => _dark = !_dark)" />
                </MudTooltip></div>

                <div class="app-header-profile"><MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudText Typo="Typo.body2" Class="px-4 py-2">
                        <b>@context.User.FindFirst("full_name")?.Value</b>
                    </MudText>
                    <MudDivider />
                    <MudMenuItem Href="/profile">My profile</MudMenuItem>
                    <MudMenuItem Href="/profile?tab=security">Security</MudMenuItem>
                    <MudMenuItem Href="/profile?tab=notifications">Notifications</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Href="/sign-out-now">Sign out</MudMenuItem>
                </MudMenu></div>
                </div>
                }
                else
                {
                    <div class="app-mobile-header-tool"><NotificationBell /></div>
                }
            </MudAppBar>

            <MudDrawer @bind-Open="_navOpen" Elevation="0" ClipMode="DrawerClipMode.Always"
                       Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
                       Width="272px" Class="app-navigation border-r">
                <NavMenu />
                <div class="app-mobile-drawer-settings">
                    <MudButton FullWidth="true" Variant="Variant.Text"
                               StartIcon="@(_dark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               OnClick="@(() => _dark = !_dark)">
                        @(_dark ? "Use light mode" : "Use dark mode")
                    </MudButton>
                </div>
            </MudDrawer>

            <MudMainContent Class="app-content pt-16">
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="app-page">
                    @Body
                </MudContainer>
            </MudMainContent>

            <nav class="app-mobile-nav" aria-label="Primary mobile navigation">
                <a href="/" class="@MobileNavClass("/")"><MudIcon Icon="@Icons.Material.Outlined.Home"/><span>Home</span></a>
                <a href="/approvals" class="@MobileNavClass("/approvals")"><MudIcon Icon="@Icons.Material.Outlined.FactCheck"/><span>Approvals</span></a>
                <a href="/scan" class="app-mobile-nav-scan @MobileNavClass("/scan")"><span class="app-mobile-scan-icon"><MudIcon Icon="@Icons.Material.Outlined.QrCodeScanner"/></span><span>Scan</span></a>
                <a href="/reports" class="@MobileNavClass("/reports")"><MudIcon Icon="@Icons.Material.Outlined.Assessment"/><span>Reports</span></a>
                <button type="button" class="@(_navOpen ? "active" : null)" @onclick="ToggleNavigation"><MudIcon Icon="@Icons.Material.Outlined.Menu"/><span>Menu</span></button>
            </nav>
        </MudLayout>
    </Authorized>

    <NotAuthorized>
        @* Sign-in and the other anonymous pages draw their own full-page layout. *@
        @Body
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <a class="dismiss" role="button" aria-label="Dismiss error">&#x2715;</a>
</div>

@code {
    private bool _navOpen = true;
    private bool _dark;
    private bool _isMobile;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void ToggleNavigation() => _navOpen = !_navOpen;

    private void BreakpointChanged(Breakpoint breakpoint)
    {
        _isMobile = breakpoint is Breakpoint.Xs or Breakpoint.Sm;
        _navOpen = !_isMobile;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_isMobile) _navOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private string MobileNavClass(string path)
    {
        var current = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        if (current == "//") current = "/";
        var active = path == "/" ? current == "/" : current.Equals(path, StringComparison.OrdinalIgnoreCase) || current.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
        return active ? "active" : "";
    }

    /// <summary>
    /// A module names its icon as a string, because the catalog lives in the
    /// Kernel and the Kernel must not depend on MudBlazor. Falls back to a
    /// generic icon rather than throwing, so a typo in a descriptor costs a
    /// wrong picture, not a broken app bar.
    /// </summary>
    private static string ResolveIcon(string name)
    {
        var field = typeof(Icons.Material.Outlined).GetField(name);
        return field?.GetValue(null) as string ?? Icons.Material.Outlined.Apps;
    }

    /// <summary>
    /// A blue-grey ground rather than MudBlazor's default purple: this is a
    /// system people stare at for eight hours, so the chrome stays quiet and
    /// colour is reserved for meaning - overdue, approved, rejected.
    /// </summary>
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1D4E7C",
            Secondary = "#A85D2E",
            Success = "#2E6F52",
            Warning = "#B4731A",
            Error = "#9B3327",
            Background = "#F4F6F8",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#16202B",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#16202B",
            TextSecondary = "#5B6975",
            LinesDefault = "#DDE3E9"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#7FB0DE",
            Secondary = "#D79765",
            Success = "#71B893",
            Warning = "#D9A441",
            Error = "#DE8478",
            Background = "#10161D",
            Surface = "#18212B",
            AppbarBackground = "#18212B",
            DrawerBackground = "#18212B",
            TextPrimary = "#E8EDF3",
            TextSecondary = "#94A2AF",
            LinesDefault = "#2B3743"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "system-ui", "sans-serif"] }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" }
    };
}
