@inject IModuleCatalog Catalog
@inject NavigationManager Nav
@implements IDisposable

@*
    One nav for the whole suite.

    Every business module contributes its own section from the module catalog,
    so adding a module — or a page inside one — never means editing this file.
    Each entry is gated on its own permission, so a person only ever sees what
    they can actually open.
*@

<div class="nav-heading">
    <MudText Typo="Typo.caption">Workspace</MudText>
    <MudText Typo="Typo.body2">Operations suite</MudText>
</div>

<MudNavMenu Class="app-nav-menu">

    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">
        Dashboard
    </MudNavLink>

    <MudNavLink Href="/approvals" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Outlined.FactCheck">
        My approvals
    </MudNavLink>

    @* One scan screen for the whole suite, rather than one buried in each
       module. Whoever holds the scanner does not know which module owns the
       sticker. *@
    <MudNavLink Href="/scan" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Outlined.QrCodeScanner">
        Scan
    </MudNavLink>

    <MudNavLink Href="/reports" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Outlined.Assessment">
        Reports
    </MudNavLink>

    @* Personal settings are one entry, not three amongst the company's modules. *@
    <MudNavLink Href="/profile" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Outlined.AccountCircle">
        My profile
    </MudNavLink>

    @if (Catalog.All.Count > 0)
    {
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.overline" Class="px-4 mud-text-secondary">Modules</MudText>

        @foreach (var module in Catalog.All)
        {
            <AuthorizeView Policy="@($"module:{module.Key}")" Context="moduleAccess">
                <Authorized>
                    @if (module.Nav.Count == 0)
                    {
                        @* A module with no declared nav is still reachable at
                           its base path rather than being invisible. *@
                        <MudNavLink Href="@module.BasePath" Match="NavLinkMatch.Prefix"
                                    Icon="@ResolveIcon(module.Icon)">
                            @module.Name
                        </MudNavLink>
                    }
                    else
                    {
                        @* Opens itself when you are inside it, so the page you
                           are on is always visible in the nav. *@
                        <MudNavGroup Title="@module.Name" Icon="@ResolveIcon(module.Icon)"
                                     Expanded="@IsInside(module.BasePath)">
                            @foreach (var group in module.Nav.GroupBy(n => n.Group))
                            {
                                @if (group.Key is not null)
                                {
                                    <MudText Typo="Typo.overline"
                                             Class="px-6 pt-2 mud-text-secondary d-block">
                                        @group.Key
                                    </MudText>
                                }

                                @foreach (var item in group)
                                {
                                    @if (item.Permission is null)
                                    {
                                        <MudNavLink Href="@item.Path" Match="NavLinkMatch.Prefix"
                                                    Icon="@ResolveIcon(item.Icon)">
                                            @item.Label
                                        </MudNavLink>
                                    }
                                    else
                                    {
                                        <AuthorizeView Policy="@item.Permission" Context="pageAccess">
                                            <Authorized>
                                                <MudNavLink Href="@item.Path" Match="NavLinkMatch.Prefix"
                                                            Icon="@ResolveIcon(item.Icon)">
                                                    @item.Label
                                                </MudNavLink>
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                }
                            }
                        </MudNavGroup>
                    }
                </Authorized>
            </AuthorizeView>
        }
    }

    <MudDivider Class="my-2" />
    <MudText Typo="Typo.overline" Class="px-4 mud-text-secondary">Administration</MudText>

    <AuthorizeView Policy="@PlatformPermissions.UsersManage" Context="admin">
        <Authorized>
            <MudNavLink Href="/admin/users" Icon="@Icons.Material.Outlined.People">Users</MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@PlatformPermissions.RolesManage" Context="admin">
        <Authorized>
            <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Outlined.AdminPanelSettings">
                Roles &amp; permissions
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@PlatformPermissions.WorkflowsManage" Context="admin">
        <Authorized>
            <MudNavLink Href="/admin/workflows" Icon="@Icons.Material.Outlined.AltRoute">
                Approval workflows
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@PlatformPermissions.CompanyManage" Context="admin">
        <Authorized>
            <MudNavLink Href="/admin/company" Icon="@Icons.Material.Outlined.Business">
                Company profile
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@PlatformPermissions.LabelsManage" Context="labelAdmin">
        <Authorized><MudNavLink Href="/admin/labels" Icon="@Icons.Material.Outlined.Label">Label templates</MudNavLink></Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@PlatformPermissions.OutboxManage" Context="outboxAdmin">
        <Authorized>
            <MudNavLink Href="/admin/failed-notifications" Icon="@Icons.Material.Outlined.MarkEmailUnread">
                Failed notifications
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@PlatformPermissions.AuditView" Context="auditAdmin">
        <Authorized><MudNavLink Href="/admin/audit" Icon="@Icons.Material.Outlined.History">Audit trail</MudNavLink></Authorized>
    </AuthorizeView>

</MudNavMenu>

@code {
    protected override void OnInitialized() =>
        Nav.LocationChanged += OnLocationChanged;

    public void Dispose() =>
        Nav.LocationChanged -= OnLocationChanged;

    /// <summary>
    /// Re-renders on navigation so the group covering the current page opens
    /// itself — otherwise following a link from elsewhere leaves the nav
    /// collapsed and the page you are on invisible in it.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private bool IsInside(string basePath)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var query = path.IndexOf('?');
        if (query >= 0) path = path[..query];

        return path.Equals(basePath, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(basePath + "/", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// A module names its icon as a string, because the catalog lives in the
    /// Kernel and the Kernel must not depend on MudBlazor. Falls back to a
    /// generic icon rather than throwing, so a typo in a descriptor costs a
    /// wrong picture, not a broken nav.
    /// </summary>
    private static string ResolveIcon(string name)
    {
        var field = typeof(Icons.Material.Outlined).GetField(name);
        return field?.GetValue(null) as string ?? Icons.Material.Outlined.Apps;
    }
}
