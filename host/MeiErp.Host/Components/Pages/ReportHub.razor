@page "/reports"
@page "/reports/designer"
@page "/reports/{ReportKey}"
@attribute [Authorize]
@rendermode InteractiveServer
@using MeiErp.Platform.Reporting
@using MeiErp.Platform.Printing
@inject IReportCatalog Catalog
@inject ICurrentUser User
@inject IClock Clock
@inject IReportPreferenceService Preferences
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Custom report builder</PageTitle>

<div class="d-flex flex-wrap align-center gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h5">Custom report builder</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Build your own reporting scenario from any module dataset you are permitted to use.
        </MudText>
    </div>
    <MudSpacer />
    <MudChip T="string" Icon="@Icons.Material.Outlined.Dataset" Color="Color.Primary" Variant="Variant.Outlined">
        @AvailableReports.Count datasets
    </MudChip>
</div>

<MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">
    <div class="d-flex align-center gap-2 mb-3">
        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">1</MudAvatar>
        <div>
            <MudText Typo="Typo.subtitle1">Choose a module dataset</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">The list is discovered from installed modules and your permissions; it is not a fixed menu.</MudText>
        </div>
    </div>

    <MudGrid Spacing="2">
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_search" Placeholder="Search datasets"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="7">
            <div class="d-flex flex-wrap gap-2">
                <MudButton Size="Size.Small" Variant="@(_module is null ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary" OnClick="@(() => _module = null)">All modules</MudButton>
                @foreach (var module in AvailableModules)
                {
                    <MudButton Size="Size.Small" Variant="@(_module == module ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => _module = module)">@ModuleName(module)</MudButton>
                }
            </div>
        </MudItem>
    </MudGrid>

    @if (Visible.Count == 0)
    {
        <MudText Class="pa-6 text-center mud-text-secondary" Typo="Typo.body2">No permitted datasets match this search.</MudText>
    }
    else
    {
        <MudGrid Spacing="2" Class="mt-1">
            @foreach (var report in Visible)
            {
                <MudItem xs="12" sm="6" lg="4" xl="3">
                    <MudPaper Outlined="true" Elevation="0" Class="pa-3 h-100"
                              Style="@(report.Key == _current?.Key ? "border-color:var(--mud-palette-primary);border-width:2px" : "")">
                        <div class="d-flex align-center mb-2">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@ModuleName(report.ModuleKey)</MudChip>
                            <MudSpacer />
                            <MudIcon Icon="@Icons.Material.Outlined.Dataset" Color="Color.Primary" Size="Size.Small" />
                        </div>
                        <MudText Typo="Typo.subtitle2">@report.Name</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" Style="min-height:40px">@report.Description</MudText>
                        <MudButton FullWidth="true" Size="Size.Small" Class="mt-3"
                                   Variant="@(report.Key == _current?.Key ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary" OnClick="@(() => Select(report))">
                            @(report.Key == _current?.Key ? "Selected" : "Use this dataset")
                        </MudButton>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@if (_current is null)
{
    <MudPaper Outlined="true" Elevation="0" Class="pa-8 text-center">
        <MudIcon Icon="@Icons.Material.Outlined.TouchApp" Size="Size.Large" Class="mud-text-secondary" />
        <MudText Class="mud-text-secondary mt-3">Choose a dataset above to start building your scenario.</MudText>
    </MudPaper>
}
else
{
            <MudPaper Outlined="true" Elevation="0">
                <div class="pa-4">
                    <div class="d-flex align-center">
                        <div>
                            <div class="d-flex align-center gap-2">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">2</MudAvatar>
                                <MudText Typo="Typo.h6">Design scenario · @_current.Name</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @_current.Description
                            </MudText>
                        </div>
                        <MudSpacer />
                        @if (_result is not null && _result.Rows.Count > 0)
                        {
                            <MudButton StartIcon="@Icons.Material.Outlined.TableChart" Size="Size.Small"
                                       Href="@ExportUrl("xlsx")" Target="_blank">Excel</MudButton>
                            <MudButton StartIcon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small"
                                       Href="@ExportUrl("pdf")" Target="_blank">PDF</MudButton>
                        }
                    </div>

                    @* Only the filters this report actually uses. Showing one it
                       ignores makes the reader distrust the whole panel. *@
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        @if (_current.Uses.HasFlag(ReportFilters.DateRange))
                        {
                            <MudDatePicker Label="From" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Date="_from" DateChanged="@(d => _from = d)" Style="max-width:170px" />
                            <MudDatePicker Label="To" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Date="_to" DateChanged="@(d => _to = d)" Style="max-width:170px" />
                        }

                        @if (_current.Uses.HasFlag(ReportFilters.AsAtDate))
                        {
                            <MudDatePicker Label="As at" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Date="_asAt" DateChanged="@(d => _asAt = d)" Style="max-width:170px" />
                        }

                        @if (_current.Uses.HasFlag(ReportFilters.Status))
                        {
                            <MudTextField @bind-Value="_status" Label="Status" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Style="max-width:160px" />
                        }

                        @if (_current.Uses.HasFlag(ReportFilters.Party))
                        {
                            <MudNumericField T="int?" @bind-Value="_partyId" Label="Party ID" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px" />
                        }
                        @if (_current.Uses.HasFlag(ReportFilters.Person))
                        {
                            <MudTextField @bind-Value="_personId" Label="Person" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Style="max-width:170px" />
                        }
                        @if (_current.Uses.HasFlag(ReportFilters.Department))
                        {
                            <MudTextField @bind-Value="_departmentId" Label="Department" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Style="max-width:170px" />
                        }
                        @if (_current.Uses.HasFlag(ReportFilters.Project))
                        {
                            <MudNumericField T="int?" @bind-Value="_projectId" Label="Project ID" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px" />
                        }
                        @if (_current.Uses.HasFlag(ReportFilters.Account))
                        {
                            <MudNumericField T="int?" @bind-Value="_accountId" Label="Account ID" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px" />
                        }
                        @if (_current.Uses.HasFlag(ReportFilters.Item))
                        {
                            <MudNumericField T="int?" @bind-Value="_itemId" Label="Item ID" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px" />
                        }

                        <MudTextField @bind-Value="_searchTerm" Label="Contains" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Style="max-width:200px" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="RunAsync" Disabled="_running">
                            @(_running ? "Running…" : "Run")
                        </MudButton>
                    </div>

                    <MudExpansionPanels Class="mt-3" Elevation="0">
                        @if (_availableColumns.Count > 0)
                        {
                            <MudExpansionPanel Text="Choose fields, sorting and grouping" Expanded="true">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Choose exactly what appears on screen and in Excel/PDF.</MudText>
                                <MudGrid Spacing="1" Class="mt-2">
                                    @foreach (var column in _availableColumns)
                                    {
                                        <MudItem xs="12" sm="6" md="4" lg="3">
                                            <MudPaper Outlined="true" Elevation="0" Class="px-2 py-1 h-100">
                                                <MudCheckBox T="bool" Value="@IsColumnSelected(column.Key)"
                                                             ValueChanged="@(value => SetColumnSelected(column.Key, value))"
                                                             Label="@column.Header" Dense="true" />
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                                <MudGrid Spacing="2" Class="mt-2">
                                    <MudItem xs="12" sm="6" md="4">
                                        <MudSelect T="string" @bind-Value="_sortBy" Label="Sort by" Clearable="true"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                            @foreach (var column in _availableColumns)
                                            { <MudSelectItem T="string" Value="@column.Key">@column.Header</MudSelectItem> }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="4">
                                        <MudSelect T="string" @bind-Value="_groupBy" Label="Group by" Clearable="true"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                            @foreach (var column in _availableColumns.Where(c => c.Kind is not ReportValueKind.Money))
                                            { <MudSelectItem T="string" Value="@column.Key">@column.Header</MudSelectItem> }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
                                        <MudCheckBox T="bool" @bind-Value="_sortDescending" Label="Descending order" />
                                    </MudItem>
                                </MudGrid>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.Refresh" OnClick="RunAsync" Disabled="_running">
                                    Apply layout
                                </MudButton>
                            </MudExpansionPanel>
                        }
                        <MudExpansionPanel Text="Save or schedule this scenario">
                            <div class="d-flex flex-wrap gap-2 align-center">
                                <MudTextField @bind-Value="_viewName" Label="Scenario name" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Style="max-width:220px" />
                                <MudCheckBox T="bool" @bind-Value="_viewDefault" Label="Default" />
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveViewAsync">Save my scenario</MudButton>
                                @foreach (var view in _views)
                                {
                                    <MudChip T="string" Size="Size.Small" OnClick="@(() => ApplyViewAsync(view))"
                                             OnClose="@(() => DeleteViewAsync(view))">
                                        @(view.IsDefault ? $"★ {view.Name}" : view.Name)
                                    </MudChip>
                                }
                            </div>
                            <MudDivider Class="my-3" />
                            <div class="d-flex flex-wrap gap-2 align-center">
                                <MudTextField @bind-Value="_scheduleName" Label="Schedule name" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Style="max-width:220px" />
                                <MudSelect T="ReportScheduleFrequency" @bind-Value="_frequency" Label="Frequency"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px">
                                    @foreach (var frequency in Enum.GetValues<ReportScheduleFrequency>())
                                    { <MudSelectItem Value="@frequency">@frequency</MudSelectItem> }
                                </MudSelect>
                                <MudTimePicker @bind-Time="_runAt" Label="Run at" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" Style="max-width:150px" />
                                @if (_frequency == ReportScheduleFrequency.Weekly)
                                {
                                    <MudSelect T="DayOfWeek" @bind-Value="_scheduleDay" Label="Day"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px">
                                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                                        { <MudSelectItem Value="@day">@day</MudSelectItem> }
                                    </MudSelect>
                                }
                                @if (_frequency == ReportScheduleFrequency.Monthly)
                                {
                                    <MudNumericField T="int" @bind-Value="_dayOfMonth" Label="Day of month" Min="1" Max="28"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px" />
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SaveScheduleAsync">Add schedule</MudButton>
                            </div>
                            @foreach (var schedule in _schedules)
                            {
                                <div class="d-flex align-center mt-2">
                                    <MudText Typo="Typo.body2">@schedule.Name — @schedule.Frequency, next @FormatBusinessTime(schedule.NextRunUtc)</MudText>
                                    @if (!string.IsNullOrWhiteSpace(schedule.LastError))
                                    { <MudText Typo="Typo.caption" Color="Color.Error" Class="ml-2">Last run: @schedule.LastError</MudText> }
                                    <MudSpacer />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => DeleteScheduleAsync(schedule))" />
                                </div>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </div>

                <MudDivider />

                @if (_running)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_result is null)
                {
                    <MudText Class="pa-12 text-center mud-text-secondary">
                        Choose your filters and press Run.
                    </MudText>
                }
                else if (_result.Rows.Count == 0)
                {
                    <MudText Class="pa-12 text-center mud-text-secondary">
                        @_result.EmptyMessage
                    </MudText>
                }
                else
                {
                    <div class="pa-4">
                        @if (_result.Header.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-4 mb-3">
                                @foreach (var field in _result.Header)
                                {
                                    <div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @field.Label
                                        </MudText>
                                        <MudText Typo="Typo.body2"><b>@field.Value</b></MudText>
                                    </div>
                                }
                            </div>
                        }

                        <div style="overflow-x:auto">
                            <MudSimpleTable Dense="true" Hover="true" Striped="false">
                                <thead>
                                    <tr>
                                        @foreach (var column in _result.Columns)
                                        {
                                            <th style="@(IsNumeric(column) ? "text-align:right" : "")">
                                                @column.Header
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var group in _groups)
                                    {
                                        @if (group.Key is not null)
                                        {
                                            <tr>
                                                <td colspan="@_result.Columns.Count"
                                                    style="background:var(--mud-palette-background-grey);font-weight:600">
                                                    @group.Key
                                                </td>
                                            </tr>
                                        }

                                        @foreach (var row in group.Rows)
                                        {
                                            <tr style="@(row.DrillUrl is null ? "" : "cursor:pointer")"
                                                @onclick="@(() => Drill(row))">
                                                @foreach (var column in _result.Columns)
                                                {
                                                    <td style="@(IsNumeric(column) ? "text-align:right;font-variant-numeric:tabular-nums" : "")">
                                                        @if (column.Kind is ReportValueKind.Status
                                                             && row[column.Key] is not null)
                                                        {
                                                            <MudChip T="string" Size="Size.Small"
                                                                     Variant="Variant.Outlined">
                                                                @ReportRenderer.Format(row[column.Key], column.Kind)
                                                            </MudChip>
                                                        }
                                                        else
                                                        {
                                                            @ReportRenderer.Format(row[column.Key], column.Kind)
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }

                                        @if (group.Key is not null && group.Totals.Count > 0)
                                        {
                                            <tr style="font-weight:600">
                                                @foreach (var column in _result.Columns)
                                                {
                                                    var subtotal = group.Totals.FirstOrDefault(t => t.ColumnKey == column.Key);
                                                    <td style="@(IsNumeric(column) ? "text-align:right;font-variant-numeric:tabular-nums" : "")">
                                                        @(subtotal is null
                                                            ? (column.Key == _result.Columns[0].Key ? $"{group.Key} total" : "")
                                                            : ReportRenderer.Format(subtotal.Value, column.Kind))
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>

                                @if (_result.Totals.Count > 0)
                                {
                                    <tfoot>
                                        <tr style="font-weight:600;border-top:2px solid var(--mud-palette-lines-default)">
                                            @foreach (var column in _result.Columns)
                                            {
                                                var total = _result.Totals.FirstOrDefault(t => t.ColumnKey == column.Key);
                                                <td style="@(IsNumeric(column) ? "text-align:right;font-variant-numeric:tabular-nums" : "")">
                                                    @(total is null
                                                        ? (column.Key == _result.Columns[0].Key ? "Total" : "")
                                                        : ReportRenderer.Format(total.Value, column.Kind))
                                                </td>
                                            }
                                        </tr>
                                    </tfoot>
                                }
                            </MudSimpleTable>
                        </div>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                            @_result.Rows.Count @(_result.Rows.Count == 1 ? "row" : "rows")
                        </MudText>
                    </div>
                }
            </MudPaper>
}

@code {
    [Parameter] public string? ReportKey { get; set; }

    private ReportDefinition? _current;
    private ReportResult? _result;
    private IReadOnlyList<ReportGroup> _groups = [];
    private IReadOnlyList<ReportColumn> _availableColumns = [];
    private readonly HashSet<string> _selectedColumns = new(StringComparer.OrdinalIgnoreCase);

    private string? _search;
    private string? _module;
    private string? _searchTerm;
    private string? _status;
    private string? _groupBy;
    private string? _sortBy;
    private bool _sortDescending;
    private int? _partyId, _projectId, _accountId, _itemId;
    private string? _personId, _departmentId;
    private DateTime? _from, _to, _asAt;
    private bool _running;
    private string? _viewName, _scheduleName;
    private bool _viewDefault;
    private ReportScheduleFrequency _frequency = ReportScheduleFrequency.Weekly;
    private TimeSpan? _runAt = new(8, 0, 0);
    private DayOfWeek _scheduleDay = DayOfWeek.Monday;
    private int _dayOfMonth = 1;
    private IReadOnlyList<SavedReportView> _views = [];
    private IReadOnlyList<ReportSchedule> _schedules = [];

    private IReadOnlyList<ReportDefinition> AvailableReports => Catalog.Available(User);

    private IReadOnlyList<string> AvailableModules =>
        [.. AvailableReports.Select(r => r.ModuleKey).Distinct().OrderBy(ModuleName)];

    private IReadOnlyList<ReportDefinition> Visible =>
        [.. AvailableReports
            .Where(r => _module is null || r.ModuleKey == _module)
            .Where(r => string.IsNullOrWhiteSpace(_search)
                     || r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                     || r.Description.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => ModuleName(r.ModuleKey)).ThenBy(r => r.SortOrder).ThenBy(r => r.Name)];

    private static string ModuleName(string key) =>
        key.Length == 0 ? key : char.ToUpperInvariant(key[0]) + key[1..];

    private static bool IsNumeric(ReportColumn column) =>
        column.Kind is ReportValueKind.Money or ReportValueKind.Number;

    protected override async Task OnParametersSetAsync()
    {
        var today = Clock.Today;

        // Defaults to this fiscal year, so the first run shows something useful
        // rather than an empty table that looks like a broken report.
        var startYear = today.Month >= 7 ? today.Year : today.Year - 1;
        _from ??= new DateOnly(startYear, 7, 1).ToDateTime(TimeOnly.MinValue);
        _to ??= today.ToDateTime(TimeOnly.MinValue);
        _asAt ??= today.ToDateTime(TimeOnly.MinValue);

        if (ReportKey is not null && _current?.Key != ReportKey)
        {
            var found = Catalog.Find(ReportKey);
            if (found is not null && User.Can(found.Permission))
            {
                _current = found;
                await LoadPreferencesAsync();
            }
        }
    }

    private async Task Select(ReportDefinition report)
    {
        _current = report;
        _result = null;
        _groups = [];
        _availableColumns = [];
        _selectedColumns.Clear();
        _groupBy = null;
        _sortBy = null;
        _sortDescending = false;
        await LoadPreferencesAsync();
    }

    private ReportRequest CurrentRequest() => new()
    {
        From = _current?.Uses.HasFlag(ReportFilters.DateRange) == true && _from is not null ? DateOnly.FromDateTime(_from.Value) : null,
        To = _current?.Uses.HasFlag(ReportFilters.DateRange) == true && _to is not null ? DateOnly.FromDateTime(_to.Value) : null,
        AsAt = _current?.Uses.HasFlag(ReportFilters.AsAtDate) == true && _asAt is not null ? DateOnly.FromDateTime(_asAt.Value) : null,
        Status = _status, Search = _searchTerm, GroupBy = _groupBy,
        PartyId = _partyId, PersonId = _personId, DepartmentId = _departmentId,
        ProjectId = _projectId, AccountId = _accountId, ItemId = _itemId,
        SelectedColumns = _selectedColumns.Count == 0 ? null : [.. _availableColumns.Where(c => _selectedColumns.Contains(c.Key)).Select(c => c.Key)],
        SortBy = _sortBy, SortDescending = _sortDescending
    };

    private async Task LoadPreferencesAsync()
    {
        if (_current is null) return;
        _views = await Preferences.ViewsAsync(_current.Key);
        _schedules = await Preferences.SchedulesAsync(_current.Key);
        var initial = _views.FirstOrDefault(x => x.IsDefault);
        if (initial is not null) await ApplyViewAsync(initial);
    }

    private async Task SaveViewAsync()
    {
        if (_current is null || string.IsNullOrWhiteSpace(_viewName)) { Snackbar.Add("Enter a view name.", Severity.Warning); return; }
        try
        {
            await Preferences.SaveViewAsync(null, _current.Key, _viewName, System.Text.Json.JsonSerializer.Serialize(CurrentRequest()), _viewDefault);
            _viewName = null; _viewDefault = false; await LoadPreferencesAsync(); Snackbar.Add("Scenario saved.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ApplyViewAsync(SavedReportView view)
    {
        var request = System.Text.Json.JsonSerializer.Deserialize<ReportRequest>(view.FiltersJson);
        if (request is null) return;
        _from = request.From?.ToDateTime(TimeOnly.MinValue); _to = request.To?.ToDateTime(TimeOnly.MinValue);
        _asAt = request.AsAt?.ToDateTime(TimeOnly.MinValue); _status = request.Status; _searchTerm = request.Search; _groupBy = request.GroupBy;
        _partyId = request.PartyId; _personId = request.PersonId; _departmentId = request.DepartmentId;
        _projectId = request.ProjectId; _accountId = request.AccountId; _itemId = request.ItemId;
        _sortBy = request.SortBy; _sortDescending = request.SortDescending;
        _selectedColumns.Clear();
        if (request.SelectedColumns is not null)
            foreach (var key in request.SelectedColumns) _selectedColumns.Add(key);
        await RunAsync();
    }

    private async Task DeleteViewAsync(SavedReportView view) { await Preferences.DeleteViewAsync(view.Id); await LoadPreferencesAsync(); }

    private async Task SaveScheduleAsync()
    {
        if (_current is null || string.IsNullOrWhiteSpace(_scheduleName)) { Snackbar.Add("Enter a schedule name.", Severity.Warning); return; }
        try
        {
            var at = TimeOnly.FromTimeSpan(_runAt ?? new TimeSpan(8, 0, 0));
            await Preferences.SaveScheduleAsync(null, _current.Key, _scheduleName, System.Text.Json.JsonSerializer.Serialize(CurrentRequest()), _frequency, at, _scheduleDay, _dayOfMonth, true);
            _scheduleName = null; await LoadPreferencesAsync(); Snackbar.Add("Schedule saved.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteScheduleAsync(ReportSchedule schedule) { await Preferences.DeleteScheduleAsync(schedule.Id); await LoadPreferencesAsync(); }

    private string FormatBusinessTime(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), Clock.TimeZone).ToString("g");

    private async Task RunAsync()
    {
        if (_current is null) return;

        _running = true;
        try
        {
            var request = CurrentRequest();
            if (request.From > request.To)
                throw new InvalidOperationException("The From date must be on or before the To date.");

            var raw = await _current.Run(request, CancellationToken.None);
            _availableColumns = raw.Columns;
            if (_selectedColumns.Count == 0)
                foreach (var column in raw.Columns) _selectedColumns.Add(column.Key);
            request = CurrentRequest();
            _result = ReportRenderer.Apply(raw, request);
            _groups = ReportRenderer.Group(_result, _groupBy);
        }
        catch (Exception ex)
        {
            // A report that throws should say so rather than leaving a spinner
            // running for ever.
            Snackbar.Add($"That report could not be run: {ex.Message}", Severity.Error);
            _result = null;
        }
        finally
        {
            _running = false;
        }
    }

    private void Drill(ReportRow row)
    {
        // Nothing in a report should be a dead number.
        if (row.DrillUrl is not null) Nav.NavigateTo(row.DrillUrl);
    }

    private string ExportUrl(string format)
    {
        var query = new List<string> { $"format={format}" };

        if (_from is not null) query.Add($"from={_from:yyyy-MM-dd}");
        if (_to is not null) query.Add($"to={_to:yyyy-MM-dd}");
        if (_asAt is not null) query.Add($"asAt={_asAt:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(_status)) query.Add($"status={Uri.EscapeDataString(_status)}");
        if (!string.IsNullOrWhiteSpace(_searchTerm)) query.Add($"search={Uri.EscapeDataString(_searchTerm)}");
        if (_partyId is not null) query.Add($"partyId={_partyId}");
        if (!string.IsNullOrWhiteSpace(_personId)) query.Add($"personId={Uri.EscapeDataString(_personId)}");
        if (!string.IsNullOrWhiteSpace(_departmentId)) query.Add($"departmentId={Uri.EscapeDataString(_departmentId)}");
        if (_projectId is not null) query.Add($"projectId={_projectId}");
        if (_accountId is not null) query.Add($"accountId={_accountId}");
        if (_itemId is not null) query.Add($"itemId={_itemId}");
        if (!string.IsNullOrWhiteSpace(_groupBy)) query.Add($"groupBy={Uri.EscapeDataString(_groupBy)}");
        if (!string.IsNullOrWhiteSpace(_sortBy)) query.Add($"sortBy={Uri.EscapeDataString(_sortBy)}");
        if (_sortDescending) query.Add("sortDescending=true");
        if (_selectedColumns.Count > 0)
            query.Add($"columns={Uri.EscapeDataString(string.Join(',', _availableColumns.Where(c => _selectedColumns.Contains(c.Key)).Select(c => c.Key)))}");

        return $"/reports/export/{_current!.Key}?{string.Join("&", query)}";
    }

    private bool IsColumnSelected(string key) => _selectedColumns.Contains(key);

    private void SetColumnSelected(string key, bool selected)
    {
        if (selected) _selectedColumns.Add(key);
        else if (_selectedColumns.Count > 1) _selectedColumns.Remove(key);
    }
}
