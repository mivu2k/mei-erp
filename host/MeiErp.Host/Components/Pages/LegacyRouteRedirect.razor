@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>Redirecting</PageTitle>
<MudProgressLinear Indeterminate="true" />

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? ReportKey { get; set; }

    protected override void OnInitialized()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        var target = path switch
        {
            "/inventory/transactions" => "/reports/inventory.movements",
            // Buying and selling moved out of Inventory into Sales & Purchase.
            // Bookmarks and printed paperwork still carry the old addresses.
            "/inventory/receipts" => "/purchase/goods-receipts",
            var p when p.StartsWith("/inventory/receipts/") => "/purchase/goods-receipts",
            "/inventory/goods-receipts" or "/trade/goods-receipts" => "/purchase/goods-receipts",
            "/inventory/deliveries" or "/trade/deliveries" => "/sales/deliveries",
            var p when p.StartsWith("/inventory/purchase-orders") => "/purchase/orders",
            "/trade/purchase-orders" => "/purchase/orders",
            var p when p.StartsWith("/inventory/sales-orders") => "/sales/orders",
            "/trade/sales-orders" => "/sales/orders",

            // A party record has two sides and now two lists. Supplier-flavoured
            // addresses land in Purchase, everything else in Sales.
            // Returns split by direction. The old combined screen opened on the
            // customer side, so that is where an old bookmark lands.
            "/inventory/returns" => "/sales/returns",

            // The workshop's parts buying moved into Purchase, and its supplier
            // list folded into the one party master.
            // The workshop's own customers, quotations and orders folded into
            // the one party master and the unified Sales documents.
            "/repair/customers" => "/sales/customers",
            "/repair/quotations" or "/repair/quotations/new" => "/sales/quotations",
            var p when p.StartsWith("/repair/quotations/") => "/sales/quotations",
            "/repair/orders" => "/sales/invoices",
            var p when p.StartsWith("/repair/orders/") => "/sales/invoices",

            "/repair/parts" => "/purchase/parts",
            "/repair/purchases" => "/purchase/part-purchases",
            "/repair/purchases/new" => "/purchase/part-purchases/new",
            "/repair/suppliers" => "/purchase/suppliers",

            "/inventory/suppliers" => "/purchase/suppliers",
            "/inventory/customers" or "/inventory/parties" or "/trade/parties" => "/sales/customers",
            "/inventory/reports" => "/reports",
            "/finance/reconciliation" => "/finance/reconcile",
            "/hr/attendance/monthly" => "/hr/attendance",
            "/hr/my-code" => "/hr/attendance/code",
            "/hr/stations" or "/hr/setup" => "/hr/attendance/setup",
            "/auto/reports" => "/reports/auto.maintenance-cost",
            "/repair/reports" or "/tender/reports" => "/reports",
            var p when p.StartsWith("/repair/purchases/") => "/repair/purchases",
            "/tender/projects" => "/tender/projects",
            var p when p.StartsWith("/tender/projects/") => "/tender/projects",
            "/finance/admin/audit" => "/admin/audit",
            "/finance/admin/settings" => "/admin/company",
            "/finance/advances/my" => "/finance/advances",
            "/finance/approvals" => "/approvals",
            "/finance/director-funds" => "/finance/advances?director=true",
            "/finance/ledger" => "/finance/reports",
            // The per-module scan screens folded into one. Printed stickers and
            // bookmarks still carry the old addresses.
            "/repair/scan" or "/tender/files/scan" => "/scan",
            // Personal settings folded into one profile screen.
            "/finance/notifications" or "/notifications/preferences" => "/profile?tab=notifications",
            "/account/security" => "/profile?tab=security",
            "/finance/payroll/components" or "/finance/payroll/structures" => "/finance/payroll/setup",
            "/finance/requests/my" => "/finance/requests",
            var p when p.StartsWith("/finance/requests/") => "/finance/requests",
            var p when p.StartsWith("/inventory/counts/") => "/inventory/counts",
            var p when p.StartsWith("/inventory/deliveries/") => "/inventory/deliveries",
            "/inventory/products/new" => "/inventory/products",
            var p when p.StartsWith("/inventory/products/") => "/inventory/products",
            var p when p.StartsWith("/inventory/purchase-orders/") => "/inventory/purchase-orders",
            var p when p.StartsWith("/inventory/reports/") => "/reports",
            var p when p.StartsWith("/inventory/sales-orders/") => "/inventory/sales-orders",
            var p when p.StartsWith("/inventory/transfers/") => "/inventory/transfers",
            _ => "/"
        };
        Nav.NavigateTo(target, replace: true);
    }
}
