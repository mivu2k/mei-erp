@page "/change-password"
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> Users
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Change password</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8" Outlined="true" Elevation="0">

        <MudText Typo="Typo.h5">Change your password</MudText>

        @if (_mustChange)
        {
            @* A seeded or admin-reset account arrives here before it can go
               anywhere else. A known default left in place is how an install
               stays wide open for months. *@
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
                Your password was set for you. Choose your own before continuing.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                Pick something you do not use anywhere else.
            </MudText>
        }

        <MudForm @ref="_form" Class="mt-6">
            <MudTextField @bind-Value="_current" Label="Current password"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Required="true" RequiredError="Enter your current password."
                          Class="mb-4" />

            <MudTextField @bind-Value="_next" Label="New password"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Required="true" Validation="@(new Func<string, string?>(ValidateNew))"
                          HelperText="At least 10 characters, with a capital and a digit."
                          Class="mb-4" />

            <MudTextField @bind-Value="_confirm" Label="Confirm new password"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Required="true" Validation="@(new Func<string, string?>(ValidateConfirm))" />
        </MudForm>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
                @_error
            </MudAlert>
        }

        <div class="d-flex gap-2 mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="SaveAsync" Disabled="_busy">
                @(_busy ? "Saving…" : "Change password")
            </MudButton>

            @if (!_mustChange)
            {
                <MudButton Variant="Variant.Text" Href="/">Cancel</MudButton>
            }
        </div>

    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _current = "";
    private string _next = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;
    private bool _mustChange;
    private ApplicationUser? _user;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _user = await Users.GetUserAsync(state.User);
        _mustChange = _user?.MustChangePassword ?? false;
    }

    private static string? ValidateNew(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Enter a new password.";
        if (value.Length < 10) return "At least 10 characters.";
        if (!value.Any(char.IsUpper)) return "Include a capital letter.";
        if (!value.Any(char.IsDigit)) return "Include a digit.";
        return null;
    }

    private string? ValidateConfirm(string value) =>
        value == _next ? null : "The two passwords do not match.";

    private async Task SaveAsync()
    {
        _error = null;

        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        if (_user is null)
        {
            _error = "Your session has expired. Sign in again.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Users.ChangePasswordAsync(_user, _current, _next);

            if (!result.Succeeded)
            {
                _error = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }

            if (_user.MustChangePassword)
            {
                _user.MustChangePassword = false;
                await Users.UpdateAsync(_user);
            }

            // Changing a password rotates the security stamp, which invalidates
            // every other session for this account - the right answer when the
            // reason for changing it is that someone else knew the old one.
            await Users.UpdateSecurityStampAsync(_user);

            Snackbar.Add("Password changed. Please sign in again.", Severity.Success);
            Nav.NavigateTo("/sign-out-now", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }
}
