@page "/forgot-password"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Account help</PageTitle>
<div class="signin-page"><div class="signin-card">
    <div class="signin-brand"><div class="signin-mark">MEI</div><h1>Account help</h1></div>
    @if (Sent is not null || ConfirmationSent is not null)
    { <div class="signin-error" role="status">If that active account exists, an email has been sent. Check spam as well.</div> }
    <form method="post" action="/auth/forgot-password" class="signin-form">
        <label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required autofocus />
        <button type="submit">Send password reset</button>
    </form>
    <form method="post" action="/auth/send-confirmation" class="signin-form mt-4">
        <label for="confirmEmail">Need a confirmation link?</label><input id="confirmEmail" name="email" type="email" autocomplete="email" required />
        <button type="submit">Send confirmation</button>
    </form>
    <p class="mt-4"><a href="/sign-in">Back to sign in</a></p>
</div></div>
@code {
    [SupplyParameterFromQuery] private string? Sent { get; set; }
    [SupplyParameterFromQuery] private string? ConfirmationSent { get; set; }
}
