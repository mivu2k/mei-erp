@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer

@*
    One place for everything that belongs to the person signed in.

    Their details, how they get into the account, and what the system is
    allowed to tell them were three separate entries in the main navigation,
    which put personal settings in amongst the company's modules. They are one
    screen now, and the navigation carries one link instead of three.

    ?tab= keeps the old addresses working and lets a link point at the part it
    means.
*@

<PageTitle>My profile</PageTitle>

<div class="app-page-header d-flex flex-wrap align-center gap-3 mb-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h5">My profile</MudText>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Your details, how you sign in, and what the system tells you about.
        </MudText>
    </div>
</div>

<MudPaper Outlined="true" Elevation="0" Class="app-detail-surface">
    <MudTabs Elevation="0" ActivePanelIndex="_tab" ActivePanelIndexChanged="ChooseTabAsync"
             Rounded="false" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <MudTabPanel Text="Details" Icon="@Icons.Material.Outlined.Badge">
            <DetailsPanel />
        </MudTabPanel>

        <MudTabPanel Text="Security" Icon="@Icons.Material.Outlined.Security">
            <SecurityPanel />
        </MudTabPanel>

        <MudTabPanel Text="Notifications" Icon="@Icons.Material.Outlined.Notifications">
            <NotificationsPanel />
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    /// <summary>Which part a link meant: details, security or notifications.</summary>
    [SupplyParameterFromQuery(Name = "tab")] private string? Tab { get; set; }

    private int _tab;

    private static readonly string[] Names = ["details", "security", "notifications"];

    protected override void OnParametersSet()
    {
        var wanted = Array.IndexOf(Names, (Tab ?? "").ToLowerInvariant());
        if (wanted >= 0) _tab = wanted;
    }

    /// <summary>
    /// Keep the address in step with the tab, so a reload or a shared link
    /// lands where the person actually was.
    /// </summary>
    private Task ChooseTabAsync(int index)
    {
        _tab = index;
        return Task.CompletedTask;
    }
}
