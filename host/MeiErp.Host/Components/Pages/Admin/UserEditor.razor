@inject IAdminService Admin
@inject IUserDirectory Directory
@inject ISnackbar Snackbar
@inject UserManager<ApplicationUser> Users
@inject IAccountEmailSender AccountEmail
@using MeiErp.Host.Services

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_fullName" Label="Full name" Required="true"
                          RequiredError="Enter their name." Variant="Variant.Outlined"
                          Class="mb-4" />

            <MudTextField @bind-Value="_email" Label="Email" Required="true"
                          InputType="InputType.Email" Variant="Variant.Outlined"
                          RequiredError="Enter an email - it is also their username."
                          Class="mb-4" />

            <div class="d-flex gap-3 mb-4">
                <MudTextField @bind-Value="_employeeCode" Label="Staff number"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_designation" Label="Designation"
                              Variant="Variant.Outlined" />
            </div>

            <MudSelect T="string" @bind-Value="_departmentId" Label="Department"
                       Variant="Variant.Outlined" Clearable="true" Class="mb-4">
                @foreach (var d in _departments)
                {
                    <MudSelectItem T="string" Value="@d.Id">@d.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" @bind-Value="_lineManagerId" Label="Reports to"
                       Variant="Variant.Outlined" Clearable="true"
                       HelperText="Approvals routed to a line manager go to this person.">
                @foreach (var u in _people.Where(p => p.Id != UserId))
                {
                    <MudSelectItem T="string" Value="@u.Id">@u.FullName</MudSelectItem>
                }
            </MudSelect>

            @if (IsNew)
            {
                <MudDivider Class="my-5" />

                <MudTextField @bind-Value="_password" Label="Temporary password"
                              InputType="InputType.Password" Required="true"
                              Validation="@(new Func<string, string?>(ValidatePassword))" Variant="Variant.Outlined"
                              HelperText="They must change it the first time they sign in." />
            }
        </MudForm>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
                @_error
            </MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">
            @(_busy ? "Saving…" : IsNew ? "Create user" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string? UserId { get; set; }

    private MudForm? _form;
    private string _fullName = "";
    private string _email = "";
    private string _originalEmail = "";
    private string? _employeeCode;
    private string? _designation;
    private string? _departmentId;
    private string? _lineManagerId;
    private string _password = "";
    private string? _error;
    private bool _busy;

    private IReadOnlyList<Department> _departments = [];
    private IReadOnlyList<UserSummary> _people = [];

    private bool IsNew => UserId is null;

    protected override async Task OnInitializedAsync()
    {
        _departments = await Admin.DepartmentsAsync();
        _people = await Directory.SearchAsync(null, take: 500);

        if (UserId is null) return;

        var detail = await Admin.UserAsync(UserId);
        if (detail is null) return;

        _fullName = detail.FullName;
        _email = detail.Email ?? "";
        _originalEmail = _email;
        _employeeCode = detail.EmployeeCode;
        _designation = detail.Designation;
        _departmentId = detail.DepartmentId;
        _lineManagerId = detail.LineManagerId;
    }

    private static string? ValidatePassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Set a temporary password.";
        if (value.Length < 10) return "At least 10 characters.";
        if (!value.Any(char.IsUpper)) return "Include a capital letter.";
        if (!value.Any(char.IsDigit)) return "Include a digit.";
        return null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var input = new UserInput(
                _fullName.Trim(), _email.Trim(), _employeeCode, _designation,
                _departmentId, _lineManagerId);

            Result result;
            string? createdId = null;
            if (IsNew)
            {
                var created = await Admin.CreateUserAsync(input, _password);
                result = created.AsResult();
                if (created.Ok) createdId = created.Value;
            }
            else result = await Admin.UpdateUserAsync(UserId!, input);

            if (result.Failed)
            {
                _error = result.Error;
                return;
            }

            var confirmationUserId = createdId ?? (!string.Equals(_originalEmail, _email, StringComparison.OrdinalIgnoreCase) ? UserId : null);
            if (confirmationUserId is not null)
            {
                var user = await Users.FindByIdAsync(confirmationUserId);
                var token = await Users.GenerateEmailConfirmationTokenAsync(user!);
                var encoded = Microsoft.AspNetCore.WebUtilities.WebEncoders.Base64UrlEncode(System.Text.Encoding.UTF8.GetBytes(token));
                var url = $"/auth/confirm-email?userId={Uri.EscapeDataString(confirmationUserId)}&token={Uri.EscapeDataString(encoded)}";
                var delivery = await AccountEmail.SendAsync(_email, "Confirm your MEI ERP email",
                    $"Your MEI ERP account has been created. Confirm the address, then sign in with the temporary password supplied by your administrator.", url);
                Snackbar.Add(delivery.Ok ? $"{_fullName}'s confirmation email was sent."
                    : $"User created, but confirmation email could not be sent: {delivery.Error}",
                    delivery.Ok ? Severity.Success : Severity.Warning);
            }
            else Snackbar.Add("Saved.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
