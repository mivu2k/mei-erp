@inject IAdminService Admin
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            Set a temporary password for <b>@UserName</b>. They will have to change it
            the next time they sign in, since you will know this one.
        </MudText>

        <MudForm @ref="_form">
            <MudTextField @bind-Value="_password" Label="Temporary password"
                          InputType="InputType.Password" Required="true"
                          Validation="@(new Func<string, string?>(Validate))" Variant="Variant.Outlined" />
        </MudForm>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Reset password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public string UserName { get; set; } = "";

    private MudForm? _form;
    private string _password = "";
    private string? _error;
    private bool _busy;

    private static string? Validate(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Set a password.";
        if (value.Length < 10) return "At least 10 characters.";
        if (!value.Any(char.IsUpper)) return "Include a capital letter.";
        if (!value.Any(char.IsDigit)) return "Include a digit.";
        return null;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var result = await Admin.ResetPasswordAsync(UserId, _password);
            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add($"Password reset. Give it to {UserName} directly.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }
}
