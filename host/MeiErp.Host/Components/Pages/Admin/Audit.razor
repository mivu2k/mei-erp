@page "/admin/audit"
@attribute [Authorize(Policy=PlatformPermissions.AuditView)]
@rendermode InteractiveServer
@using MeiErp.Platform.Persistence
@using Microsoft.EntityFrameworkCore
@inject PlatformDbContext Db
<PageTitle>Audit trail</PageTitle>
<MudText Typo="Typo.h5">Audit trail</MudText><MudText Typo="Typo.body2" Class="mud-text-secondary">Append-only evidence written in the same transaction as each module change.</MudText>
<MudPaper Class="pa-4 my-4" Outlined><div class="d-flex gap-3 flex-wrap"><MudTextField @bind-Value="_entity" Label="Entity or record id" Immediate/><MudTextField @bind-Value="_user" Label="User" Immediate/><MudSelect T="string" @bind-Value="_module" Label="Module" Clearable><MudSelectItem Value="@string.Empty">All modules</MudSelectItem>@foreach(var m in _modules){<MudSelectItem Value="@m">@m</MudSelectItem>}</MudSelect><MudDatePicker @bind-Date="_from" Label="From"/><MudDatePicker @bind-Date="_to" Label="To"/><MudButton Variant="Variant.Filled" OnClick="Filter">Filter</MudButton></div></MudPaper>
<MudTable @ref="_table" T="AuditLogEntry" ServerData="Load" Dense Hover Striped><HeaderContent><MudTh>Time</MudTh><MudTh>Actor</MudTh><MudTh>Module</MudTh><MudTh>Action</MudTh><MudTh>Record</MudTh><MudTh>Changes</MudTh></HeaderContent><RowTemplate><MudTd>@context.TimestampUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</MudTd><MudTd>@(context.UserName??context.UserId??"system")</MudTd><MudTd>@context.ModuleKey</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Action.Contains("Delete")?Color.Error:context.Action=="Created"?Color.Success:Color.Info)">@context.Action</MudChip></MudTd><MudTd>@context.EntityName #@context.EntityId</MudTd><MudTd Style="max-width:520px"><MudExpansionPanels Elevation="0"><MudExpansionPanel Text="View values"><MudText Typo="Typo.caption" Style="word-break:break-word"><b>Before:</b> @Pretty(context.OldValues)</MudText><MudDivider Class="my-2"/><MudText Typo="Typo.caption" Style="word-break:break-word"><b>After:</b> @Pretty(context.NewValues)</MudText></MudExpansionPanel></MudExpansionPanels></MudTd></RowTemplate><PagerContent><MudTablePager PageSizeOptions="@(new[]{25,50,100})"/></PagerContent></MudTable>
@code{MudTable<AuditLogEntry>? _table;string? _entity,_user,_module;DateTime? _from,_to;string[] _modules=[];protected override async Task OnInitializedAsync()=>_modules=await Db.AuditLogs.AsNoTracking().Select(x=>x.ModuleKey).Distinct().OrderBy(x=>x).ToArrayAsync();Task Filter()=>_table is null?Task.CompletedTask:_table.ReloadServerData();async Task<TableData<AuditLogEntry>> Load(TableState state,CancellationToken ct){var q=Db.AuditLogs.AsNoTracking();if(!string.IsNullOrWhiteSpace(_module))q=q.Where(x=>x.ModuleKey==_module);if(!string.IsNullOrWhiteSpace(_entity)){var s=_entity.Trim();q=q.Where(x=>x.EntityName.Contains(s)||x.EntityId.Contains(s));}if(!string.IsNullOrWhiteSpace(_user)){var s=_user.Trim();q=q.Where(x=>(x.UserName!=null&&x.UserName.Contains(s))||(x.UserId!=null&&x.UserId.Contains(s)));}if(_from is not null)q=q.Where(x=>x.TimestampUtc>=_from.Value.Date.ToUniversalTime());if(_to is not null)q=q.Where(x=>x.TimestampUtc<_to.Value.Date.AddDays(1).ToUniversalTime());var total=await q.CountAsync(ct);var size=state.PageSize<=0?25:state.PageSize;var rows=await q.OrderByDescending(x=>x.Id).Skip(state.Page*size).Take(size).ToListAsync(ct);return new(){TotalItems=total,Items=rows};}static string Pretty(string? json)=>string.IsNullOrWhiteSpace(json)?"—":json.Length>1500?json[..1500]+"…":json;}
