@page "/admin/workflows"
@attribute [Authorize(Policy = PlatformPermissions.WorkflowsManage)]
@rendermode InteractiveServer
@inject IWorkflowAdminService Designer
@inject IModuleCatalog Catalog
@inject ISnackbar Snackbar

<PageTitle>Approval workflows</PageTitle>

<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h5">Approval workflows</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => _creating = true)">New workflow</MudButton>
</div>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Assign approval authority to module roles for each document type and amount level. A named line manager is not required. Changing a workflow never disturbs
    requests already in flight - they keep running the revision they started on.
</MudText>

@if (_creating)
{
    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1">Create a custom workflow</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Choose the form or transaction this workflow controls. Saving it as active replaces the current active route; requests already submitted keep their original route.
        </MudText>
        <div class="d-flex align-end flex-wrap gap-2 mt-3">
            <MudSelect T="string" @bind-Value="_newDocumentType" Label="Module and document"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:320px">
                @foreach (var module in Catalog.AllApprovables.GroupBy(x => x.Key.Split('.')[0]))
                {
                    <MudListSubheader>@(Catalog.Find(module.Key)?.Name ?? module.Key)</MudListSubheader>
                    @foreach (var document in module)
                    {
                        <MudSelectItem T="string" Value="@document.Key">@document.Name</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_newDocumentType)"
                       OnClick="StartNewAsync">Build workflow</MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelNew">Cancel</MudButton>
        </div>
    </MudPaper>
}

@if (_list.Count == 0)
{
    <MudPaper Outlined="true" Elevation="0" Class="pa-12 text-center">
        <MudIcon Icon="@Icons.Material.Outlined.AltRoute" Size="Size.Large" Class="mud-text-secondary" />
        <MudText Typo="Typo.h6" Class="mt-3">No workflows yet</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
            A workflow is created automatically for each document type a module declares.
            Install a business module and they will appear here.
        </MudText>
    </MudPaper>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Outlined="true" Elevation="0">
                <MudList T="string">
                    @foreach (var module in _list.GroupBy(x => x.ModuleName))
                    {
                        <MudListSubheader>@module.Key</MudListSubheader>
                        @foreach (var w in module)
                        {
                        <MudListItem T="string" OnClick="@(() => SelectAsync(w.Id))"
                                     Class="@(w.Id == _current?.Id ? "mud-selected-item" : "")">
                            <MudText Typo="Typo.body2"><b>@w.DocumentName</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @w.StepCount @(w.StepCount == 1 ? "step" : "steps")
                                · revision @w.Revision
                                @if (w.OpenRequests > 0)
                                {
                                    <text> · @w.OpenRequests in flight</text>
                                }
                            </MudText>
                        </MudListItem>
                        }
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            @if (_current is null)
            {
                <MudPaper Outlined="true" Elevation="0" Class="pa-12 text-center">
                    <MudText Class="mud-text-secondary">Pick a workflow to edit it.</MudText>
                </MudPaper>
            }
            else
            {
                <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                    <div class="d-flex align-center flex-wrap gap-2 mb-4">
                        <div>
                            <MudText Typo="Typo.h6">@DocumentName(_current.DocumentType)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_current.DocumentType · revision @_current.Revision</MudText>
                        </div>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Color="@(_current.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                            @(_current.IsActive ? "Active" : "Disabled")
                        </MudChip>
                    </div>

                    <MudTextField @bind-Value="_current.Name" Label="Workflow name"
                                  Variant="Variant.Outlined" Class="mb-4" />
                    <MudTextField @bind-Value="_current.Description" Label="Description"
                                  Variant="Variant.Outlined" Lines="2" Class="mb-2"
                                  HelperText="Explain when this workflow is used so another administrator can safely maintain it." />

                    <MudSwitch T="bool" @bind-Value="_current.IsActive" Color="Color.Success"
                               Label="Accept new submissions through this workflow" />

                    <MudSwitch T="bool" @bind-Value="_current.BlockSelfApproval" Color="Color.Primary"
                               Label="The person who raises it can never approve it" />
                    <MudSwitch T="bool" @bind-Value="_current.RequireDistinctApprovers" Color="Color.Primary"
                               Label="A different person must sign at each level" />

                    <MudDivider Class="my-4" />

                    <div class="d-flex align-center mb-2">
                        <MudText Typo="Typo.subtitle1">Steps</MudText>
                        <MudSpacer />
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddStep">Add step</MudButton>
                    </div>

                    @foreach (var step in _current.Steps.OrderBy(s => s.Order).ToList())
                    {
                        <MudPaper Outlined="true" Elevation="0" Class="pa-3 mb-3">
                            <div class="d-flex align-center mb-3">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                    @step.Order
                                </MudChip>
                                <MudTextField @bind-Value="step.Name" Label="Step name"
                                              Variant="Variant.Text" Margin="Margin.Dense"
                                              Class="ml-3 mt-0" />
                                <MudSpacer />
                                <MudTooltip Text="Move up"><MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp" Size="Size.Small" Disabled="@(step.Order == 1)" OnClick="@(() => MoveStep(step, -1))" /></MudTooltip>
                                <MudTooltip Text="Move down"><MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small" Disabled="@(step.Order == _current.Steps.Count)" OnClick="@(() => MoveStep(step, 1))" /></MudTooltip>
                                <MudTooltip Text="Duplicate step"><MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="@(() => DuplicateStep(step))" /></MudTooltip>
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveStep(step))" />
                            </div>

                            <MudGrid Spacing="2" Class="mb-3">
                                <MudItem xs="12" md="5">
                                <MudSelect T="ApproverRule" @bind-Value="step.Rule" Label="Approved by"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                    <MudSelectItem Value="ApproverRule.Role">A business role</MudSelectItem>
                                    <MudSelectItem Value="ApproverRule.DepartmentHead">Their department head</MudSelectItem>
                                    <MudSelectItem Value="ApproverRule.Permission">Anyone with a permission</MudSelectItem>
                                </MudSelect>
                                </MudItem>

                                @if (step.Rule == ApproverRule.Role)
                                {
                                    <MudItem xs="12" md="7">
                                    <MudSelect T="string" @bind-Value="step.RuleValue" Label="Approver role"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                               HelperText="Every active user holding this role receives the request; the signature rule below decides how many must approve.">
                                        @foreach (var role in _roles)
                                        {
                                            <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                    </MudItem>
                                }
                                else if (step.Rule == ApproverRule.Permission)
                                {
                                    <MudItem xs="12" md="7"><MudTextField @bind-Value="step.RuleValue" Label="Permission key" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" /></MudItem>
                                }
                            </MudGrid>

                            <div class="d-flex gap-3 mb-3">
                                <MudNumericField T="decimal?" @bind-Value="step.MinAmount"
                                                 Label="From amount" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Clearable="true"
                                                 HelperText="Blank means no lower limit." />
                                <MudNumericField T="decimal?" @bind-Value="step.MaxAmount"
                                                 Label="Up to (excluding)" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Clearable="true"
                                                 HelperText="Blank means no upper limit." />
                            </div>

                            <div class="d-flex gap-3">
                                <MudNumericField T="int?" @bind-Value="step.ReminderAfterHours"
                                                 Label="Remind after (hours)" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Clearable="true" />
                                <MudNumericField T="int?" @bind-Value="step.EscalateAfterHours"
                                                 Label="Escalate after (hours)" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Clearable="true" />
                                <MudSelect T="StepQuorum" @bind-Value="step.Quorum" Label="Signatures"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="StepQuorum.Any">Any one approver</MudSelectItem>
                                    <MudSelectItem Value="StepQuorum.All">Every approver</MudSelectItem>
                                </MudSelect>
                            </div>

                            <MudGrid Spacing="2" Class="mt-1">
                                <MudItem xs="12" md="5">
                                    <MudSwitch T="bool" @bind-Value="step.AllowReturn" Color="Color.Primary"
                                               Label="Approver may return it for correction" />
                                </MudItem>
                                <MudItem xs="12" md="7">
                                    <MudSelect T="string" @bind-Value="step.EscalateToRole" Label="Escalate to role"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                               Disabled="@(step.EscalateAfterHours is null)"
                                               HelperText="Leave blank to escalate to the next approval stage.">
                                        @foreach (var role in _roles)
                                        {
                                            <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }

                    <MudPaper Outlined="true" Elevation="0" Class="pa-3 mt-4">
                        <MudText Typo="Typo.subtitle2">Test this route</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Enter a document value to see the exact approval stages that will run.</MudText>
                        <div class="d-flex align-center flex-wrap gap-2 mt-2">
                            <MudNumericField T="decimal?" @bind-Value="_previewAmount" Label="Test amount"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                            @if (_current.StepsFor(_previewAmount).Any())
                            {
                                @foreach (var preview in _current.StepsFor(_previewAmount))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@preview.Order. @preview.Name</MudChip>
                                }
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">No matching approval stage</MudChip>
                            }
                        </div>
                    </MudPaper>

                    @if (_problems.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                            @foreach (var p in _problems)
                            {
                                <div>@p</div>
                            }
                        </MudAlert>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="SaveAsync" Disabled="_busy">
                            @(_busy ? "Saving…" : "Save workflow")
                        </MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CheckAsync">Check for problems</MudButton>
                    </div>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    private IReadOnlyList<WorkflowSummary> _list = [];
    private WorkflowDefinition? _current;
    private List<string> _problems = [];
    private bool _busy;
    private decimal? _previewAmount;
    private bool _creating;
    private string? _newDocumentType;
    private IReadOnlyList<ApprovalRoleOption> _roles = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _list = await Designer.ListAsync();

    private async Task SelectAsync(int id)
    {
        _current = await Designer.GetAsync(id);
        _roles = _current is null ? [] : await Designer.RolesAsync(_current.DocumentType);
        _problems = [];
        _previewAmount = null;
    }

    private async Task StartNewAsync()
    {
        if (string.IsNullOrWhiteSpace(_newDocumentType)) return;
        _roles = await Designer.RolesAsync(_newDocumentType);
        var document = Catalog.AllApprovables.First(x => x.Key == _newDocumentType);
        _current = new WorkflowDefinition
        {
            DocumentType = document.Key,
            Name = $"Custom {document.Name}",
            Description = $"Custom approval route for {document.Name}.",
            IsActive = true,
            BlockSelfApproval = true,
            Steps =
            [
                new WorkflowStep
                {
                    Order = 1,
                    Name = "Approval",
                    Rule = ApproverRule.Role,
                    RuleValue = _roles.FirstOrDefault()?.Name,
                    Quorum = StepQuorum.Any,
                    AllowReturn = true
                }
            ]
        };
        _creating = false;
        _newDocumentType = null;
        _previewAmount = null;
        _problems = [];
    }

    private void CancelNew()
    {
        _creating = false;
        _newDocumentType = null;
    }

    private void AddStep()
    {
        if (_current is null) return;

        var next = _current.Steps.Count == 0 ? 1 : _current.Steps.Max(s => s.Order) + 1;
        _current.Steps.Add(new WorkflowStep
        {
            Order = next,
            Name = $"Step {next}",
            Rule = ApproverRule.Role,
            RuleValue = _roles.FirstOrDefault()?.Name,
            Quorum = StepQuorum.Any,
            AllowReturn = true
        });
    }

    private void RemoveStep(WorkflowStep step)
    {
        if (_current is null) return;

        _current.Steps.Remove(step);

        // Close the gap so positions stay 1..n; a hole would make the numbering
        // on the document's history read as if a step had been skipped.
        var order = 1;
        foreach (var s in _current.Steps.OrderBy(s => s.Order))
            s.Order = order++;
    }

    private void MoveStep(WorkflowStep step, int offset)
    {
        if (_current is null) return;
        var ordered = _current.Steps.OrderBy(s => s.Order).ToList();
        var index = ordered.IndexOf(step);
        var target = index + offset;
        if (index < 0 || target < 0 || target >= ordered.Count) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i + 1;
    }

    private void DuplicateStep(WorkflowStep source)
    {
        if (_current is null) return;
        var copy = new WorkflowStep
        {
            Order = source.Order + 1,
            Name = $"{source.Name} copy",
            Rule = source.Rule,
            RuleValue = source.RuleValue,
            Quorum = source.Quorum,
            MinAmount = source.MinAmount,
            MaxAmount = source.MaxAmount,
            ReminderAfterHours = source.ReminderAfterHours,
            EscalateAfterHours = source.EscalateAfterHours,
            EscalateToRole = source.EscalateToRole,
            AllowReturn = source.AllowReturn
        };
        foreach (var step in _current.Steps.Where(s => s.Order > source.Order)) step.Order++;
        _current.Steps.Add(copy);
    }

    private string DocumentName(string documentType) =>
        _list.FirstOrDefault(x => x.DocumentType == documentType)?.DocumentName ?? documentType;

    private Task CheckAsync()
    {
        if (_current is null) return Task.CompletedTask;

        _problems = [.. Designer.Validate(_current)];

        if (_problems.Count == 0)
            Snackbar.Add("No problems found.", Severity.Success);

        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_current is null) return;

        _busy = true;
        try
        {
            var result = await Designer.SaveAsync(_current);

            if (result.Failed)
            {
                _problems = [.. Designer.Validate(_current)];
                Snackbar.Add(result.Error!, Severity.Error);
                return;
            }

            _problems = [];
            Snackbar.Add("Workflow saved.", Severity.Success);
            await LoadAsync();
            await SelectAsync(result.Value);
        }
        finally { _busy = false; }
    }
}
