@page "/approvals"
@attribute [Authorize]

<PageTitle>My approvals</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">My approvals</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Everything waiting on you, across every module.
</MudText>

<MudPaper Class="pa-12 text-center" Outlined="true" Elevation="0">
    <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Large" Color="Color.Success" />
    <MudText Typo="Typo.h6" Class="mt-3">Nothing waiting on you</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
        Approvals appear here as soon as the first business module is connected.
    </MudText>
</MudPaper>
