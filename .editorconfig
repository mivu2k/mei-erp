root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,razor}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Async methods that return Task must be awaited. This one has bitten the
# previous platform, so it is an error, not a suggestion.
dotnet_diagnostic.CS4014.severity = error

# Result<T>.Success / Result<T>.Fail are the whole point of the type: a static
# factory on a generic type is the idiomatic shape here, not an oversight.
dotnet_diagnostic.CA1000.severity = none

# We are a single-locale on-premise system. Demanding an IFormatProvider on
# every ToString would add noise to thousands of call sites for no benefit;
# the culture is pinned once, at startup.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none

# Collection properties on DTOs and EF entities are set by the ORM and by
# object initialisers; making them all read-only fights the framework.
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1002.severity = none

# 'step' and 'error' are the clearest names for what they hold. The rule exists
# for cross-language COM consumers, which an on-premise Blazor app has none of.
dotnet_diagnostic.CA1716.severity = none

[tests/**/*.cs]
# Test names are sentences: Small_order_needs_only_the_first_signature reads as
# documentation in the runner output. That is the point of them.
dotnet_diagnostic.CA1707.severity = none

[*.{json,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

[*.{md,html}]
indent_size = 2
trim_trailing_whitespace = false
