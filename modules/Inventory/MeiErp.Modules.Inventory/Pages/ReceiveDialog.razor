@inject IPurchasingService Purchasing
@inject IClock Clock
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_order is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                Receiving against <b>@_order.Number</b> from @_order.PartyName.
                Only what is still outstanding can be received.
            </MudText>

            <MudDatePicker Label="Received on" Variant="Variant.Outlined" Class="mb-4"
                           Date="_date" DateChanged="@(d => _date = d)" />

            <MudTable T="ReceiveRow" Items="_rows" Dense="true" Elevation="0" Bordered="true">
                <HeaderContent>
                    <MudTh>Item</MudTh>
                    <MudTh Style="width:110px">Outstanding</MudTh>
                    <MudTh Style="width:120px">Receiving</MudTh>
                    <MudTh Style="width:130px">Unit cost</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ItemName</MudTd>
                    <MudTd style="text-align:right">@context.Outstanding.ToString("0.##")</MudTd>
                    <MudTd>
                        <MudNumericField T="decimal" @bind-Value="context.Receiving"
                                         Variant="Variant.Text" Margin="Margin.Dense"
                                         HideSpinButtons="true" Max="context.Outstanding" Min="0" />
                    </MudTd>
                    <MudTd>
                        <MudNumericField T="decimal" @bind-Value="context.UnitCost"
                                         Variant="Variant.Text" Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                The cost entered here moves the item's weighted average, so enter what the
                invoice actually says rather than what was ordered.
            </MudText>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   OnClick="SaveAsync" Disabled="_busy">Receive into stock</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int OrderId { get; set; }

    private sealed class ReceiveRow
    {
        public int ItemId { get; set; }
        public string ItemName { get; set; } = "";
        public decimal Outstanding { get; set; }
        public decimal Receiving { get; set; }
        public decimal UnitCost { get; set; }
    }

    private PurchaseOrder? _order;
    private List<ReceiveRow> _rows = [];
    private DateTime? _date;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _order = await Purchasing.GetOrderAsync(OrderId);
        _date = Clock.Today.ToDateTime(TimeOnly.MinValue);

        if (_order is null) return;

        // Defaults to receiving everything outstanding, which is the usual case.
        _rows = [.. _order.Lines
            .Where(l => l.Outstanding > 0)
            .Select(l => new ReceiveRow
            {
                ItemId = l.ItemId,
                ItemName = l.ItemName,
                Outstanding = l.Outstanding,
                Receiving = l.Outstanding,
                UnitCost = l.UnitCost
            })];
    }

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var lines = _rows.Where(r => r.Receiving > 0).ToList();
            if (lines.Count == 0)
            {
                _error = "Nothing has been entered as received.";
                return;
            }

            var result = await Purchasing.ReceiveAsync(new ReceiptInput(
                OrderId, DateOnly.FromDateTime(_date ?? DateTime.Today), null,
                [.. lines.Select(r => new ReceiptLineInput(r.ItemId, r.Receiving, r.UnitCost))]));

            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add($"{result.Value.Number} received into stock.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }
}
