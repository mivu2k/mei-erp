@page "/inventory/tracking"
@attribute [Authorize(Policy=InventoryModule.TrackingManage)]
@inject IStockTrackingService TrackingService
@inject ICatalogService Catalog
<PageTitle>Serials and batches</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Serials &amp; batches</MudText>
<MudTabs @bind-ActivePanelIndex="_tab"><MudTabPanel Text="Serialized units"><MudPaper Class="pa-3"><div class="d-flex gap-2 mb-3"><MudTextField @bind-Value="_search" Placeholder="Find serial" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"/><MudSelect T="StockUnitStatus?" @bind-Value="_status" Label="Status" Clearable><MudSelectItem T="StockUnitStatus?" Value="@((StockUnitStatus?)null)">All</MudSelectItem>@foreach(var value in Enum.GetValues<StockUnitStatus>()){<MudSelectItem T="StockUnitStatus?" Value="@((StockUnitStatus?)value)">@value</MudSelectItem>}</MudSelect><MudButton OnClick="Load">Apply</MudButton></div><MudTable Items="FilteredUnits" Dense Hover><HeaderContent><MudTh>Serial</MudTh><MudTh>Item</MudTh><MudTh>Status</MudTh><MudTh>Warehouse</MudTh><MudTh>Received</MudTh><MudTh>Issued to</MudTh><MudTh>Reference</MudTh></HeaderContent><RowTemplate><MudTd><b>@context.SerialNumber</b></MudTd><MudTd>@context.Item?.Name</MudTd><MudTd>@context.Status</MudTd><MudTd>@context.Warehouse?.Name</MudTd><MudTd>@context.ReceivedOn</MudTd><MudTd>@context.IssuedTo</MudTd><MudTd>@context.Reference</MudTd></RowTemplate></MudTable></MudPaper></MudTabPanel>
<MudTabPanel Text="Batches"><MudPaper Class="pa-3"><MudTable Items="_batches" Dense Hover><HeaderContent><MudTh>Batch</MudTh><MudTh>Item</MudTh><MudTh>Warehouse</MudTh><MudTh>Received</MudTh><MudTh>Expires</MudTh><MudTh>Original</MudTh><MudTh>Remaining</MudTh></HeaderContent><RowTemplate><MudTd><b>@context.BatchNumber</b></MudTd><MudTd>@context.Item?.Name</MudTd><MudTd>@context.Warehouse?.Name</MudTd><MudTd>@context.ReceivedOn</MudTd><MudTd><span class="@(context.IsExpired(Clock.Today)?"mud-text-error":"")">@context.ExpiresOn</span></MudTd><MudTd>@context.Quantity</MudTd><MudTd>@context.RemainingQuantity</MudTd></RowTemplate></MudTable></MudPaper></MudTabPanel></MudTabs>
@code{private int _tab;private string? _search;private StockUnitStatus? _status;private List<StockUnit> _units=[];private List<StockBatch> _batches=[];private IEnumerable<StockUnit> FilteredUnits=>string.IsNullOrWhiteSpace(_search)?_units:_units.Where(x=>x.SerialNumber.Contains(_search,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){_units=await TrackingService.UnitsAsync(status:_status);_batches=await TrackingService.BatchesAsync(openOnly:false);}}
