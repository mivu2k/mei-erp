@page "/inventory/sales-orders"
@attribute [Authorize(Policy = InventoryModule.SalesManage)]
@rendermode InteractiveServer
@inject ISalesService Sales
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Sales orders</PageTitle>

<div class="d-flex align-center mb-1">
    <div>
        <MudText Typo="Typo.h5">Sales orders</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Confirming an order reserves nothing — stock is checked when goods actually go out.
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
        New order
    </MudButton>
</div>

<MudPaper Outlined="true" Elevation="0" Class="mt-4">
    <MudDataGrid T="SalesOrder" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Loading="_loading" Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(o => o.Number)" Title="Number" />
            <TemplateColumn Title="Date">
                <CellTemplate>@context.Item.Date.ToString("d MMM yyyy")</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(o => o.PartyName)" Title="Customer" />
            <TemplateColumn Title="Value" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    <span style="font-variant-numeric:tabular-nums">@context.Item.Total.ToString("N2")</span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@Colour(context.Item.Status)">@context.Item.Status</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div class="d-flex justify-end gap-1">
                        @if (context.Item.Status is SalesOrderStatus.Draft)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => Edit(context.Item))">Edit</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="@(() => Confirm(context.Item))">Confirm</MudButton>
                        }
                        else if (context.Item.Status is SalesOrderStatus.Confirmed
                                                     or SalesOrderStatus.PartiallyDelivered)
                        {
                            <AuthorizeView Policy="@InventoryModule.DeliveryPost" Context="perms">
                                <Authorized>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                               OnClick="@(() => Deliver(context.Item))">Deliver</MudButton>
                                </Authorized>
                            </AuthorizeView>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-8 text-center mud-text-secondary">No sales orders yet.</MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@code {
    private IReadOnlyList<SalesOrder> _rows = [];
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Sales.ListOrdersAsync(null);
        _loading = false;
    }

    private static Color Colour(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Delivered => Color.Success,
        SalesOrderStatus.Confirmed => Color.Info,
        SalesOrderStatus.PartiallyDelivered => Color.Info,
        SalesOrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private async Task Edit(SalesOrder? row)
    {
        var parameters = new DialogParameters<OrderEditor>
        {
            { x => x.OrderId, row?.Id },
            { x => x.IsPurchase, false }
        };
        var dialog = await Dialogs.ShowAsync<OrderEditor>(
            row is null ? "New sales order" : "Edit order", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        if (!(await dialog.Result)!.Canceled) await LoadAsync();
    }

    private async Task Confirm(SalesOrder row)
    {
        var result = await Sales.ConfirmAsync(row.Id);
        if (result.Failed) Snackbar.Add(result.Error!, Severity.Error);
        else Snackbar.Add("Order confirmed.", Severity.Success);
        await LoadAsync();
    }

    private async Task Deliver(SalesOrder row)
    {
        var parameters = new DialogParameters<DeliverDialog> { { x => x.OrderId, row.Id } };
        var dialog = await Dialogs.ShowAsync<DeliverDialog>("Deliver goods", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        if (!(await dialog.Result)!.Canceled) await LoadAsync();
    }
}
