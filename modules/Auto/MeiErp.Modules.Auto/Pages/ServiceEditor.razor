@inject IFleetService Fleet
@inject IClock Clock
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<DocumentShell @ref="_shell" AsDialog="AsDialog" Title="@Title" Error="@_error" OnClose="DismissedAsync">
    <Body>
        <MudText Typo="Typo.body2" Class="mb-4">Logging against <b>@_registration</b>.</MudText>

        <MudForm @ref="_form">
            <div class="d-flex gap-3 mb-4">
                <MudSelect T="ServiceKind" @bind-Value="_kind" Label="Kind" Variant="Variant.Outlined">
                    @foreach (var k in Enum.GetValues<ServiceKind>())
                    {
                        <MudSelectItem Value="@k">@k</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker Label="Date" Variant="Variant.Outlined"
                               Date="_date" DateChanged="@(d => _date = d)" />
            </div>

            <MudTextField @bind-Value="_description" Label="What was done" Required="true"
                          RequiredError="Say what was done." Variant="Variant.Outlined" Class="mb-4" />

            <div class="d-flex gap-3 mb-4">
                <MudNumericField T="decimal" @bind-Value="_cost" Label="Cost"
                                 Variant="Variant.Outlined" HideSpinButtons="true" />
                <MudNumericField T="int?" @bind-Value="_odometer" Label="Odometer"
                                 Variant="Variant.Outlined" HideSpinButtons="true"
                                 HelperText="@(_lastOdometer is null ? null : $"Last recorded {_lastOdometer:N0}")" />
            </div>

            <div class="d-flex gap-3 mb-4">
                <MudTextField @bind-Value="_vendor" Label="Vendor" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_invoice" Label="Invoice number" Variant="Variant.Outlined" />
            </div>

            @if (_kind is ServiceKind.Insurance or ServiceKind.Registration or ServiceKind.Routine)
            {
                <MudDatePicker Label="Next due" Variant="Variant.Outlined"
                               Date="_nextDue" DateChanged="@(d => _nextDue = d)"
                               HelperText="Feeds the reminder list on the fleet page." />
                <MudNumericField T="int?" @bind-Value="_nextDueOdometer" Label="Next due odometer"
                                 Variant="Variant.Outlined" HideSpinButtons="true" Class="mt-3" />
            }
        </MudForm>
    </Body>

    <Buttons>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </Buttons>
</DocumentShell>

@code {
    [Parameter] public bool AsDialog { get; set; }
    [Parameter] public int VehicleId { get; set; }
    [Parameter] public int? ServiceId { get; set; }
    [Parameter] public string? Registration { get; set; }
    [Parameter] public int? LastOdometer { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string Title => ServiceId is null ? "Log service" : "Edit service";

    private MudForm? _form;
    private ServiceKind _kind = ServiceKind.Routine;
    private DateTime? _date;
    private DateTime? _nextDue;
    private string _description = "";
    private string? _vendor;
    private string? _invoice;
    private decimal _cost;
    private int? _odometer;
    private int? _nextDueOdometer;
    private string? _error;
    private bool _busy;
    private string? _registration;
    private int? _lastOdometer;

    protected override async Task OnInitializedAsync()
    {
        _registration = Registration;
        _lastOdometer = LastOdometer;
        if (_registration is null)
        {
            // Opened as a full page, so the caller didn't hand these in - look
            // the vehicle up ourselves.
            var vehicle = await Fleet.GetAsync(VehicleId);
            _registration = vehicle?.Registration ?? "";
            _lastOdometer = vehicle?.CurrentOdometer;
        }

        _date = Clock.Today.ToDateTime(TimeOnly.MinValue);
        if (ServiceId is not { } id) return;
        var row = (await Fleet.ServicesAsync(VehicleId)).FirstOrDefault(x => x.Id == id);
        if (row is null) { _error = "That service record no longer exists."; return; }
        _kind = row.Kind;
        _date = row.Date.ToDateTime(TimeOnly.MinValue);
        _nextDue = row.NextDueDate?.ToDateTime(TimeOnly.MinValue);
        _description = row.Description;
        _vendor = row.Vendor;
        _invoice = row.InvoiceNumber;
        _cost = row.Cost;
        _odometer = row.Odometer;
        _nextDueOdometer = row.NextDueOdometer;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var model = new VehicleService
            {
                Id = ServiceId ?? 0,
                VehicleId = VehicleId,
                Date = _date is null ? Clock.Today : DateOnly.FromDateTime(_date.Value),
                Kind = _kind,
                Description = _description,
                Vendor = _vendor,
                InvoiceNumber = _invoice,
                Cost = _cost,
                Odometer = _odometer,
                NextDueDate = _nextDue is null ? null : DateOnly.FromDateTime(_nextDue.Value),
                NextDueOdometer = _nextDueOdometer
            };
            var result = ServiceId is null
                ? await Fleet.AddServiceAsync(model)
                : await Fleet.UpdateServiceAsync(model);

            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add("Service recorded.", Severity.Success);
            ServiceId = model.Id;
            await Saved.InvokeAsync();
            if (AsDialog && _shell is not null) await _shell.CloseAsync();
        }
        finally { _busy = false; }
    }

    private DocumentShell? _shell;
    
    /// <summary>The shell has already closed itself; just react to it.</summary>
    private async Task DismissedAsync()
    {
        if (Closed.HasDelegate) { await Closed.InvokeAsync(); return; }
        Nav.NavigateTo($"/auto/vehicles/{VehicleId}");
    }
}
