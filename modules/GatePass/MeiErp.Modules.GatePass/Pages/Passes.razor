@page "/gatepass"
@page "/gatepass/passes"
@page "/gatepass/passes/outstanding"
@page "/gatepass/passes/{LegacyId:int}"
@attribute [Authorize(Policy = GatePassModule.PassesView)]
@rendermode InteractiveServer
@inject IGatePassService Gate
@inject IClock Clock
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<ListShell Title="Gate passes"
           Subtitle="Whoever raises a pass cannot clear it through the gate. That separation is the point."
           Icon="@Icons.Material.Outlined.DirectionsCar"
           Loading="_loading"
           IsEmpty="@(!_loading && _rows.Count == 0)"
           EmptyIcon="@Icons.Material.Outlined.DirectionsCar"
           EmptyTitle="No gate passes yet"
           EmptyHint="Raise a pass for anything moving in or out through the gate.">
    <Actions>
        <AuthorizeView Policy="@GatePassModule.PassesRaise" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    New pass
                </MudButton>
                <MudTooltip Text="Open as a full page instead">
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="/gatepass/passes/new" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </Actions>

    <Stats>
        @if (_overdue.Count > 0)
        {
            <StatTile Label="Overdue returns" Value="@_overdue.Count.ToString()" Colour="Color.Warning"
                      Caption="@string.Join(", ", _overdue.Select(p => p.Number))" />
        }
    </Stats>

    <EmptyAction>
        <AuthorizeView Policy="@GatePassModule.PassesRaise" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    New pass
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </EmptyAction>

    <ChildContent>
    <MudDataGrid T="Pass" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(p => p.Number)" Title="Number" />
            <TemplateColumn Title="Date">
                <CellTemplate>@context.Item.Date.ToString("d MMM yyyy")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Direction">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.Item.Direction == PassDirection.Outward ? Color.Warning : Color.Info)">
                        @context.Item.Direction
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(p => p.PartyName)" Title="To / from" />
            <TemplateColumn Title="Items">
                <CellTemplate>
                    @context.Item.Items.Count
                    @if (context.Item.IsReturnable)
                    {
                        <MudTooltip Text="@($"Expected back {context.Item.ExpectedBack:d MMM yyyy}")">
                            <MudIcon Icon="@Icons.Material.Outlined.AssignmentReturn" Size="Size.Small"
                                     Class="ml-1 mud-text-secondary" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@Colour(context.Item.Status)">@context.Item.Status</MudChip>
                    @if (context.Item.IsOverdue(Clock.Today))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                 Variant="Variant.Filled">overdue</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div class="d-flex justify-end gap-1">
                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" OnClick="@(() => View(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Print" Href="@($"/print/gatepass/{context.Item.Id}")" Target="_blank" />
                        <MudIconButton Icon="@Icons.Material.Outlined.ReceiptLong" Href="@($"/print/gatepass/{context.Item.Id}?size=roll")" Target="_blank" />
                        @if (context.Item.Status is PassStatus.Issued)
                        {
                            <AuthorizeView Policy="@GatePassModule.PassesRaise" Context="raisePerms">
                                <Authorized>
                                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                                   Href="@($"/gatepass/passes/{context.Item.Id}/edit")"
                                                   title="Open as a page" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => Edit(context.Item))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Cancel" Color="Color.Error" OnClick="@(() => Cancel(context.Item))" />
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="@GatePassModule.PassesClear" Context="perms">
                                <Authorized>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                               OnClick="@(() => Clear(context.Item))">Clear</MudButton>
                                </Authorized>
                            </AuthorizeView>
                        }
                        else if (context.Item.IsReturnable
                                 && context.Item.Status is PassStatus.Cleared
                                                        or PassStatus.PartiallyReturned)
                        {
                            <AuthorizeView Policy="@GatePassModule.PassesReturn" Context="perms">
                                <Authorized>
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               OnClick="@(() => Receive(context.Item))">Receive back</MudButton>
                                </Authorized>
                            </AuthorizeView>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    </ChildContent>
</ListShell>

@if (_editing)
{
    <PassEditor AsDialog="true" PassId="_editingId"
                Saved="LoadAsync" Closed="@(() => { _editing = false; return Task.CompletedTask; })" />
}

@code {
    [Parameter] public int? LegacyId { get; set; }
    private IReadOnlyList<Pass> _rows = [];
    private IReadOnlyList<Pass> _overdue = [];
    private bool _loading = true;
    private bool _legacyOpened;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && LegacyId is not null && !_legacyOpened)
        {
            _legacyOpened = true;
            var pass = await Gate.GetAsync(LegacyId.Value);
            if (pass is not null) await View(pass);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Gate.ListAsync(null);
        _overdue = await Gate.OverdueAsync();
        _loading = false;
    }

    private static Color Colour(PassStatus status) => status switch
    {
        PassStatus.Returned => Color.Success,
        PassStatus.Cleared => Color.Info,
        PassStatus.PartiallyReturned => Color.Warning,
        PassStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private bool _editing;
    private int? _editingId;

    private void Edit(Pass? row)
    {
        _editingId = row?.Id;
        _editing = true;
    }

    private async Task View(Pass row)
    {
        var parameters = new DialogParameters<PassDetail> { { x => x.PassId, row.Id } };
        await Dialogs.ShowAsync<PassDetail>(row.Number, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private async Task Cancel(Pass row)
    {
        var parameters = new DialogParameters<CancelPassDialog> { { x => x.PassId, row.Id } };
        var dialog = await Dialogs.ShowAsync<CancelPassDialog>($"Cancel {row.Number}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled) await LoadAsync();
    }

    private async Task Clear(Pass row)
    {
        var result = await Gate.ClearAsync(row.Id);
        if (result.Failed) Snackbar.Add(result.Error!, Severity.Error);
        else Snackbar.Add($"{row.Number} cleared through the gate.", Severity.Success);
        await LoadAsync();
    }

    private async Task Receive(Pass row)
    {
        var parameters = new DialogParameters<ReturnDialog> { { x => x.PassId, row.Id } };
        var dialog = await Dialogs.ShowAsync<ReturnDialog>("Receive goods back", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        if (!(await dialog.Result)!.Canceled) await LoadAsync();
    }
}
