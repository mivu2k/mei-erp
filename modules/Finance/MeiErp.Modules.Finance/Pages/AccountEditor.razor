@inject IAccountService Accounts
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<DocumentShell @ref="_shell" AsDialog="AsDialog" Title="@Title" Error="@_error" OnClose="DismissedAsync">
    <Body>
        <MudForm @ref="_form">
            <FormSection Title="The head" Icon="@Icons.Material.Outlined.AccountBalance"
                         Hint="Type decides which side of the trial balance and which statement it lands on.">
                <div class="app-form-grid">
                    <MudTextField @bind-Value="_model.Code" Label="Code" Required="true"
                                  RequiredError="Give it a code." Variant="Variant.Outlined" />
                    <MudSelect T="AccountType" @bind-Value="_model.Type" Label="Type"
                               Variant="Variant.Outlined">
                        @foreach (var t in Enum.GetValues<AccountType>())
                        {
                            <MudSelectItem Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_model.Name" Label="Name" Required="true"
                                  RequiredError="Give it a name." Variant="Variant.Outlined"
                                  Class="app-form-wide" />
                </div>
            </FormSection>

            <FormSection Title="Where it sits" Icon="@Icons.Material.Outlined.AccountTree"
                         Hint="Only leaves can be posted to — a heading with its own balance double-counts itself against its children in every report.">
                <div class="app-form-grid">
                    <MudSelect T="int?" @bind-Value="_model.ParentId" Label="Sits under"
                               Variant="Variant.Outlined" Clearable="true" Class="app-form-wide">
                        @foreach (var a in _all.Where(a => a.Id != _model.Id))
                        {
                            <MudSelectItem T="int?" Value="@a.Id">@a.Code — @a.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="_model.IsPostable" Color="Color.Primary"
                               Class="app-form-wide"
                               Label="Entries can be posted to this account" />
                </div>
            </FormSection>

            <FormSection Title="In use" Icon="@Icons.Material.Outlined.ToggleOn"
                         Hint="An account with entries can never be deleted, only deactivated.">
                <div class="app-form-grid">
                    <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Primary"
                               Class="app-form-wide" Label="Active" />
                </div>
            </FormSection>
        </MudForm>
    </Body>

    <Buttons>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </Buttons>
</DocumentShell>

@code {
    [Parameter] public bool AsDialog { get; set; }
    [Parameter] public int? AccountId { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string Title => AccountId is null ? "New account" : "Edit account";

    private MudForm? _form;
    private Account _model = new();
    private IReadOnlyList<Account> _all = [];
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _all = await Accounts.ListAsync(includeInactive: true);
        _model = AccountId is null
            ? new Account { IsPostable = true, IsActive = true }
            : await Accounts.GetAsync(AccountId.Value) ?? new Account();
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var result = await Accounts.SaveAsync(_model);
            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add("Saved.", Severity.Success);
            AccountId = _model.Id;
            await Saved.InvokeAsync();
            if (AsDialog && _shell is not null) await _shell.CloseAsync();
        }
        finally { _busy = false; }
    }

    private DocumentShell? _shell;
    
    /// <summary>The shell has already closed itself; just react to it.</summary>
    private async Task DismissedAsync()
    {
        if (Closed.HasDelegate) { await Closed.InvokeAsync(); return; }
        Nav.NavigateTo("/finance/accounts");
    }
}
