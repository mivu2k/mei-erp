@page "/finance/advances"
@attribute [Authorize(Policy = FinanceModule.AdvancesRaise)]
@rendermode InteractiveServer
@inject IAdvanceService Loans
@inject ISnackbar Snackbar

<ListShell Title="@Title"
           Subtitle="Money given before it is spent. Paid out, accounted for with receipts, then settled."
           Icon="@Icons.Material.Outlined.AccountBalanceWallet"
           Loading="_loading"
           IsEmpty="@(_rows.Count == 0)"
           EmptyIcon="@Icons.Material.Outlined.AccountBalanceWallet"
           EmptyTitle="@($"No {(_directorOnly ? "director funds" : "advances")} yet")"
           EmptyHint="Raise one here to get money out before it needs to be spent.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
            @(_directorOnly ? "Request director funds" : "Request an advance")
        </MudButton>
        <MudTooltip Text="Open as a full page instead">
            <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="/finance/money-requests/new" />
        </MudTooltip>
    </Actions>

    <EmptyAction>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
            @(_directorOnly ? "Request director funds" : "Request an advance")
        </MudButton>
    </EmptyAction>

    <Toolbar>
        <MudSwitch T="bool" @bind-Value="_mineOnly" @bind-Value:after="LoadAsync"
                   Color="Color.Primary" Label="Only mine" />
    </Toolbar>

    <ChildContent>
    <MudDataGrid T="PaymentRequest" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(a => a.Reference)" Title="Reference" />
            <TemplateColumn Title="For">
                <CellTemplate>
                    <MudText Typo="Typo.body2"><b>@context.Item.Title</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.Item.RequestedByName
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Asked" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    <span style="font-variant-numeric:tabular-nums">@context.Item.Amount.ToString("N2")</span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Taken" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    <span style="font-variant-numeric:tabular-nums">
                        @(context.Item.DisbursedAmount?.ToString("N2") ?? "—")
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Spent" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    <span style="font-variant-numeric:tabular-nums">
                        @(context.Item.JustifiedAmount?.ToString("N2") ?? "—")
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Outstanding" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    @if (context.Item.Status == PaymentRequestStatus.Settled
                         && context.Item.OutstandingDifference != 0)
                    {
                        @* Money the person is still holding, or still owed.
                           Settled does not always mean square. *@
                        <MudText Typo="Typo.body2" Color="Color.Warning"
                                 Style="font-variant-numeric:tabular-nums">
                            @context.Item.OutstandingDifference.ToString("N2")
                        </MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@Colour(context.Item.Status)">@context.Item.Status</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div class="d-flex justify-end gap-1">
                        @if (context.Item.Status is PaymentRequestStatus.Draft or PaymentRequestStatus.Returned)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                           Href="@($"/finance/advances/{context.Item.Id}/edit")"
                                           title="Open as a page" />
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => Edit(context.Item))">Edit</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="@(() => Submit(context.Item))">Submit</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       Href="@($"/finance/advances/{context.Item.Id}")">Open</MudButton>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    </ChildContent>
</ListShell>

@if (_editing)
{
    <AdvanceEditor AsDialog="true" AdvanceId="_editingId" DirectorMode="_directorOnly"
                    Saved="LoadAsync" Closed="@(() => { _editing = false; return Task.CompletedTask; })" />
}

@code {
    private IReadOnlyList<PaymentRequest> _rows = [];
    private bool _mineOnly;
    private bool _loading = true;
    [SupplyParameterFromQuery(Name = "director")]
    public bool _directorOnly { get; set; }

    private string Title => _directorOnly ? "Director funds" : "Advances";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Loans.ListAsync(null, _mineOnly, _directorOnly);
        _loading = false;
    }

    private static Color Colour(PaymentRequestStatus status) => status switch
    {
        PaymentRequestStatus.Settled => Color.Success,
        PaymentRequestStatus.Approved => Color.Info,
        PaymentRequestStatus.Disbursed => Color.Primary,
        PaymentRequestStatus.Justified => Color.Info,
        PaymentRequestStatus.Rejected => Color.Error,
        PaymentRequestStatus.Returned => Color.Warning,
        _ => Color.Default
    };

    private bool _editing;
    private int? _editingId;

    private void Edit(PaymentRequest? row)
    {
        _editingId = row?.Id;
        _editing = true;
    }

    private async Task Submit(PaymentRequest row)
    {
        var result = await Loans.SubmitAsync(row.Id);
        if (result.Failed) Snackbar.Add(result.Error!, Severity.Error);
        else Snackbar.Add("Sent for approval.", Severity.Success);
        await LoadAsync();
    }
}
