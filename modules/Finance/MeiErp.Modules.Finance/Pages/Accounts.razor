@page "/finance"
@page "/finance/accounts"
@attribute [Authorize(Policy = FinanceModule.AccountsView)]
@rendermode InteractiveServer
@inject IAccountService Chart
@inject ISnackbar Snackbar

<ListShell Title="Chart of accounts"
           Subtitle="Only the accounts shown in black can be posted to. Headings just group them."
           Icon="@Icons.Material.Outlined.AccountBalance"
           Loading="_loading"
           IsEmpty="@(_rows.Count == 0)"
           EmptyIcon="@Icons.Material.Outlined.AccountBalance"
           EmptyTitle="No accounts yet"
           EmptyHint="Build the chart of accounts before anything can be posted.">
    <Actions>
        <AuthorizeView Policy="@FinanceModule.AccountsManage" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    New account
                </MudButton>
                <MudTooltip Text="Open as a full page instead">
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="/finance/accounts/new" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </Actions>

    <EmptyAction>
        <AuthorizeView Policy="@FinanceModule.AccountsManage" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    New account
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </EmptyAction>

    <ChildContent>
    <MudDataGrid T="Account" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Filterable="false" RowsPerPage="50" Groupable="false">
        <Columns>
            <PropertyColumn Property="@(a => a.Code)" Title="Code" />
            <TemplateColumn Title="Account">
                <CellTemplate>
                    @if (context.Item.IsPostable)
                    {
                        <MudText Typo="Typo.body2">@context.Item.Name</MudText>
                    }
                    else
                    {
                        @* A heading reads differently because it behaves
                           differently - you cannot post to it. *@
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            <b>@context.Item.Name</b>
                        </MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(a => a.Type)" Title="Type" />
            <TemplateColumn Title="Balance" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    @if (context.Item.IsPostable)
                    {
                        var balance = _balances.GetValueOrDefault(context.Item.Id);
                        @* Shown on its natural side, so an expense and a
                           liability both read as positive numbers. *@
                        var shown = context.Item.IsDebitNatured ? balance : -balance;
                        <span style="font-variant-numeric: tabular-nums">@shown.ToString("N2")</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <AuthorizeView Policy="@FinanceModule.AccountsManage" Context="perms">
                        <Authorized>
                            <div class="d-flex justify-end gap-1">
                                <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                               Href="@($"/finance/accounts/{context.Item.Id}")"
                                               title="Open as a page" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                               OnClick="@(() => Edit(context.Item))" />
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    </ChildContent>
</ListShell>

@if (_editing)
{
    <AccountEditor AsDialog="true" AccountId="_editingId"
                    Saved="LoadAsync" Closed="@(() => { _editing = false; return Task.CompletedTask; })" />
}

@code {
    private IReadOnlyList<Account> _rows = [];
    private Dictionary<int, decimal> _balances = [];
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Chart.ListAsync(includeInactive: true);

        _balances = [];
        foreach (var account in _rows.Where(a => a.IsPostable))
            _balances[account.Id] = await Chart.BalanceAsync(account.Id);

        _loading = false;
    }

    private bool _editing;
    private int? _editingId;

    private void Edit(Account? row)
    {
        _editingId = row?.Id;
        _editing = true;
    }
}
