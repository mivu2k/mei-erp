@inject IAdvanceService Advances
@inject IClock Clock
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<DocumentShell @ref="_shell" AsDialog="AsDialog" Title="@Title" Error="@_error" OnClose="DismissedAsync">
    <Body>
        <MudForm @ref="_form">
            <FormSection Title="What the advance is for" Icon="@Icons.Material.Outlined.Description"
                         Hint="An advance is settled later against receipts, so the purpose is what the settlement is checked against.">
                <div class="app-form-grid">
                    <MudTextField @bind-Value="_purpose" Label="What is it for?" Required="true"
                                  RequiredError="Say what the advance is for." Lines="2"
                                  Variant="Variant.Outlined" Class="app-form-wide" />
                </div>
            </FormSection>

            <FormSection Title="How much, and when" Icon="@Icons.Material.Outlined.Payments"
                         Hint="Approval authorises the advance; the money moves when it is actually paid out.">
                <div class="app-form-grid">
                    <MudNumericField T="decimal" @bind-Value="_amount" Label="Amount"
                                     Variant="Variant.Outlined" HideSpinButtons="true" />
                    <MudDatePicker Label="Needed by" Variant="Variant.Outlined"
                                   Date="_neededBy" DateChanged="@(d => _neededBy = d)" />
                </div>
            </FormSection>
        </MudForm>
    </Body>

    <Buttons>
        <MudButton Variant="Variant.Text" OnClick="@(() => SaveAsync(false))" Disabled="_busy">
            Save draft
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => SaveAsync(true))" Disabled="_busy">Save &amp; submit</MudButton>
    </Buttons>
</DocumentShell>

@code {
    [Parameter] public bool AsDialog { get; set; }
    [Parameter] public int? AdvanceId { get; set; }
    [Parameter] public bool DirectorMode { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string Title => AdvanceId is null ? "Request an advance" : "Edit request";

    private MudForm? _form;
    private string _purpose = "";
    private decimal _amount;
    private DateTime? _neededBy;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _neededBy = Clock.Today.AddDays(3).ToDateTime(TimeOnly.MinValue);

        if (AdvanceId is not null)
        {
            var existing = await Advances.GetAsync(AdvanceId.Value);
            if (existing is not null)
            {
                _purpose = existing.Title;
                _amount = existing.Amount;
                DirectorMode = existing.IsDirectorRequest;
                _neededBy = existing.NeededBy.ToDateTime(TimeOnly.MinValue);
            }
        }
    }

    private async Task SaveAsync(bool submit)
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var saved = await Advances.SaveDraftAsync(new AdvanceInput(
                AdvanceId, _purpose, _amount,
                DateOnly.FromDateTime(_neededBy ?? Clock.Today.ToDateTime(TimeOnly.MinValue)), null, null, null,
                DirectorMode));

            if (saved.Failed) { _error = saved.Error; return; }

            if (submit)
            {
                var sent = await Advances.SubmitAsync(saved.Value.Id);
                if (sent.Failed)
                {
                    // The draft survives, so nothing typed is lost.
                    _error = sent.Error + " Your draft has been saved.";
                    return;
                }
                Snackbar.Add("Sent for approval.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Draft saved.", Severity.Success);
            }

            AdvanceId = saved.Value.Id;
            await Saved.InvokeAsync();
            if (AsDialog && _shell is not null) await _shell.CloseAsync();
        }
        finally { _busy = false; }
    }

    private DocumentShell? _shell;
    
    /// <summary>The shell has already closed itself; just react to it.</summary>
    private async Task DismissedAsync()
    {
        if (Closed.HasDelegate) { await Closed.InvokeAsync(); return; }
        Nav.NavigateTo("/finance/advances");
    }
}
