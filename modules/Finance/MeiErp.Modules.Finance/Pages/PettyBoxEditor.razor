@inject IPettyCashService Petty
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.Name" Label="Box name" Required="true"
                          RequiredError="Give the box a name." Variant="Variant.Outlined" Class="mb-4" />

            <MudTextField @bind-Value="_model.CustodianName" Label="Held by" Required="true"
                          RequiredError="Say who holds this float."
                          Variant="Variant.Outlined" Class="mb-4"
                          HelperText="An unattributed float is one nobody is answerable for." />

            <MudNumericField T="decimal" @bind-Value="_model.FloatAmount" Label="Float"
                             Variant="Variant.Outlined" HideSpinButtons="true"
                             HelperText="The standing amount the box is topped up to." />
        </MudForm>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Create box</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private MudForm? _form;
    private PettyCashBox _model = new() { IsActive = true };
    private string? _error;
    private bool _busy;

    private async Task SaveAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var result = await Petty.SaveBoxAsync(_model);
            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add("Box created with its own cash account.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }
}
