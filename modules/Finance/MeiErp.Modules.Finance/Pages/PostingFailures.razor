@page "/finance/posting-failures"
@attribute [Authorize(Policy = FinanceModule.PostingManage)]
@rendermode InteractiveServer
@inject IOutboxManagementService Outbox
@inject ISnackbar Snackbar

<ListShell Title="Posting failures" Subtitle="Messages appear here after five failed delivery attempts. Fix the posting rule or account, then retry."
           Icon="@Icons.Material.Outlined.SyncProblem" IsEmpty="@(_rows.Count==0)" EmptyTitle="No posting failures" EmptyHint="All cross-module financial messages have posted successfully.">
 <ChildContent><MudTable Items="_rows" Dense="true" Hover="true" RowsPerPage="25">
 <HeaderContent><MudTh>Source</MudTh><MudTh>Event</MudTh><MudTh>Occurred</MudTh><MudTh>Attempts</MudTh><MudTh>Error</MudTh><MudTh /></HeaderContent>
 <RowTemplate><MudTd>@context.Source #@context.Id</MudTd><MudTd>@context.EventType</MudTd><MudTd>@context.OccurredUtc.ToLocalTime().ToString("g")</MudTd><MudTd>@context.Attempts</MudTd><MudTd>@context.LastError</MudTd><MudTd><MudButton Size="Size.Small" OnClick="@(() => RetryAsync(context))">Retry</MudButton></MudTd></RowTemplate>
 <PagerContent><MudTablePager PageSizeOptions="@(new[]{10,25,50,100})" /></PagerContent>
</MudTable></ChildContent>
</ListShell>

@code {
 private List<PendingOutboxMessage> _rows=[];
 protected override async Task OnInitializedAsync()=>await ReloadAsync();
 private async Task ReloadAsync()=>_rows=[..await Outbox.DeadLettersAsync()];
 private async Task RetryAsync(PendingOutboxMessage row){await Outbox.RetryAsync(row.Source,row.Id);Snackbar.Add("Queued for retry.",Severity.Success);await ReloadAsync();}
}
