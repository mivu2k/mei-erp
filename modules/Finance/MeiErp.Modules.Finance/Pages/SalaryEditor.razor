@inject IPayrollService Wages
@inject IClock Clock
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<DocumentShell @ref="_shell" AsDialog="AsDialog" Title="Set salary" Error="@_error" OnClose="DismissedAsync">
    <Body>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            @_employeeName — this supersedes whatever is in force, from the date below.
            Payslips already issued are untouched.
        </MudText>

        <FormSection Title="What they earn" Icon="@Icons.Material.Outlined.Payments"
                     Hint="A structure runs from its effective date until the next one supersedes it.">
            <div class="app-form-grid">
                <MudNumericField T="decimal" @bind-Value="_basic" Label="Basic salary"
                                 Variant="Variant.Outlined" HideSpinButtons="true" />
                <MudDatePicker Label="Effective from" Variant="Variant.Outlined" FixDay="1"
                               Date="_from" DateChanged="@(d => _from = d)" />
            </div>
        </FormSection>

        @if (_components.Count > 0)
        {
            @* A line grid, not standalone fields — it stays a table. *@
            <FormSection Title="Allowances and deductions" Icon="@Icons.Material.Outlined.Tune"
                         Hint="Leave a line at zero and it is left off the structure entirely.">
                <MudSimpleTable Dense="true">
                    <tbody>
                        @foreach (var component in _components)
                        {
                            <tr>
                                <td>
                                    @component.Name
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                             Color="@(component.Kind == PayComponentKind.Earning ? Color.Success : Color.Warning)">
                                        @component.Kind
                                    </MudChip>
                                </td>
                                <td style="width:150px">
                                    <MudNumericField T="decimal" Value="@Amount(component.Id)"
                                                     ValueChanged="@(v => SetAmount(component.Id, v))"
                                                     Variant="Variant.Text" Margin="Margin.Dense"
                                                     HideSpinButtons="true" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </FormSection>
        }
    </Body>

    <Buttons>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Save salary</MudButton>
    </Buttons>
</DocumentShell>

@code {
    [Parameter] public bool AsDialog { get; set; }
    [Parameter] public int EmployeeId { get; set; }
    [Parameter] public string EmployeeName { get; set; } = "";
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string _employeeName = "";
    private IReadOnlyList<PayComponent> _components = [];
    private readonly Dictionary<int, decimal> _amounts = [];
    private decimal _basic;
    private DateTime? _from;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _employeeName = EmployeeName;
        if (string.IsNullOrEmpty(_employeeName))
        {
            // The dialog is handed the name directly; the routed page only has
            // an id, so it looks the person up from the same employee list.
            var employee = (await Wages.EmployeesAsync(includeLeavers: true))
                .FirstOrDefault(e => e.Id == EmployeeId);
            _employeeName = employee?.FullName ?? "";
        }

        _components = await Wages.ComponentsAsync();

        // Defaults to the start of next month, which is when a salary change
        // almost always takes effect.
        var next = Clock.Today.AddMonths(1);
        _from = new DateOnly(next.Year, next.Month, 1).ToDateTime(TimeOnly.MinValue);

        var current = await Wages.CurrentStructureAsync(EmployeeId, Clock.Today);
        if (current is null) return;

        _basic = current.BasicSalary;
        foreach (var line in current.Lines)
            _amounts[line.ComponentId] = line.Amount;
    }

    private decimal Amount(int componentId) => _amounts.GetValueOrDefault(componentId);

    private void SetAmount(int componentId, decimal value) => _amounts[componentId] = value;

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var result = await Wages.SaveStructureAsync(
                EmployeeId, DateOnly.FromDateTime(_from ?? Clock.Today.ToDateTime(TimeOnly.MinValue)), _basic,
                [.. _amounts.Where(a => a.Value != 0)
                            .Select(a => new StructureLineInput(a.Key, a.Value))]);

            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add("Salary saved.", Severity.Success);
            await Saved.InvokeAsync();
            if (AsDialog && _shell is not null) await _shell.CloseAsync();
        }
        finally { _busy = false; }
    }

    private DocumentShell? _shell;
    
    /// <summary>The shell has already closed itself; just react to it.</summary>
    private async Task DismissedAsync()
    {
        if (Closed.HasDelegate) { await Closed.InvokeAsync(); return; }
        Nav.NavigateTo("/finance/payroll/setup");
    }
}
