@inject IEmployeeAdvanceService Advances
@inject ICurrentUser User
@inject IClock Clock
@inject ISnackbar Snackbar

@* Wide enough for two columns, and the body scrolls rather than the dialog
   growing past the screen - a long schedule preview must not push the buttons
   out of reach. *@
<MudDialog Style="max-width:44rem">
    <TitleContent>
        <div>
            <MudText Typo="Typo.h6">Request an advance</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Money against your pay, recovered a month at a time.
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <div style="max-height:70vh; overflow-y:auto; padding-right:.5rem">
            <MudForm @ref="_form">

                @* What is already owed, before another is added to it. An
                   approver should not be the first to work this out. *@
                @if (_standing is not null)
                {
                    <MudPaper Outlined="true" Class="pa-3 mb-4">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary">
                            Where you stand
                        </MudText>

                        @if (_standing.OpenAdvances == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">
                                Nothing outstanding.
                                @if (_standing.MonthlyPay is { } clear)
                                {
                                    <span class="mud-text-secondary">Pay is @clear.ToString("N2") a month.</span>
                                }
                            </MudText>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-6 mt-1">
                                <div>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Still owed</MudText>
                                    <MudText Typo="Typo.h6">@_standing.Outstanding.ToString("N2")</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        over @_standing.OpenAdvances advance@(_standing.OpenAdvances == 1 ? "" : "s")
                                    </MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Coming off each month</MudText>
                                    <MudText Typo="Typo.h6">@_standing.CommittedMonthly.ToString("N2")</MudText>
                                    @if (_standing.CommittedShare is { } share)
                                    {
                                        <MudText Typo="Typo.caption"
                                                 Class="@(Stretched ? "mud-warning-text" : "mud-text-secondary")">
                                            @share.ToString("P0") of pay
                                        </MudText>
                                    }
                                </div>
                            </div>
                        }
                    </MudPaper>
                }

                <div class="d-flex gap-4 flex-wrap">
                    <MudNumericField T="decimal" @bind-Value="_amount" Label="Amount"
                                     Required="true" RequiredError="How much do you need?"
                                     Variant="Variant.Outlined" HideSpinButtons="true"
                                     Format="N2" Style="flex:1;min-width:12rem"
                                     Immediate="true" />

                    <MudNumericField T="int" @bind-Value="_months" Label="Repay over"
                                     Required="true" Min="1" Max="60"
                                     Variant="Variant.Outlined" Immediate="true"
                                     Adornment="Adornment.End" AdornmentText="months"
                                     Style="flex:1;min-width:12rem" />
                </div>

                <MudTextField @bind-Value="_reason" Label="Reason" Lines="2"
                              Variant="Variant.Outlined" Class="mt-4"
                              HelperText="What the money is for. An approver reads this." />

                <MudDatePicker Label="Due date (optional)" Variant="Variant.Outlined" Class="mt-4"
                               Date="_dueDate" DateChanged="@(d => _dueDate = d)" Clearable="true"
                               HelperText="Only if the whole balance is owed back by a particular date." />

                @* The monthly figure is the number most people actually decide
                   on, so it is shown while they type rather than after saving. *@
                @if (_amount > 0)
                {
                    <MudPaper Outlined="true" Class="pa-3 mt-4">
                        <div class="d-flex justify-space-between align-center">
                            <div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Monthly deduction</MudText>
                                <MudText Typo="Typo.h5">@Monthly.ToString("N2")</MudText>
                            </div>

                            @if (TotalMonthly is { } total && _standing?.MonthlyPay is { } pay && pay > 0)
                            {
                                <div class="text-right">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        Total off your pay
                                    </MudText>
                                    <MudText Typo="Typo.h6"
                                             Class="@(total / pay > 0.5m ? "mud-warning-text" : "")">
                                        @((total / pay).ToString("P0"))
                                    </MudText>
                                </div>
                            }
                        </div>

                        @if (_months > 1)
                        {
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                First deduction @FirstDue.ToString("MMMM yyyy"), last
                                @LastDue.ToString("MMMM yyyy").
                                @if (Parts.Count > 1 && Parts[^1] != Parts[0])
                                {
                                    <text>The final month is @Parts[^1].ToString("N2").</text>
                                }
                            </MudText>
                        }
                    </MudPaper>
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
                }
            </MudForm>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SubmitAsync" Disabled="@(_busy || _amount <= 0)">
            Submit for approval
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private MudForm? _form;
    private decimal _amount;
    private string? _reason;
    private int _months = 1;
    private DateTime? _dueDate;
    private string? _error;
    private bool _busy;

    private AdvanceStanding? _standing;

    private decimal Monthly => RepaymentSchedule.Monthly(_amount, _months);
    private IReadOnlyList<decimal> Parts => RepaymentSchedule.Split(_amount, _months);

    /// <summary>Deductions start the month after, never the pay run that funds it.</summary>
    private DateOnly FirstDue => new DateOnly(Clock.Today.Year, Clock.Today.Month, 1).AddMonths(1);
    private DateOnly LastDue => FirstDue.AddMonths(Math.Max(_months, 1) - 1);

    /// <summary>Everything coming off their pay each month if this is granted.</summary>
    private decimal? TotalMonthly =>
        _standing is null ? null : _standing.CommittedMonthly + Monthly;

    /// <summary>More than half their pay already committed to repayments.</summary>
    private bool Stretched =>
        _standing?.CommittedShare is { } share && share > 0.5m;

    protected override async Task OnInitializedAsync()
    {
        if (User.UserId is { } me) _standing = await Advances.StandingAsync(me);
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var saved = await Advances.SaveDraftAsync(new EmployeeAdvanceInput(
                null, _amount, _reason, _months,
                _dueDate is null ? null : DateOnly.FromDateTime(_dueDate.Value)));

            if (saved.Failed) { _error = saved.Error; return; }

            // Saved and sent in one action: the dialog has no draft state to
            // come back to, so leaving it unsubmitted would strand it.
            var sent = await Advances.SubmitAsync(saved.Value.Id);
            if (sent.Failed) { _error = sent.Error; return; }

            Snackbar.Add($"{saved.Value.Reference} sent for approval.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }
}
