@inject IEmployeeAdvanceService Advances
@inject ICurrentUser User
@inject IClock Clock
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Request Advance</MudText>
    </TitleContent>

    <DialogContent>
        @* What they already owe, before another is added to it. An approver
           should not be the first person to work this out. *@
        @if (_standing is not null)
        {
            <MudAlert Severity="@(Stretched ? Severity.Warning : Severity.Info)"
                      Variant="Variant.Outlined" Dense="true" Class="mb-4">
                @if (_standing.OpenAdvances == 0)
                {
                    <text>Nothing outstanding@(_standing.MonthlyPay is null ? "" : $" against pay of {_standing.MonthlyPay:N2}").</text>
                }
                else
                {
                    <text>
                        @_standing.Outstanding.ToString("N2") still owed on
                        @_standing.OpenAdvances advance@(_standing.OpenAdvances == 1 ? "" : "s"),
                        @_standing.CommittedMonthly.ToString("N2") a month already
                        @if (_standing.CommittedShare is { } share)
                        {
                            <text>— @share.ToString("P0") of pay</text>
                        }
                    </text>
                }
            </MudAlert>
        }

        <MudForm @ref="_form">
            <MudNumericField T="decimal" @bind-Value="_amount" Label="Amount" Required="true"
                             RequiredError="How much do you need?"
                             Variant="Variant.Text" HideSpinButtons="false" Format="N2" />

            <MudTextField @bind-Value="_reason" Label="Reason" Variant="Variant.Text"
                          Class="mt-4" />

            <MudNumericField T="int" @bind-Value="_months" Label="Repay over (months)"
                             Required="true" Min="1" Max="60"
                             Variant="Variant.Text" Class="mt-4" />

            <MudDatePicker Label="Due date (optional)" Variant="Variant.Text" Class="mt-4"
                           Date="_dueDate" DateChanged="@(d => _dueDate = d)" Clearable="true" />

            @* Shown while they type, because "how much comes off each month" is
               the only number most people actually decide on. *@
            <MudText Typo="Typo.body2" Class="mt-4">
                Monthly deduction: <b>@Monthly.ToString("N2")</b>
                @if (TotalMonthly is { } total && _standing?.MonthlyPay is { } pay && pay > 0)
                {
                    <span class="mud-text-secondary">
                        — @((total / pay).ToString("P0")) of pay once this is added
                    </span>
                }
            </MudText>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SubmitAsync" Disabled="_busy">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private MudForm? _form;
    private decimal _amount;
    private string? _reason;
    private int _months = 1;
    private DateTime? _dueDate;
    private string? _error;
    private bool _busy;

    private AdvanceStanding? _standing;

    private decimal Monthly => RepaymentSchedule.Monthly(_amount, _months);

    /// <summary>Everything coming off their pay each month if this is granted.</summary>
    private decimal? TotalMonthly =>
        _standing is null ? null : _standing.CommittedMonthly + Monthly;

    /// <summary>More than half their pay already committed to repayments.</summary>
    private bool Stretched =>
        _standing?.CommittedShare is { } share && share > 0.5m;

    protected override async Task OnInitializedAsync()
    {
        if (User.UserId is { } me) _standing = await Advances.StandingAsync(me);
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var saved = await Advances.SaveDraftAsync(new EmployeeAdvanceInput(
                null, _amount, _reason, _months,
                _dueDate is null ? null : DateOnly.FromDateTime(_dueDate.Value)));

            if (saved.Failed) { _error = saved.Error; return; }

            // Saved and sent in one action: the dialog has no draft state to
            // come back to, so leaving it unsubmitted would strand it.
            var sent = await Advances.SubmitAsync(saved.Value.Id);
            if (sent.Failed) { _error = sent.Error; return; }

            Snackbar.Add($"{saved.Value.Reference} sent for approval.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }
}
