@page "/finance/vouchers"
@attribute [Authorize(Policy = FinanceModule.VouchersView)]
@rendermode InteractiveServer
@inject IVoucherService Books
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<ListShell Title="Vouchers"
           Subtitle="Every entry in the books. A posted voucher cannot be edited — only reversed."
           Icon="@Icons.Material.Outlined.Receipt"
           Loading="_loading"
           IsEmpty="@(_rows.Count == 0)"
           EmptyIcon="@Icons.Material.Outlined.Receipt"
           EmptyTitle="No vouchers yet"
           EmptyHint="Nothing has posted to the books yet.">
    <Actions>
        <AuthorizeView Policy="@FinanceModule.VouchersPost" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    New entry
                </MudButton>
                <MudTooltip Text="Open as a full page instead">
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="/finance/vouchers/new" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </Actions>

    <EmptyAction>
        <AuthorizeView Policy="@FinanceModule.VouchersPost" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    New entry
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </EmptyAction>

    <Toolbar>
        <MudSelect T="VoucherStatus?" @bind-Value="_status" @bind-Value:after="LoadAsync"
                   Label="Status" Clearable="true" Variant="Variant.Text"
                   Margin="Margin.Dense" Class="mt-0" Style="max-width:180px">
            @foreach (var s in Enum.GetValues<VoucherStatus>())
            {
                <MudSelectItem T="VoucherStatus?" Value="@s">@s</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_search" @bind-Value:after="LoadAsync"
                      Placeholder="Search number or narration" DebounceInterval="300"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Text" Margin="Margin.Dense" Class="mt-0 ml-4" />
    </Toolbar>

    <ChildContent>
    <MudDataGrid T="Voucher" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(v => v.Number)" Title="Number" />
            <TemplateColumn Title="Date">
                <CellTemplate>@context.Item.Date.ToString("d MMM yyyy")</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(v => v.Type)" Title="Type" />
            <PropertyColumn Property="@(v => v.Narration)" Title="Narration" />
            <TemplateColumn Title="Amount" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    <span style="font-variant-numeric: tabular-nums">
                        @context.Item.TotalDebit.ToString("N2")
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.Item.Status switch {
                                 VoucherStatus.Posted => Color.Success,
                                 VoucherStatus.Reversed => Color.Warning,
                                 _ => Color.Default })">
                        @context.Item.Status
                    </MudChip>
                    @if (context.Item.SourceModule is not null)
                    {
                        <MudTooltip Text="@($"Raised automatically by {context.Item.SourceModule} ({context.Item.SourceReference})")">
                            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small"
                                     Class="ml-1 mud-text-secondary" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div class="d-flex justify-end gap-1">
                        <MudIconButton Icon="@Icons.Material.Outlined.Print" Href="@($"/print/finance/voucher/{context.Item.Id}")" Target="_blank" />
                        @if (context.Item.Status == VoucherStatus.Draft)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                           Href="@($"/finance/vouchers/{context.Item.Id}")"
                                           title="Open as a page" />
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => Edit(context.Item))">Edit</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="@(() => Post(context.Item))">Post</MudButton>
                        }
                        else if (context.Item.Status == VoucherStatus.Posted)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                       OnClick="@(() => Reverse(context.Item))">Reverse</MudButton>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    </ChildContent>
</ListShell>

@if (_editing)
{
    <VoucherEditor AsDialog="true" VoucherId="_editingId"
                   Saved="LoadAsync" Closed="@(() => { _editing = false; return Task.CompletedTask; })" />
}

@code {
    private IReadOnlyList<Voucher> _rows = [];
    private VoucherStatus? _status;
    private string? _search;
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Books.ListAsync(new VoucherFilter(Status: _status, Search: _search));
        _loading = false;
    }

    private bool _editing;
    private int? _editingId;

    private void Edit(Voucher? row)
    {
        _editingId = row?.Id;
        _editing = true;
    }

    private async Task Post(Voucher row)
    {
        var result = await Books.PostAsync(row.Id);
        if (result.Failed) Snackbar.Add(result.Error!, Severity.Error);
        else Snackbar.Add($"{row.Number} posted.", Severity.Success);
        await LoadAsync();
    }

    private async Task Reverse(Voucher row)
    {
        var parameters = new DialogParameters<ReasonPrompt>
        {
            { x => x.Prompt, "Why is this being reversed?" }
        };
        var dialog = await Dialogs.ShowAsync<ReasonPrompt>("Reverse entry", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        var answer = await dialog.Result;
        if (answer!.Canceled) return;

        var result = await Books.ReverseAsync(row.Id, (string)answer.Data!);
        if (result.Failed) Snackbar.Add(result.Error!, Severity.Error);
        else Snackbar.Add($"Reversed by {result.Value.Number}. The original is unchanged.", Severity.Success);
        await LoadAsync();
    }
}
