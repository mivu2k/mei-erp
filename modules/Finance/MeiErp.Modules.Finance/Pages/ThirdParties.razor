@page "/finance/third-parties"
@attribute [Authorize(Policy = FinanceModule.PartiesManage)]
@rendermode InteractiveServer
@inject IThirdPartyService Parties
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<ListShell Title="Third parties"
           Subtitle="A party is a name and a side. Money is recorded here and posted as a real voucher."
           Icon="@Icons.Material.Outlined.People"
           Loading="_loading"
           IsEmpty="@(_rows.Count == 0)"
           EmptyIcon="@Icons.Material.Outlined.People"
           EmptyTitle="No third parties yet"
           EmptyHint="Add whoever owes the business, or whoever the business owes.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
            New party
        </MudButton>
        <MudTooltip Text="Open as a full page instead">
            <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="/finance/third-parties/new" />
        </MudTooltip>
    </Actions>

    <EmptyAction>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
            New party
        </MudButton>
    </EmptyAction>

    <ChildContent>
    <MudDataGrid T="ThirdParty" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(p => p.Name)" Title="Name" />
            <TemplateColumn Title="Side">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.Item.Side == ThirdPartySide.Receivable ? Color.Info : Color.Secondary)">
                        @(context.Item.Side == ThirdPartySide.Receivable ? "Owes us" : "We owe")
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(p => p.Phone)" Title="Phone" />
            <TemplateColumn Title="Account">
                <CellTemplate>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.Item.Account?.Code
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Outstanding" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    @{
                        var balance = _balances.GetValueOrDefault(context.Item.Id);
                    }
                    <span style="font-variant-numeric:tabular-nums"
                          class="@(balance < 0 ? "mud-error-text" : "")">
                        @balance.ToString("N2")
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div class="d-flex justify-end gap-1">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="@(() => Pay(context.Item))">Add payment</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   Href="@($"/finance/third-parties/{context.Item.Id}")">Statement</MudButton>
                        <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                       Href="@($"/finance/third-parties/{context.Item.Id}/edit")"
                                       title="Open as a page" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       OnClick="@(() => Edit(context.Item))" />
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    </ChildContent>
</ListShell>

@if (_editing)
{
    <PartyEditor AsDialog="true" PartyId="_editingId"
                 Saved="LoadAsync" Closed="@(() => { _editing = false; return Task.CompletedTask; })" />
}

@code {
    private IReadOnlyList<ThirdParty> _rows = [];
    private Dictionary<int, decimal> _balances = [];
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Parties.ListAsync(includeInactive: false);

        _balances = [];
        foreach (var party in _rows)
            _balances[party.Id] = await Parties.BalanceAsync(party.Id);

        _loading = false;
    }

    private bool _editing;
    private int? _editingId;

    private void Edit(ThirdParty? row)
    {
        _editingId = row?.Id;
        _editing = true;
    }

    private async Task Pay(ThirdParty row)
    {
        var parameters = new DialogParameters<PartyPaymentDialog>
        {
            { x => x.PartyId, row.Id },
            { x => x.PartyName, row.Name },
            { x => x.Side, row.Side }
        };
        var dialog = await Dialogs.ShowAsync<PartyPaymentDialog>("Record payment", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        if (!(await dialog.Result)!.Canceled) await LoadAsync();
    }
}
