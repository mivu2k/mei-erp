@page "/finance/payroll/{RunId:int}"
@attribute [Authorize(Policy = FinanceModule.PayrollView)]
@rendermode InteractiveServer
@inject IPayrollService Wages

<PageTitle>Payslips</PageTitle>

@if (_run is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="d-flex align-center mb-1">
        <div>
            <MudText Typo="Typo.h5">@_run.Month.ToString("MMMM yyyy")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @_run.Payslips.Count payslips · @_run.Status
            </MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Href="/finance/payroll">Back</MudButton>
    </div>

    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Gross</MudText>
                <MudText Typo="Typo.h5">@_run.TotalGross.ToString("N2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Deductions</MudText>
                <MudText Typo="Typo.h5">@_run.TotalDeductions.ToString("N2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Net paid</MudText>
                <MudText Typo="Typo.h5">@_run.TotalNet.ToString("N2")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Elevation="0" Class="mt-4">
        <div style="overflow-x:auto">
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>Staff no.</th><th>Name</th>
                        <th style="text-align:right">Days</th>
                        <th style="text-align:right">Gross</th>
                        <th style="text-align:right">Deductions</th>
                        <th style="text-align:right">Net</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payslip in _run.Payslips.OrderBy(p => p.EmployeeName))
                    {
                        <tr>
                            <td>@payslip.EmployeeCode</td>
                            <td>@payslip.EmployeeName</td>
                            <td style="text-align:right;font-variant-numeric:tabular-nums">
                                @payslip.DaysWorked.ToString("0.#")/@payslip.DaysInMonth.ToString("0")
                            </td>
                            <td style="text-align:right;font-variant-numeric:tabular-nums">
                                @payslip.Gross.ToString("N2")
                            </td>
                            <td style="text-align:right;font-variant-numeric:tabular-nums">
                                @payslip.TotalDeductions.ToString("N2")
                            </td>
                            <td style="text-align:right;font-variant-numeric:tabular-nums">
                                <b>@payslip.Net.ToString("N2")</b>
                            </td>
                            <td style="text-align:right">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Print" Href="@($"/print/finance/payslip/{payslip.Id}")" Target="_blank" />
                                <MudIconButton Size="Size.Small"
                                               Icon="@(_expanded == payslip.Id
                                                   ? Icons.Material.Filled.ExpandLess
                                                   : Icons.Material.Filled.ExpandMore)"
                                               OnClick="@(() => Toggle(payslip.Id))" />
                            </td>
                        </tr>

                        @if (_expanded == payslip.Id)
                        {
                            <tr>
                                <td colspan="7" style="background:var(--mud-palette-background-grey)">
                                    <div class="pa-3">
                                        @foreach (var line in payslip.Lines)
                                        {
                                            <div class="d-flex justify-space-between py-1"
                                                 style="max-width:420px">
                                                <span>
                                                    @line.Name
                                                    @if (line.Kind == PayComponentKind.Deduction)
                                                    {
                                                        <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                                                 Inline="true"> (deduction)</MudText>
                                                    }
                                                </span>
                                                <span style="font-variant-numeric:tabular-nums">
                                                    @(line.Kind == PayComponentKind.Deduction ? "−" : "")@line.Amount.ToString("N2")
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </MudPaper>
}

@code {
    [Parameter] public int RunId { get; set; }

    private PayrollRun? _run;
    private int? _expanded;

    protected override async Task OnInitializedAsync() => _run = await Wages.GetRunAsync(RunId);

    private void Toggle(int payslipId) =>
        _expanded = _expanded == payslipId ? null : payslipId;
}
