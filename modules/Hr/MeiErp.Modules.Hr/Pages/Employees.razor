@page "/hr"
@page "/hr/employees"
@attribute [Authorize(Policy = HrModule.EmployeesView)]
@rendermode InteractiveServer
@inject IEmployeeService Staff
@inject ISnackbar Snackbar

<ListShell Title="Employees"
           Subtitle="Staff records. An employee is separate from a login - plenty of staff never sign in."
           Icon="@Icons.Material.Outlined.Badge"
           Loading="_loading"
           IsEmpty="@(!_loading && _rows.Count == 0)"
           EmptyIcon="@Icons.Material.Outlined.Badge"
           EmptyTitle="No employees yet"
           EmptyHint="Add a staff record to get started - a login can be linked later, or never.">
    <Actions>
        <AuthorizeView Policy="@HrModule.EmployeesManage">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => Edit(null))">
                    New employee
                </MudButton>
                <MudTooltip Text="Open as a full page instead">
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="/hr/employees/new" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </Actions>

    <EmptyAction>
        <AuthorizeView Policy="@HrModule.EmployeesManage">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => Edit(null))">
                    New employee
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </EmptyAction>

    <Toolbar>
        <MudTextField @bind-Value="_search" @bind-Value:after="LoadAsync"
                      Placeholder="Search name, staff number or designation"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      DebounceInterval="300" Variant="Variant.Text" Margin="Margin.Dense" Class="mt-0" />
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="_includeLeavers" @bind-Value:after="LoadAsync"
                   Color="Color.Primary" Label="Include leavers" />
    </Toolbar>

    <ChildContent>
    <MudDataGrid T="Employee" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(e => e.Code)" Title="Staff no." />
            <TemplateColumn Title="Name" SortBy="@(e => e.FullName)">
                <CellTemplate>
                    <MudText Typo="Typo.body2"><b>@context.Item.FullName</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.Item.Designation
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(e => e.DepartmentName)" Title="Department" />
            <TemplateColumn Title="Joined">
                <CellTemplate>@context.Item.JoinedOn.ToString("d MMM yyyy")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@StatusColour(context.Item.Status)">
                        @context.Item.Status
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Login">
                <CellTemplate>
                    @if (context.Item.UserId is null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">no account</MudText>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" Color="Color.Success" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Outlined.Print" Size="Size.Small" Href="@($"/print/hr/employee/{context.Item.Id}")" Target="_blank" />
                    <AuthorizeView Policy="@HrModule.DocumentsView" Context="documents">
                        <MudIconButton Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" Href="@($"/hr/employees/{context.Item.Id}/documents")" />
                    </AuthorizeView>
                    <AuthorizeView Policy="@HrModule.EmployeesManage" Context="perms">
                        <Authorized>
                            <div class="d-flex justify-end">
                                <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                               Href="@($"/hr/employees/{context.Item.Id}")"
                                               title="Open as a page" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                               OnClick="@(() => Edit(context.Item))" />
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    </ChildContent>
</ListShell>

@if (_editing)
{
    <EmployeeEditor AsDialog="true" EmployeeId="_editingId"
                    Saved="LoadAsync" Closed="@(() => { _editing = false; return Task.CompletedTask; })" />
}

@code {
    private IReadOnlyList<Employee> _rows = [];
    private string? _search;
    private bool _includeLeavers;
    private bool _loading = true;
    private bool _editing;
    private int? _editingId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Staff.ListAsync(_search, _includeLeavers);
        _loading = false;
    }

    private static Color StatusColour(EmploymentStatus status) => status switch
    {
        EmploymentStatus.Active => Color.Success,
        EmploymentStatus.OnLeave => Color.Info,
        EmploymentStatus.Suspended => Color.Warning,
        _ => Color.Default
    };

    private void Edit(Employee? row)
    {
        _editingId = row?.Id;
        _editing = true;
    }
}
