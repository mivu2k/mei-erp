@inject IAdminService Admin
@inject IUserDirectory Directory
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<DocumentShell @ref="_shell" AsDialog="AsDialog" Title="@Title" Error="@_error" OnClose="DismissedAsync">
    <Body>
        <MudForm @ref="_form">
            <FormSection Title="The department" Icon="@Icons.Material.Outlined.AccountTree"
                         Hint="The code is what reports print when there is no room for the full name.">
                <div class="app-form-grid">
                    <MudTextField @bind-Value="_name" Label="Name" Required="true"
                                  RequiredError="Give the department a name."
                                  Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="_code" Label="Code" Variant="Variant.Outlined"
                                  HelperText="Short form used on reports, e.g. FIN." />
                    <MudSelect T="string" @bind-Value="_parentId" Label="Sits inside"
                               Variant="Variant.Outlined" Clearable="true" Class="app-form-wide"
                               HelperText="Leave blank for a top-level division.">
                        @foreach (var d in _selectableParents)
                        {
                            <MudSelectItem T="string" Value="@d.Id">@d.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </FormSection>

            <FormSection Title="Who signs for it" Icon="@Icons.Material.Outlined.HowToReg"
                         Hint="A department with no head does not auto-approve — the request escalates instead, so it is worth filling in.">
                <div class="app-form-grid">
                    <MudSelect T="string" @bind-Value="_headUserId" Label="Head of department"
                               Variant="Variant.Outlined" Clearable="true" Class="app-form-wide">
                        @foreach (var p in _people)
                        {
                            <MudSelectItem T="string" Value="@p.Id">@p.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                @if (string.IsNullOrWhiteSpace(_headUserId))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        Without a head, anything routed to this department's head has nowhere to go.
                    </MudAlert>
                }
            </FormSection>
        </MudForm>
    </Body>

    <Buttons>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </Buttons>
</DocumentShell>

@code {
    [Parameter] public bool AsDialog { get; set; }
    [Parameter] public string? DepartmentId { get; set; }

    /// <summary>Raised after a successful save, so a list can reload behind a dialog.</summary>
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string Title => DepartmentId is null ? "New department" : "Edit department";

    private MudForm? _form;
    private string _id = "";
    private string _name = "";
    private string? _code, _headUserId, _parentId, _error;
    private bool _busy;

    private IReadOnlyList<UserSummary> _people = [];
    private IReadOnlyList<Department> _departments = [];

    /// <summary>
    /// Everything except itself and its own descendants. Allowing either would
    /// let somebody park a division inside its own section, which is a cycle
    /// the tree cannot draw and the head lookup cannot walk out of.
    /// </summary>
    private IEnumerable<Department> _selectableParents = [];

    protected override async Task OnInitializedAsync()
    {
        _people = await Directory.SearchAsync(null, take: 500);
        _departments = await Admin.DepartmentsAsync();

        var existing = DepartmentId is null
            ? null
            : _departments.FirstOrDefault(d => d.Id == DepartmentId);

        _id = existing?.Id ?? Guid.NewGuid().ToString();
        _name = existing?.Name ?? "";
        _code = existing?.Code;
        _headUserId = existing?.HeadUserId;
        _parentId = existing?.ParentId;

        var blocked = Descendants(_id);
        blocked.Add(_id);
        _selectableParents = _departments.Where(d => !blocked.Contains(d.Id)).OrderBy(d => d.Name);
    }

    private HashSet<string> Descendants(string id)
    {
        var found = new HashSet<string>();
        var queue = new Queue<string>([id]);

        while (queue.Count > 0)
        {
            var current = queue.Dequeue();
            foreach (var child in _departments.Where(d => d.ParentId == current))
                if (found.Add(child.Id)) queue.Enqueue(child.Id);
        }

        return found;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var result = await Admin.SaveDepartmentAsync(new Department
            {
                Id = _id,
                Name = _name.Trim(),
                Code = _code,
                HeadUserId = string.IsNullOrWhiteSpace(_headUserId) ? null : _headUserId,
                ParentId = string.IsNullOrWhiteSpace(_parentId) ? null : _parentId,
                IsActive = true
            });

            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add("Saved.", Severity.Success);
            DepartmentId = _id;
            await Saved.InvokeAsync();
            if (AsDialog && _shell is not null) await _shell.CloseAsync();
        }
        finally { _busy = false; }
    }

    private DocumentShell? _shell;
    
    /// <summary>The shell has already closed itself; just react to it.</summary>
    private async Task DismissedAsync()
    {
        if (Closed.HasDelegate) { await Closed.InvokeAsync(); return; }
        Nav.NavigateTo("/hr/departments");
    }
}
