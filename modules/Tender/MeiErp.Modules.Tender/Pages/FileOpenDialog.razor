@inject IFileRegistryService Files
@inject ISnackbar Snackbar
<MudDialog><DialogContent><MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Open the physical file for a tender or project that does not have one yet.</MudText><MudSelect T="FileOwnerOption" @bind-Value="_owner" Label="Tender or project" Variant="Variant.Outlined" FullWidth="true">@foreach(var owner in _owners){<MudSelectItem T="FileOwnerOption" Value="@owner">@owner.Type · @owner.Reference — @owner.Title</MudSelectItem>}</MudSelect>@if(_owners.Count==0){<MudAlert Severity="Severity.Info" Class="mt-3">Every tender and project already has a registered file.</MudAlert>}@if(_error is not null){<MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>}</DialogContent><DialogActions><MudButton OnClick="@(()=>Dialog.Cancel())">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_owner is null||_busy)" OnClick="Open">Open file</MudButton></DialogActions></MudDialog>
@code{[CascadingParameter]private IMudDialogInstance Dialog{get;set;}=default!;private IReadOnlyList<FileOwnerOption> _owners=[];private FileOwnerOption? _owner;private string? _error;private bool _busy;protected override async Task OnInitializedAsync()=>_owners=await Files.AvailableOwnersAsync();private async Task Open(){if(_owner is null)return;_busy=true;var result=await Files.EnsureAsync(_owner.Type,_owner.Id);_busy=false;if(result.Failed){_error=result.Error;return;}Snackbar.Add("Physical file opened.",Severity.Success);Dialog.Close(DialogResult.Ok(result.Value.Id));}}
