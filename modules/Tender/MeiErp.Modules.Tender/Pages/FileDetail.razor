@page "/tender/files/{Id:int}"
@attribute [Authorize(Policy=TenderModule.FilesView)]
@rendermode InteractiveServer
@inject IFileRegistryService Files
@inject ISnackbar Snackbar
<PageTitle>File @_row?.FileNumber</PageTitle>
@if(_row is null){<MudProgressCircular Indeterminate/>}else{<div class="d-flex align-center"><div><MudText Typo="Typo.h5">@_row.FileNumber</MudText><MudText>@_row.OwnerReference — @_row.OwnerTitle</MudText></div><MudSpacer/><MudButton Href="@($"/print/tender/file-sticker/{Id}")" Target="_blank">Sticker</MudButton><MudButton Href="@($"/print/tender/file-movements/{Id}")" Target="_blank">Movement register</MudButton></div><MudGrid Class="mt-4"><MudItem xs="12" md="4"><MudPaper Class="pa-4"><MudText><b>Status:</b> @_row.Status</MudText><MudText><b>Holder:</b> @(_row.HolderName??"—")</MudText><MudText><b>Location:</b> @(_row.Location??"—")</MudText><MudText><b>Volume:</b> @(_row.VolumeNumber??"—")</MudText></MudPaper><AuthorizeView Policy="@TenderModule.FilesManage"><Authorized><MudPaper Class="pa-4 mt-3"><MudSelect T="FileMovementAction" @bind-Value="_action" Label="Movement">@foreach(var a in Actions()){<MudSelectItem Value="@a">@a</MudSelectItem>}</MudSelect>@if(_action is FileMovementAction.Issued or FileMovementAction.Transferred){<MudTextField @bind-Value="_holder" Label="New holder"/><MudTextField @bind-Value="_purpose" Label="Purpose"/><MudDatePicker @bind-Date="_due" Label="Due back"/>}@if(_action is FileMovementAction.Returned or FileMovementAction.Archived or FileMovementAction.Found){<MudTextField @bind-Value="_location" Label="Location"/>}<MudTextField @bind-Value="_remarks" Label="Remarks"/><MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="Move">Record movement</MudButton></MudPaper></Authorized></AuthorizeView></MudItem><MudItem xs="12" md="8"><MudPaper Class="pa-4"><MudText Typo="Typo.h6">Movement history</MudText><MudTable Items="_row.Movements" Dense><HeaderContent><MudTh>Date</MudTh><MudTh>Action</MudTh><MudTh>From</MudTh><MudTh>To</MudTh><MudTh>Due</MudTh><MudTh>Recorded by</MudTh></HeaderContent><RowTemplate><MudTd>@context.MovedOn.ToString("d MMM yyyy")</MudTd><MudTd>@context.Action</MudTd><MudTd>@(context.FromHolderName??context.FromLocation??"—")</MudTd><MudTd>@(context.ToHolderName??context.ToLocation??"—")</MudTd><MudTd>@context.DueBack?.ToString("d MMM yyyy")</MudTd><MudTd>@context.RecordedByName</MudTd></RowTemplate></MudTable></MudPaper></MudItem></MudGrid>}
@code{[Parameter]public int Id{get;set;}PhysicalFile? _row;FileMovementAction _action=FileMovementAction.Issued;string? _holder,_purpose,_location,_remarks;DateTime? _due;protected override Task OnParametersSetAsync()=>Load();async Task Load(){_row=await Files.GetAsync(Id);
    // The action list depends on the file's status, so a value carried over
    // from before - or the Issued default on an archived file - leaves the
    // select blank and submits something the status does not allow.
    var allowed=Actions().ToList();if(allowed.Count>0&&!allowed.Contains(_action))_action=allowed[0];}IEnumerable<FileMovementAction> Actions(){if(_row is null)return[];return _row.Status switch{PhysicalFileStatus.Issued=>[FileMovementAction.Returned,FileMovementAction.Transferred,FileMovementAction.MarkedLost],PhysicalFileStatus.Archived=>[FileMovementAction.Reopened,FileMovementAction.MarkedLost],PhysicalFileStatus.Lost=>[FileMovementAction.Found],_=>[FileMovementAction.Issued,FileMovementAction.Archived,FileMovementAction.MarkedLost]};}async Task Move(){var result=await Files.MoveAsync(Id,_action,new(HolderName:_holder,Location:_location,Purpose:_purpose,DueBack:_due is null?null:DateOnly.FromDateTime(_due.Value),Remarks:_remarks));if(result.Failed){Snackbar.Add(result.Error!,Severity.Error);return;}Snackbar.Add("Movement recorded.",Severity.Success);_holder=_purpose=_remarks=null;await Load();}}
