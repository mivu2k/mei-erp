@inject ITenderService Work
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<DocumentShell @ref="_shell" AsDialog="AsDialog" Title="@Title" Error="@_error" OnClose="DismissedAsync">
    <Body>
        <MudForm @ref="_form">
            <div class="d-flex gap-3 mb-4">
                <MudTextField @bind-Value="_model.Code" Label="Code" Variant="Variant.Outlined"
                              HelperText="Left blank, one is generated." />
                <MudSelect T="ProjectStatus" @bind-Value="_model.Status" Label="Status"
                           Variant="Variant.Outlined">
                    @foreach (var s in Enum.GetValues<ProjectStatus>())
                    {
                        <MudSelectItem Value="@s">@s</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudTextField @bind-Value="_model.Name" Label="Name" Required="true"
                          RequiredError="Give it a name." Variant="Variant.Outlined" Class="mb-4" />

            <MudTextField @bind-Value="_model.ClientName" Label="Client"
                          Variant="Variant.Outlined" Class="mb-4" />

            <div class="d-flex gap-3 mb-4">
                <MudDatePicker Label="Starts" Variant="Variant.Outlined"
                               Date="_start" DateChanged="@(d => _start = d)" />
                <MudDatePicker Label="Target end" Variant="Variant.Outlined"
                               Date="_end" DateChanged="@(d => _end = d)" />
            </div>

            <MudNumericField T="decimal?" @bind-Value="_model.ContractValue" Label="Contract value"
                             Variant="Variant.Outlined" HideSpinButtons="true" />
        </MudForm>
    </Body>

    <Buttons>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </Buttons>
</DocumentShell>

@code {
    [Parameter] public bool AsDialog { get; set; }
    [Parameter] public int? ProjectId { get; set; }

    /// <summary>Raised after a successful save, so a list can reload behind a dialog.</summary>
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string Title => ProjectId is null ? "New project" : "Edit project";

    private MudForm? _form;
    private Project _model = new();
    private DateTime? _start, _end;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _model = ProjectId is null
            ? new Project { Status = ProjectStatus.Planned }
            : await Work.GetProjectAsync(ProjectId.Value) ?? new Project();

        _start = _model.StartDate?.ToDateTime(TimeOnly.MinValue);
        _end = _model.TargetEndDate?.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            _model.StartDate = _start is null ? null : DateOnly.FromDateTime(_start.Value);
            _model.TargetEndDate = _end is null ? null : DateOnly.FromDateTime(_end.Value);

            var result = await Work.SaveProjectAsync(_model);
            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add("Saved.", Severity.Success);
            ProjectId = _model.Id;
            await Saved.InvokeAsync();
            if (AsDialog && _shell is not null) await _shell.CloseAsync();
        }
        finally { _busy = false; }
    }

    private DocumentShell? _shell;
    
    /// <summary>The shell has already closed itself; just react to it.</summary>
    private async Task DismissedAsync()
    {
        if (Closed.HasDelegate) { await Closed.InvokeAsync(); return; }
        Nav.NavigateTo("/tender/projects");
    }
}
