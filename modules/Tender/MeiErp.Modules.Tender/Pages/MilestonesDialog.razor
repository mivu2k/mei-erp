@inject IProjectMilestoneService Milestones
@inject IClock Clock
@inject ISnackbar Snackbar
<MudDialog><DialogContent><MudText Typo="Typo.h6">@ProjectName milestones</MudText>@if(_editing){<MudPaper Class="pa-3 my-3"><MudTextField @bind-Value="_model.Name" Label="Milestone" Required/><div class="d-flex gap-3"><MudDatePicker @bind-Date="_due" Label="Due date"/><MudSelect T="MilestoneStatus" @bind-Value="_model.Status" Label="Status">@foreach(var s in Enum.GetValues<MilestoneStatus>()){<MudSelectItem Value="@s">@s</MudSelectItem>}</MudSelect></div><MudNumericField T="decimal?" @bind-Value="_model.PaymentAmount" Label="Payment amount"/><MudTextField @bind-Value="_model.Notes" Label="Notes"/><MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Save</MudButton><MudButton OnClick="@(()=>_editing=false)">Cancel</MudButton></MudPaper>}else{<MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(()=>Edit(null))" Class="my-3">Add milestone</MudButton>}<MudTable Items="_rows" Dense><HeaderContent><MudTh>Milestone</MudTh><MudTh>Due</MudTh><MudTh>Status</MudTh><MudTh>Payment</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@context.DueDate.ToString("d MMM yyyy") @if(context.IsOverdueOn(Clock.Today)){<MudChip T="string" Color="Color.Error" Size="Size.Small">Overdue</MudChip>}</MudTd><MudTd>@context.Status</MudTd><MudTd>@context.PaymentAmount?.ToString("N2")</MudTd><MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(()=>Edit(context))"/><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(()=>Delete(context.Id))"/></MudTd></RowTemplate></MudTable></DialogContent><DialogActions><MudButton OnClick="@(()=>Dialog.Close())">Close</MudButton></DialogActions></MudDialog>
@code{[CascadingParameter]IMudDialogInstance Dialog{get;set;}=default!;[Parameter]public int ProjectId{get;set;}[Parameter]public string ProjectName{get;set;}="";IReadOnlyList<ProjectMilestone> _rows=[];ProjectMilestone _model=new();bool _editing;DateTime? _due;protected override Task OnInitializedAsync()=>Load();async Task Load()=>_rows=await Milestones.ListAsync(ProjectId);void Edit(ProjectMilestone? x){_model=x is null?new(){ProjectId=ProjectId,DueDate=Clock.Today}:new(){Id=x.Id,ProjectId=x.ProjectId,Name=x.Name,Description=x.Description,DueDate=x.DueDate,AchievedDate=x.AchievedDate,Status=x.Status,PaymentAmount=x.PaymentAmount,SortOrder=x.SortOrder,Notes=x.Notes};_due=_model.DueDate.ToDateTime(TimeOnly.MinValue);_editing=true;}async Task Save(){if(_due is not null)_model.DueDate=DateOnly.FromDateTime(_due.Value);var r=await Milestones.SaveAsync(_model);if(r.Failed){Snackbar.Add(r.Error!,Severity.Error);return;}_editing=false;await Load();}async Task Delete(int id){var r=await Milestones.DeleteAsync(id);if(r.Failed)Snackbar.Add(r.Error!,Severity.Error);else await Load();}}
