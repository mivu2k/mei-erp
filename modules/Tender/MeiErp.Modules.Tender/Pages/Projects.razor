@page "/tender/projects"
@attribute [Authorize(Policy = TenderModule.ProjectsView)]
@rendermode InteractiveServer
@inject ITenderService Work
@inject IClock Clock
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IFileRegistryService Files
@inject NavigationManager Nav

<ListShell Title="Projects"
           Subtitle="Progress is averaged from the tasks, never typed in."
           Icon="@Icons.Material.Outlined.Assignment"
           Loading="_loading"
           IsEmpty="@(_rows.Count == 0)"
           EmptyIcon="@Icons.Material.Outlined.Assignment"
           EmptyTitle="No projects yet"
           EmptyHint="A project turns tasks into a progress figure nobody has to type in by hand.">
    <Actions>
        <AuthorizeView Policy="@TenderModule.ProjectsManage" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    New project
                </MudButton>
                <MudTooltip Text="Open as a full page instead">
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="/tender/projects/new" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </Actions>

    <EmptyAction>
        <AuthorizeView Policy="@TenderModule.ProjectsManage" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    New project
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </EmptyAction>

    <ChildContent>
    @if (_overdue.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="ma-3">
            <b>@_overdue.Count</b> @(_overdue.Count == 1 ? "task is" : "tasks are") past their due date
            on projects still running.
        </MudAlert>
    }

    <MudDataGrid T="Project" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(p => p.Code)" Title="Code" />
            <TemplateColumn Title="Project">
                <CellTemplate>
                    <MudText Typo="Typo.body2"><b>@context.Item.Name</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Item.ClientName</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Progress" Style="width:180px">
                <CellTemplate>
                    <div class="d-flex align-center gap-2">
                        <MudProgressLinear Color="Color.Primary" Rounded="true" Size="Size.Small"
                                           Value="@context.Item.ProgressPercent" Class="flex-grow-1" />
                        <MudText Typo="Typo.caption" Style="font-variant-numeric:tabular-nums">
                            @context.Item.ProgressPercent%
                        </MudText>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.Item.Tasks.Count(t => t.Status == ProjectTaskStatus.Completed)
                        of @context.Item.Tasks.Count(t => t.Status != ProjectTaskStatus.Cancelled) tasks
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Due">
                <CellTemplate>@context.Item.TargetEndDate?.ToString("d MMM yyyy")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.Item.Status switch {
                                 ProjectStatus.Completed => Color.Success,
                                 ProjectStatus.Active => Color.Info,
                                 ProjectStatus.OnHold => Color.Warning,
                                 ProjectStatus.Cancelled => Color.Error,
                                 _ => Color.Default })">
                        @context.Item.Status
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div class="d-flex justify-end gap-1">
                        <AuthorizeView Policy="@TenderModule.FilesView" Context="filePerms"><Authorized><MudIconButton Icon="@Icons.Material.Filled.Folder" Size="Size.Small" OnClick="@(()=>OpenFile(context.Item))" /></Authorized></AuthorizeView>
                        <AuthorizeView Policy="@TenderModule.MilestonesManage" Context="milestonePerms"><Authorized><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(()=>OpenMilestones(context.Item))">Milestones</MudButton></Authorized></AuthorizeView>
                        <AuthorizeView Policy="@TenderModule.TasksManage" Context="perms">
                            <Authorized>
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           OnClick="@(() => Board(context.Item))">Tasks</MudButton>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="@TenderModule.ProjectsManage" Context="perms">
                            <Authorized>
                                <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                               Href="@($"/tender/projects/{context.Item.Id}")"
                                               title="Open as a page" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                               OnClick="@(() => Edit(context.Item))" />
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    </ChildContent>
</ListShell>

@if (_editing)
{
    <ProjectEditor AsDialog="true" ProjectId="_editingId"
                   Saved="LoadAsync" Closed="@(() => { _editing = false; return Task.CompletedTask; })" />
}

@code {
    private IReadOnlyList<Project> _rows = [];
    private IReadOnlyList<ProjectTask> _overdue = [];
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Work.ListProjectsAsync(null);
        _overdue = await Work.OverdueTasksAsync();
        _loading = false;
    }

    private bool _editing;
    private int? _editingId;

    private void Edit(Project? row)
    {
        _editingId = row?.Id;
        _editing = true;
    }

    private async Task Board(Project row)
    {
        var parameters = new DialogParameters<TaskBoard>
        {
            { x => x.ProjectId, row.Id },
            { x => x.ProjectName, row.Name }
        };
        var dialog = await Dialogs.ShowAsync<TaskBoard>("Tasks", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        if (!(await dialog.Result)!.Canceled) await LoadAsync();
    }
    private async Task OpenFile(Project row){var result=await Files.EnsureAsync(FileOwnerType.Project,row.Id);if(result.Failed){Snackbar.Add(result.Error!,Severity.Error);return;}Nav.NavigateTo($"/tender/files/{result.Value!.Id}");}
    private async Task OpenMilestones(Project row){var parameters=new DialogParameters<MilestonesDialog>{{x=>x.ProjectId,row.Id},{x=>x.ProjectName,row.Name}};await Dialogs.ShowAsync<MilestonesDialog>("Milestones",parameters,new DialogOptions{MaxWidth=MaxWidth.Medium,FullWidth=true});await LoadAsync();}
}
