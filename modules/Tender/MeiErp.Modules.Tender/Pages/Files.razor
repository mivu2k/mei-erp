@page "/tender/files"
@attribute [Authorize(Policy=TenderModule.FilesView)]
@rendermode InteractiveServer
@inject IFileRegistryService Registry
<PageTitle>Physical file registry</PageTitle>
<div class="d-flex align-center"><div><MudText Typo="Typo.h5">Physical file registry</MudText><MudText Typo="Typo.body2" Class="mud-text-secondary">One traceable folder per tender or project.</MudText></div><MudSpacer/><MudButton Href="/tender/files/scan" StartIcon="@Icons.Material.Filled.QrCodeScanner">Find / scan</MudButton></div>
<div class="d-flex gap-3 mt-4"><MudTextField @bind-Value="_search" Label="Search number, owner, holder or location" Immediate Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"/><MudSelect T="PhysicalFileStatus?" @bind-Value="_status" Label="Status" Clearable><MudSelectItem T="PhysicalFileStatus?" Value="@((PhysicalFileStatus?)null)">All</MudSelectItem>@foreach(var s in Enum.GetValues<PhysicalFileStatus>()){<MudSelectItem T="PhysicalFileStatus?" Value="@((PhysicalFileStatus?)s)">@s</MudSelectItem>}</MudSelect><MudCheckBox @bind-Value="_overdue" Label="Overdue only"/><MudButton OnClick="Load">Apply</MudButton></div>
<MudTable Items="_rows" Dense Hover Class="mt-4"><HeaderContent><MudTh>File</MudTh><MudTh>Owner</MudTh><MudTh>Status</MudTh><MudTh>Holder / location</MudTh><MudTh>Opened</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd><b>@context.FileNumber</b></MudTd><MudTd>@context.OwnerReference<br/><small>@context.OwnerTitle</small></MudTd><MudTd><MudChip T="string" Size="Size.Small">@context.Status</MudChip></MudTd><MudTd>@(context.HolderName??context.Location??"—")</MudTd><MudTd>@context.OpenedOn.ToString("d MMM yyyy")</MudTd><MudTd><MudButton Size="Size.Small" Href="@($"/tender/files/{context.Id}")">Open</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-6">No files match this filter. Open a tender or project file from its record first.</MudText></NoRecordsContent></MudTable>
@code{IReadOnlyList<PhysicalFile> _rows=[];string? _search;PhysicalFileStatus? _status;bool _overdue;protected override Task OnInitializedAsync()=>Load();async Task Load()=>_rows=await Registry.ListAsync(new(_search,_status,null,_overdue));}
