@inject IPurchasingService Purchasing
@inject ISalesService Sales
@inject ITradeStockPort Stock
@inject IPartyService PartyMaster
@inject IClock Clock
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<DocumentShell @ref="_shell" AsDialog="AsDialog" Title="@Title" Error="@_error" OnClose="DismissedAsync">
    <Body>
        <div class="d-flex gap-3 mb-4">
            <MudSelect T="int" @bind-Value="_partyId"
                       Label="@(IsPurchase ? "Supplier" : "Customer")"
                       Variant="Variant.Outlined" Style="min-width:260px">
                @foreach (var p in _parties)
                {
                    <MudSelectItem T="int" Value="@p.Id">@p.Name</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker Label="Date" Variant="Variant.Outlined"
                           Date="_date" DateChanged="@(d => _date = d)" />

            @* An order deals in one stock book. Changing it reloads the item
               list, because a line from the other book could never be received
               onto a shelf this order is entitled to touch. *@
            @if (_books.Count > 1)
            {
                <MudSelect T="int" Value="_bookId" ValueChanged="ChooseBookAsync"
                           Label="Stock book" Variant="Variant.Outlined"
                           Style="min-width:200px">
                    @foreach (var b in _books)
                    {
                        <MudSelectItem T="int" Value="@b.Id">@b.Name</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>

        <MudTable T="LineRow" Items="_lines" Dense="true" Elevation="0" Bordered="true">
            <HeaderContent>
                <MudTh>Item</MudTh>
                <MudTh Style="width:120px">Quantity</MudTh>
                <MudTh Style="width:140px">@(IsPurchase ? "Unit cost" : "Unit price")</MudTh>
                <MudTh Style="width:120px">Total</MudTh>
                <MudTh Style="width:48px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudSelect T="int" @bind-Value="context.ItemId" @bind-Value:after="OnItemChanged"
                               Variant="Variant.Text" Margin="Margin.Dense" Dense="true">
                        @foreach (var i in _items)
                        {
                            <MudSelectItem T="int" Value="@i.Id">@i.Code — @i.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudNumericField T="decimal" @bind-Value="context.Quantity"
                                     @bind-Value:after="Recalculate"
                                     Variant="Variant.Text" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudTd>
                <MudTd>
                    <MudNumericField T="decimal" @bind-Value="context.Price"
                                     @bind-Value:after="Recalculate"
                                     Variant="Variant.Text" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudTd>
                <MudTd Style="text-align:right;font-variant-numeric:tabular-nums">
                    @((context.Quantity * context.Price).ToString("N2"))
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                   OnClick="@(() => Remove(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="d-flex align-center mt-2">
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddLine">Add line</MudButton>
            <MudSpacer />
            <MudText Typo="Typo.h6">@_total.ToString("N2")</MudText>
        </div>

        @if (!IsPurchase && _shortLines.Count > 0)
        {
            @* Warned, not blocked. Confirming reserves nothing, so a short line
               is a backorder rather than an error - but the person taking the
               order should know before they promise a date. *@
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                Not enough stock for @string.Join(", ", _shortLines).
                The order can still be taken; it becomes a backorder.
            </MudAlert>
        }

        <MudTextField @bind-Value="_notes" Label="Notes" Lines="2"
                      Variant="Variant.Outlined" Class="mt-4" />
    </Body>

    <Buttons>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </Buttons>
</DocumentShell>

@code {
    [Parameter] public bool AsDialog { get; set; }
    [Parameter] public int? OrderId { get; set; }
    [Parameter] public bool IsPurchase { get; set; }

    /// <summary>Raised after a successful save, so a list can reload behind a dialog.</summary>
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private sealed class LineRow
    {
        public int ItemId { get; set; }
        public decimal Quantity { get; set; }
        public decimal Price { get; set; }
    }

    private int _partyId;
    private DateTime? _date;
    private string? _notes;
    private List<LineRow> _lines = [];
    private IReadOnlyList<TradeItem> _items = [];
    private IReadOnlyList<StockBook> _books = [];
    private int _bookId;
    private IReadOnlyList<Party> _parties = [];
    private List<string> _shortLines = [];
    private decimal _total;
    private string? _error;
    private bool _busy;

    private string Title => OrderId is null
        ? (IsPurchase ? "New purchase order" : "New sales order")
        : (IsPurchase ? "Edit purchase order" : "Edit sales order");

    protected override async Task OnInitializedAsync()
    {
        // The book has to be settled before the items, because an order buys
        // into - or sells out of - exactly one of them.
        _books = await Stock.BooksAsync();
        _bookId = (await Stock.DefaultBookAsync())?.Id ?? 0;
        _items = await Stock.ItemsAsync(_bookId);
        _parties = await PartyMaster.ListAsync(
            customers: IsPurchase ? null : true,
            suppliers: IsPurchase ? true : null);

        _date = Clock.Today.ToDateTime(TimeOnly.MinValue);

        if (OrderId is not null)
        {
            if (IsPurchase)
            {
                var order = await Purchasing.GetOrderAsync(OrderId.Value);
                if (order is not null)
                {
                    _partyId = order.PartyId;
                    _date = order.Date.ToDateTime(TimeOnly.MinValue);
                    _notes = order.Notes;
                    _lines = [.. order.Lines.Select(l => new LineRow
                    {
                        ItemId = l.ItemId, Quantity = l.Quantity, Price = l.UnitCost
                    })];
                }
            }
            else
            {
                var order = await Sales.GetOrderAsync(OrderId.Value);
                if (order is not null)
                {
                    _partyId = order.PartyId;
                    _date = order.Date.ToDateTime(TimeOnly.MinValue);
                    _notes = order.Notes;
                    _lines = [.. order.Lines.Select(l => new LineRow
                    {
                        ItemId = l.ItemId, Quantity = l.Quantity, Price = l.UnitPrice
                    })];
                }
            }
        }

        if (_lines.Count == 0) _lines.Add(new LineRow());
        if (_partyId == 0 && _parties.Count > 0) _partyId = _parties[0].Id;

        Recalculate();
    }

    /// <summary>
    /// Switching book replaces the item list, so any line already chosen from
    /// the old one is cleared rather than left pointing somewhere this order
    /// cannot buy from.
    /// </summary>
    private async Task ChooseBookAsync(int bookId)
    {
        if (bookId == _bookId) return;

        _bookId = bookId;
        _items = await Stock.ItemsAsync(_bookId);
        _lines = [new LineRow()];
        Recalculate();
    }

    private void AddLine() => _lines.Add(new LineRow());

    private void Remove(LineRow row)
    {
        _lines.Remove(row);
        if (_lines.Count == 0) _lines.Add(new LineRow());
        Recalculate();
    }

    /// <summary>Defaults the price from the item, so the common case needs no typing.</summary>
    private void OnItemChanged()
    {
        foreach (var line in _lines.Where(l => l.ItemId != 0 && l.Price == 0))
        {
            var item = _items.FirstOrDefault(i => i.Id == line.ItemId);
            if (item is null) continue;
            line.Price = IsPurchase ? item.AverageCost : item.SellingPrice;
        }

        Recalculate();
    }

    private void Recalculate()
    {
        _total = _lines.Sum(l => l.Quantity * l.Price);

        _shortLines = IsPurchase
            ? []
            : [.. _lines.Where(l => l.ItemId != 0 && l.Quantity > 0)
                        .Select(l => new { Line = l, Item = _items.FirstOrDefault(i => i.Id == l.ItemId) })
                        .Where(x => x.Item is not null && x.Item.QuantityOnHand < x.Line.Quantity)
                        .Select(x => x.Item!.Name)];
    }

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var date = DateOnly.FromDateTime(_date ?? Clock.Today.ToDateTime(TimeOnly.MinValue));
            var lines = _lines.Where(l => l.ItemId != 0 && l.Quantity > 0).ToList();

            if (IsPurchase)
            {
                var result = await Purchasing.SaveOrderAsync(new PurchaseOrderInput(
                    OrderId, _partyId, _bookId, date, _notes,
                    [.. lines.Select(l => new PurchaseOrderLineInput(l.ItemId, l.Quantity, l.Price))]));

                if (result.Failed) { _error = result.Error; return; }
            }
            else
            {
                var result = await Sales.SaveOrderAsync(new SalesOrderInput(
                    OrderId, _partyId, _bookId, date, _notes,
                    [.. lines.Select(l => new SalesOrderLineInput(l.ItemId, l.Quantity, l.Price))]));

                if (result.Failed) { _error = result.Error; return; }
            }

            Snackbar.Add("Saved.", Severity.Success);
            await Saved.InvokeAsync();
            if (AsDialog && _shell is not null) await _shell.CloseAsync();
        }
        finally { _busy = false; }
    }

    private DocumentShell? _shell;
    
    /// <summary>The shell has already closed itself; just react to it.</summary>
    private async Task DismissedAsync()
    {
        if (Closed.HasDelegate) { await Closed.InvokeAsync(); return; }
        Nav.NavigateTo(IsPurchase ? "/purchase/orders" : "/sales/orders");
    }
}
