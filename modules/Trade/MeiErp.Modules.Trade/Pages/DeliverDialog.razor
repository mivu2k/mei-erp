@inject ISalesService Sales
@inject ITradeStockPort Stock
@inject IClock Clock
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_order is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                Delivering against <b>@_order.Number</b> to @_order.PartyName.
            </MudText>

            <div class="d-flex gap-3 mb-4">
                <MudDatePicker Label="Delivered on" Variant="Variant.Outlined"
                               Date="_date" DateChanged="@(d => _date = d)" />
                <MudTextField @bind-Value="_collectedBy" Label="Collected by"
                              Variant="Variant.Outlined"
                              HelperText="The delivery note is signed against this name." />
            </div>

            <MudTable T="DeliverRow" Items="_rows" Dense="true" Elevation="0" Bordered="true">
                <HeaderContent>
                    <MudTh>Item</MudTh>
                    <MudTh Style="width:100px">In stock</MudTh>
                    <MudTh Style="width:110px">Outstanding</MudTh>
                    <MudTh Style="width:120px">Delivering</MudTh>
                    <MudTh>Serial numbers</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ItemName</MudTd>
                    <MudTd style="text-align:right">
                        @if (context.InStock < context.Delivering)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error">
                                @context.InStock.ToString("0.##")
                            </MudText>
                        }
                        else
                        {
                            @context.InStock.ToString("0.##")
                        }
                    </MudTd>
                    <MudTd><MudTextField @bind-Value="context.Serials" Placeholder="Comma/new line separated" Lines="2" Margin="Margin.Dense" /></MudTd>
                    <MudTd style="text-align:right">@context.Outstanding.ToString("0.##")</MudTd>
                    <MudTd>
                        <MudNumericField T="decimal" @bind-Value="context.Delivering"
                                         Variant="Variant.Text" Margin="Margin.Dense"
                                         HideSpinButtons="true" Min="0" Max="context.Outstanding" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   OnClick="SaveAsync" Disabled="_busy">Issue out of stock</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int OrderId { get; set; }

    private sealed class DeliverRow
    {
        public int ItemId { get; set; }
        public string ItemName { get; set; } = "";
        public decimal Outstanding { get; set; }
        public decimal InStock { get; set; }
        public decimal Delivering { get; set; }
        public string? Serials { get; set; }
    }

    private SalesOrder? _order;
    private List<DeliverRow> _rows = [];
    private DateTime? _date;
    private string? _collectedBy;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _order = await Sales.GetOrderAsync(OrderId);
        _date = Clock.Today.ToDateTime(TimeOnly.MinValue);
        if (_order is null) return;

        // Read from the order's own book: an order only ever holds lines from one.
        var items = await Stock.ItemsAsync(_order.DomainId);

        _rows = [.. _order.Lines
            .Where(l => l.Outstanding > 0)
            .Select(l =>
            {
                var stock = items.FirstOrDefault(i => i.Id == l.ItemId)?.QuantityOnHand ?? 0;
                return new DeliverRow
                {
                    ItemId = l.ItemId,
                    ItemName = l.ItemName,
                    Outstanding = l.Outstanding,
                    InStock = stock,

                    // Defaults to whatever can actually go out, so the common
                    // case of a short delivery needs no arithmetic.
                    Delivering = Math.Min(l.Outstanding, stock)
                };
            })];
    }

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var lines = _rows.Where(r => r.Delivering > 0).ToList();
            if (lines.Count == 0)
            {
                _error = "Nothing has been entered as delivered.";
                return;
            }

            var result = await Sales.DeliverAsync(new DeliveryInput(
                OrderId, DateOnly.FromDateTime(_date ?? Clock.Today.ToDateTime(TimeOnly.MinValue)), _collectedBy, null,
                [.. lines.Select(r => new DeliveryLineInput(r.ItemId, r.Delivering,
                    (r.Serials ?? "").Split([',', '\n', '\r'],
                        StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)))]));

            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add($"{result.Value.Number} issued.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }
}
