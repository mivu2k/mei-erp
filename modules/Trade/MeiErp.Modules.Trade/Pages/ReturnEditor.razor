@inject ITradeStockPort Stock
@inject IPartyService PartyMaster
@inject IClock Clock
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@*
    Recording goods coming back, either direction.

    Same arrangement as the other documents: a dialog when opened from the list,
    a page when opened from a URL, one editor either way.

    A return has no draft state - it either happened or it did not, and the
    stock moves the moment it is recorded. So this posts rather than saving.
*@

<DocumentShell @ref="_shell" AsDialog="AsDialog"
               Title="@Title"
               Subtitle="@Subtitle"
               Error="@_error"
               OnClose="DismissedAsync">
    <Body>
        <div class="d-flex flex-wrap gap-3 mb-4">
            <MudSelect T="int" @bind-Value="_partyId"
                       Label="@(SupplierReturns ? "Supplier" : "Customer")"
                       Variant="Variant.Outlined" Style="min-width:260px">
                @foreach (var p in _parties)
                {
                    <MudSelectItem T="int" Value="@p.Id">@p.Name</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker Label="Date" Variant="Variant.Outlined"
                           Date="_date" DateChanged="@(d => _date = d)" Style="min-width:170px" />

            <MudTextField @bind-Value="_source" Variant="Variant.Outlined"
                          Label="@(SupplierReturns ? "Against receipt" : "Against delivery")"
                          HelperText="The paperwork the goods went out or came in on."
                          Style="min-width:220px" />
        </div>

        @* Required, not optional: a return with no reason is unauditable, and
           the stock service refuses it anyway. *@
        <MudTextField @bind-Value="_reason" Label="Reason" Required="true"
                      Variant="Variant.Outlined" Class="mb-4"
                      HelperText="Why the goods came back. Kept on the record." />

        <MudTable T="Row" Items="_lines" Dense="true" Elevation="0" Bordered="true">
            <HeaderContent>
                <MudTh Style="width:280px">Item</MudTh>
                <MudTh Style="width:120px">Quantity</MudTh>
                <MudTh>Serial numbers</MudTh>
                <MudTh Style="width:160px">Batch</MudTh>
                <MudTh Style="width:48px" />
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudSelect T="int" @bind-Value="context.ItemId" Dense="true" Margin="Margin.Dense">
                        @foreach (var i in _items)
                        {
                            <MudSelectItem T="int" Value="@i.Id">@i.Code — @i.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0"
                                     Margin="Margin.Dense" />
                </MudTd>
                <MudTd>
                    <MudTextField @bind-Value="context.Serials" Margin="Margin.Dense"
                                  Placeholder="Comma separated — serialised items only" />
                </MudTd>
                <MudTd>
                    <MudTextField @bind-Value="context.Batch" Margin="Margin.Dense" Placeholder="Batch" />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                   OnClick="@(() => Remove(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => _lines.Add(new Row()))" Class="mt-2">Add line</MudButton>

        <MudTextField @bind-Value="_notes" Label="Notes" Lines="2"
                      Variant="Variant.Outlined" Class="mt-4" />
    </Body>

    <Buttons>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="PostAsync" Disabled="_busy"
                   StartIcon="@Icons.Material.Outlined.Send">
            Post return
        </MudButton>
    </Buttons>
</DocumentShell>

@code {
    [Parameter] public bool AsDialog { get; set; }
    [Parameter] public bool SupplierReturns { get; set; }

    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private IReadOnlyList<Party> _parties = [];
    private IReadOnlyList<TradeItem> _items = [];
    private List<Row> _lines = [new()];

    private int _partyId;
    private DateTime? _date;
    private string _reason = "";
    private string? _source, _notes, _error;
    private bool _busy;

    private string Title => SupplierReturns ? "Record a supplier return" : "Record a customer return";

    private string Subtitle => SupplierReturns
        ? "Goods going back to a supplier. Posting takes the stock off the shelf."
        : "Goods a customer sent back. Posting puts the stock onto the shelf.";

    /// <summary>One sequential load: everything here shares the circuit's DbContext.</summary>
    protected override async Task OnInitializedAsync()
    {
        var book = await Stock.DefaultBookAsync();
        _items = book is null ? [] : await Stock.ItemsAsync(book.Id);

        _parties = await PartyMaster.ListAsync(
            customers: SupplierReturns ? null : true,
            suppliers: SupplierReturns ? true : null);

        _date = Clock.Today.ToDateTime(TimeOnly.MinValue);
        if (_parties.Count > 0) _partyId = _parties[0].Id;
    }

    private void Remove(Row row)
    {
        _lines.Remove(row);
        if (_lines.Count == 0) _lines.Add(new Row());
    }

    private async Task PostAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var party = _parties.FirstOrDefault(p => p.Id == _partyId);
            if (party is null) { _error = $"Choose a {(SupplierReturns ? "supplier" : "customer")}."; return; }

            var lines = _lines.Where(l => l.ItemId != 0 && l.Quantity > 0).ToList();
            if (lines.Count == 0) { _error = "Add at least one line with an item and a quantity."; return; }

            var result = await Stock.PostReturnAsync(new TradeReturnInput(
                SupplierReturns, party.Id, party.Name,
                DateOnly.FromDateTime(_date ?? Clock.Today.ToDateTime(TimeOnly.MinValue)),
                _source, _reason, _notes,
                [.. lines.Select(l => new TradeReturnLineInput(l.ItemId, l.Quantity, l.Serials, l.Batch))]));

            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add($"{result.Value.Number} posted.", Severity.Success);
            await Saved.InvokeAsync();

            // A posted return is finished either way: close the dialog, or
            // leave the page it was raised from.
            if (AsDialog && _shell is not null) await _shell.CloseAsync();
            else await DismissedAsync();
        }
        finally { _busy = false; }
    }

    private DocumentShell? _shell;
    
    /// <summary>The shell has already closed itself; just react to it.</summary>
    private async Task DismissedAsync()
    {
        if (Closed.HasDelegate) { await Closed.InvokeAsync(); return; }
        Nav.NavigateTo(SupplierReturns ? "/purchase/returns" : "/sales/returns");
    }

    private sealed class Row
    {
        public int ItemId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public string? Serials { get; set; }
        public string? Batch { get; set; }
    }
}
