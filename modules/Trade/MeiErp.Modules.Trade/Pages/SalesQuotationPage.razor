@page "/sales/quotations/new"
@page "/sales/quotations/{Id:int}"
@attribute [Authorize(Policy = SalesModule.QuotationsManage)]
@rendermode InteractiveServer

@* The dialog and this page render the same editor; only the frame differs.
   ?jobId= or ?intakeId= arrives from the workshop, which is how a job gets
   quoted without anyone re-typing the work. *@
<QuotationEditor AsDialog="false" IsPurchase="false"
                 QuotationId="Id" JobId="JobId" IntakeId="IntakeId" />

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] private int? JobId { get; set; }
    [SupplyParameterFromQuery] private int? IntakeId { get; set; }
}
