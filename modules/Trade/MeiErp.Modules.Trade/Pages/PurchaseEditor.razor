@page "/purchase/part-purchases/new"
@attribute [Authorize(Policy = PurchaseModule.OrdersManage)]
@rendermode InteractiveServer
@inject IPartProcurementService Procurement
@inject IPartyService PartyMaster
@inject NavigationManager Nav
@inject ISnackbar Snackbar
<PageTitle>Receive part purchase</PageTitle>
<MudText Typo="Typo.h5">Receive part purchase</MudText>
<MudPaper Class="pa-4 my-4" Outlined="true"><MudGrid><MudItem xs="12" md="4"><MudSelect T="int" @bind-Value="_supplier" Label="Supplier">@foreach(var s in _suppliers){<MudSelectItem Value="s.Id">@s.Name</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" md="3"><MudDatePicker @bind-Date="_date" Label="Purchase date"/></MudItem><MudItem xs="12" md="3"><MudTextField @bind-Value="_invoice" Label="Supplier invoice"/></MudItem></MudGrid></MudPaper>
<MudTable Items="_lines" Dense="true"><HeaderContent><MudTh>Part</MudTh><MudTh>Qty</MudTh><MudTh>Unit cost</MudTh><MudTh>New selling price</MudTh><MudTh>Amount</MudTh><MudTh/></HeaderContent><RowTemplate><MudTd><MudSelect T="int" @bind-Value="context.PartId">@foreach(var p in _parts){<MudSelectItem Value="p.Id">@p.Name</MudSelectItem>}</MudSelect></MudTd><MudTd><MudNumericField @bind-Value="context.Quantity"/></MudTd><MudTd><MudNumericField @bind-Value="context.UnitCost"/></MudTd><MudTd><MudNumericField @bind-Value="context.NewSellingPrice"/></MudTd><MudTd>@((context.Quantity*context.UnitCost).ToString("N2"))</MudTd><MudTd><MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>_lines.Remove(context))"/></MudTd></RowTemplate></MudTable>
<MudButton Class="my-3" OnClick="@(()=>_lines.Add(new()))">Add line</MudButton><MudGrid><MudItem xs="6" md="2"><MudNumericField @bind-Value="_discount" Label="Discount"/></MudItem><MudItem xs="6" md="2"><MudNumericField @bind-Value="_tax" Label="Tax"/></MudItem><MudItem xs="6" md="2"><MudNumericField @bind-Value="_charges" Label="Other charges"/></MudItem><MudItem xs="12" md="6"><MudTextField @bind-Value="_notes" Label="Notes"/></MudItem></MudGrid><MudButton Variant="Variant.Filled" OnClick="Save" Class="mt-4">Receive purchase</MudButton>
@code{private IReadOnlyList<Party> _suppliers=[];private IReadOnlyList<Part> _parts=[];private List<Line> _lines=[new()];private int _supplier;private DateTime? _date;private string? _invoice,_notes;private decimal _discount,_tax,_charges;protected override async Task OnInitializedAsync(){_date=Clock.Today.ToDateTime(TimeOnly.MinValue);_suppliers=await PartyMaster.ListAsync(suppliers:true);_parts=await Procurement.PartsAsync();}private async Task Save(){var input=new PartPurchaseInput(_supplier,_invoice,DateOnly.FromDateTime(_date??Clock.Today.ToDateTime(TimeOnly.MinValue)),_tax,_discount,_charges,_notes,_lines.Select(x=>new PartPurchaseLineInput(x.PartId,x.Quantity,x.UnitCost,x.NewSellingPrice,null)).ToList());var r=await Procurement.ReceiveAsync(input);Snackbar.Add(r.Ok?"Purchase received and costs updated.":r.Error!,r.Ok?Severity.Success:Severity.Error);if(r.Ok)Nav.NavigateTo("/purchase/part-purchases");}private sealed class Line{public int PartId{get;set;}public decimal Quantity{get;set;}=1;public decimal UnitCost{get;set;}public decimal? NewSellingPrice{get;set;}}}
