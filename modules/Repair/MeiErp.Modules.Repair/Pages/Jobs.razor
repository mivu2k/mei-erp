@page "/repair"
@page "/repair/jobs"
@attribute [Authorize(Policy = RepairModule.JobsView)]
@rendermode InteractiveServer
@inject IRepairService Workshop
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<ListShell Title="Repair jobs"
           PreferenceKey="repair-jobs" @bind-ViewMode="_viewMode"
           Subtitle="A job moves through the pipeline in order — it cannot be typed into any state."
           Icon="@Icons.Material.Outlined.Handyman"
           Loading="_loading"
           IsEmpty="@(_rows.Count == 0)"
           EmptyIcon="@Icons.Material.Outlined.Handyman"
           EmptyTitle="No jobs on the bench"
           EmptyHint="Take a device in to open a job and start tracking it through the workshop.">
    <Actions>
        <AuthorizeView Policy="@RepairModule.JobsManage" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    Take in a device
                </MudButton>
                <MudTooltip Text="Open as a full page instead">
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="/repair/jobs/new" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </Actions>

    <EmptyAction>
        <AuthorizeView Policy="@RepairModule.JobsManage" Context="perms">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
                    Take in a device
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </EmptyAction>

    <Toolbar>
        <MudSelect T="JobStatus?" @bind-Value="_status" @bind-Value:after="LoadAsync"
                   Label="Status" Clearable="true" Dense="true" Margin="Margin.Dense"
                   Variant="Variant.Outlined" Class="mt-0" Style="max-width:200px">
            @foreach (var s in Enum.GetValues<JobStatus>())
            {
                <MudSelectItem T="JobStatus?" Value="@s">@s</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_search" @bind-Value:after="LoadAsync"
                      Placeholder="Job number, customer or serial" DebounceInterval="300"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0" />
    </Toolbar>

    <ChildContent>
    <ResponsiveDataView TItem="Job" Items="_rows" Mode="_viewMode">
    <ListContent><MudDataGrid T="Job" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(j => j.Number)" Title="Job" />
            <TemplateColumn Title="Device">
                <CellTemplate>
                    <MudText Typo="Typo.body2">
                        <b>@context.Item.DeviceType</b> @context.Item.Make @context.Item.Model
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.Item.CustomerName
                        @if (context.Item.SerialNumber is not null)
                        {
                            <text> · @context.Item.SerialNumber</text>
                        }
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Received">
                <CellTemplate>@context.Item.ReceivedOn.ToString("d MMM")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@Colour(context.Item.Status)">@context.Item.Status</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Value" HeaderClass="text-right" CellClass="text-right">
                <CellTemplate>
                    <span style="font-variant-numeric:tabular-nums">
                        @(context.Item.Total == 0 ? "—" : context.Item.Total.ToString("N2"))
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div class="d-flex justify-end gap-1">
                        <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                       Href="@($"/repair/jobs/{context.Item.Id}")" title="Open as a page" />
                        <MudIconButton Icon="@Icons.Material.Outlined.PhotoLibrary" Href="@($"/repair/jobs/{context.Item.Id}/photos")" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Print" Href="@($"/print/repair/job/{context.Item.Id}")" Target="_blank" />
                        <MudIconButton Icon="@Icons.Material.Outlined.QrCode" Href="@($"/print/repair/job/{context.Item.Id}?kind=label")" Target="_blank" />
                        <AuthorizeView Policy="@RepairModule.JobsManage" Context="perms">
                            <Authorized>
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                               OnClick="@(() => Edit(context.Item))" title="Edit" />
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           OnClick="@(() => Work(context.Item))">Work</MudButton>
                                <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                               Href="@($"/repair/jobs/{context.Item.Id}/work")" title="Open work as a page" />
                            </Authorized>
                        </AuthorizeView>

                        @if (context.Item.Status is JobStatus.Completed)
                        {
                            <AuthorizeView Policy="@RepairModule.JobsDeliver" Context="perms">
                                <Authorized>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                               OnClick="@(() => Deliver(context.Item))">Deliver</MudButton>
                                </Authorized>
                            </AuthorizeView>
                        }
                        else if (JobWorkflow.Next(context.Item.Status).Count > 0)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true"
                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                @foreach (var next in JobWorkflow.Next(context.Item.Status)
                                                                 .Where(n => n != JobStatus.Delivered))
                                {
                                    <MudMenuItem OnClick="@(() => Move(context.Item, next))">
                                        Move to @next
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid></ListContent>
    <CardTemplate Context="job">
        <EntityCard Reference="@job.Number" Title="@($"{job.DeviceType} {job.Make} {job.Model}")" Subtitle="@job.CustomerName">
            <Status><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@Colour(job.Status)">@job.Status</MudChip></Status>
            <Body>
                <div class="app-entity-fact"><small>Received</small><span>@job.ReceivedOn.ToString("d MMM yyyy")</span></div>
                <div class="app-entity-fact"><small>Value</small><strong>@(job.Total==0?"—":job.Total.ToString("N2"))</strong></div>
                <div class="app-entity-fact"><small>Serial</small><span>@(job.SerialNumber??"—")</span></div>
                <div class="app-entity-fact"><small>Problem</small><span>@job.ReportedFault</span></div>
            </Body>
            <Actions>
                <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Href="@($"/repair/jobs/{job.Id}")"/>
                <MudIconButton Icon="@Icons.Material.Outlined.Print" Size="Size.Small" Href="@($"/print/repair/job/{job.Id}")" Target="_blank"/>
                <AuthorizeView Policy="@RepairModule.JobsManage"><Authorized><MudButton Size="Size.Small" OnClick="@(()=>Edit(job))">Edit</MudButton><MudButton Size="Size.Small" OnClick="@(()=>Work(job))">Work</MudButton></Authorized></AuthorizeView>
                @if(job.Status==JobStatus.Completed){<AuthorizeView Policy="@RepairModule.JobsDeliver"><Authorized><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="@(()=>Deliver(job))">Deliver</MudButton></Authorized></AuthorizeView>}
            </Actions>
        </EntityCard>
    </CardTemplate>
    </ResponsiveDataView>
    </ChildContent>
</ListShell>

@if (_editingJob)
{
    <JobEditor AsDialog="true" JobId="_editingJobId"
               Saved="LoadAsync" Closed="@(() => { _editingJob = false; return Task.CompletedTask; })" />
}

@if (_editingWork)
{
    <WorkEditor AsDialog="true" JobId="_editingWorkJobId"
                Saved="LoadAsync" Closed="@(() => { _editingWork = false; return Task.CompletedTask; })" />
}

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    private IReadOnlyList<Job> _rows = [];
    private JobStatus? _status;
    private string? _search;
    private bool _loading = true;
    private EntityViewMode _viewMode;

    protected override Task OnParametersSetAsync() { if (!string.IsNullOrWhiteSpace(Search)) _search = Search; return LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Workshop.ListAsync(_status, _search);
        _loading = false;
    }

    private static Color Colour(JobStatus status) => status switch
    {
        JobStatus.Delivered => Color.Success,
        JobStatus.Completed => Color.Info,
        JobStatus.InProgress => Color.Primary,
        JobStatus.AwaitingApproval => Color.Warning,
        JobStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private bool _editingJob;
    private int? _editingJobId;

    private void Edit(Job? row)
    {
        _editingJobId = row?.Id;
        _editingJob = true;
    }

    private bool _editingWork;
    private int _editingWorkJobId;

    private void Work(Job row)
    {
        _editingWorkJobId = row.Id;
        _editingWork = true;
    }

    private async Task Move(Job row, JobStatus to)
    {
        var result = await Workshop.MoveAsync(row.Id, to, null);
        if (result.Failed) Snackbar.Add(result.Error!, Severity.Error);
        else Snackbar.Add($"{row.Number} moved to {to}.", Severity.Success);
        await LoadAsync();
    }

    private async Task Deliver(Job row)
    {
        var parameters = new DialogParameters<DeliverJob>
        {
            { x => x.JobId, row.Id },
            { x => x.JobNumber, row.Number }
        };
        var dialog = await Dialogs.ShowAsync<DeliverJob>("Hand back the device", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        if (!(await dialog.Result)!.Canceled) await LoadAsync();
    }
}
