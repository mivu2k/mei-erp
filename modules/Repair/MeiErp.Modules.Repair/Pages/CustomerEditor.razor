@inject IRepairService Workshop
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.Name" Label="Name" Required="true"
                          RequiredError="Give them a name." Variant="Variant.Outlined" Class="mb-4" />

            <div class="d-flex gap-3 mb-4">
                <MudTextField @bind-Value="_model.Phone" Label="Phone" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" />
            </div>

            <MudTextField @bind-Value="_model.Address" Label="Address" Lines="2"
                          Variant="Variant.Outlined" />
        </MudForm>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Customer? Existing { get; set; }

    private MudForm? _form;
    private Customer _model = new();
    private string? _error;
    private bool _busy;

    protected override void OnInitialized() =>
        _model = Existing is null
            ? new Customer { IsActive = true }
            : new Customer
            {
                Id = Existing.Id, Code = Existing.Code, Name = Existing.Name,
                Phone = Existing.Phone, Email = Existing.Email,
                Address = Existing.Address, IsActive = Existing.IsActive
            };

    private async Task SaveAsync()
    {
        _error = null;
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _busy = true;
        try
        {
            var result = await Workshop.SaveCustomerAsync(_model);
            if (result.Failed) { _error = result.Error; return; }

            Snackbar.Add("Saved.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }
}
