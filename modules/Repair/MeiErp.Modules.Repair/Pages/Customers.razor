@page "/repair/customers"
@attribute [Authorize(Policy = RepairModule.CustomersManage)]
@rendermode InteractiveServer
@inject IRepairService Workshop
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Repair customers</PageTitle>

<div class="d-flex align-center mb-1">
    <div>
        <MudText Typo="Typo.h5">Customers</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            People whose equipment we repair.
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(null))">
        New customer
    </MudButton>
</div>

<MudPaper Outlined="true" Elevation="0" Class="mt-4">
    <MudToolBar Dense="true">
        <MudTextField @bind-Value="_search" @bind-Value:after="LoadAsync"
                      Placeholder="Search name or phone" DebounceInterval="300"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Text" Margin="Margin.Dense" Class="mt-0" />
    </MudToolBar>

    <MudDataGrid T="Customer" Items="_rows" Dense="true" Hover="true" Elevation="0"
                 Loading="_loading" Filterable="false" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="@(c => c.Code)" Title="Code" />
            <PropertyColumn Property="@(c => c.Name)" Title="Name" />
            <PropertyColumn Property="@(c => c.Phone)" Title="Phone" />
            <PropertyColumn Property="@(c => c.Email)" Title="Email" />
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div class="d-flex justify-end">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       OnClick="@(() => Edit(context.Item))" />
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-8 text-center mud-text-secondary">
                No customers yet. Add one before booking a device in.
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@code {
    private IReadOnlyList<Customer> _rows = [];
    private string? _search;
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await Workshop.CustomersAsync(_search);
        _loading = false;
    }

    private async Task Edit(Customer? row)
    {
        var parameters = new DialogParameters<CustomerEditor> { { x => x.Existing, row } };
        var dialog = await Dialogs.ShowAsync<CustomerEditor>(
            row is null ? "New customer" : "Edit customer", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        if (!(await dialog.Result)!.Canceled) await LoadAsync();
    }
}
