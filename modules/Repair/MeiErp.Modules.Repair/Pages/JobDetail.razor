@page "/repair/jobs/{Id:int}"
@attribute [Authorize(Policy = RepairModule.JobsView)]
@rendermode InteractiveServer
@inject IRepairService Workshop
@inject IRepairWorkshopDepthService Depth
@inject ISnackbar Snackbar
<PageTitle>Repair job</PageTitle>
@if(_job is null){<MudProgressCircular Indeterminate="true"/>}else{<div class="d-flex align-center"><div><MudText Typo="Typo.h5">@_job.Number</MudText><MudText Typo="Typo.body2">@_job.CustomerName · @_job.DeviceType @_job.Make @_job.Model</MudText></div><MudSpacer/><MudButton Href="@($"/print/repair/job/{Id}")" Target="_blank" StartIcon="@Icons.Material.Outlined.Print">Job card</MudButton><MudButton Href="@($"/print/repair/job/{Id}?kind=label")" Target="_blank">Label</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.RequestQuote" Href="@($"/sales/quotations/new?jobId={Id}")">Quote this job</MudButton><AuthorizeView Policy="@RepairModule.JobsManage"><Authorized><MudButton Href="@($"/repair/jobs/{Id}/edit")" StartIcon="@Icons.Material.Outlined.Edit">Edit job</MudButton></Authorized></AuthorizeView></div>
<MudGrid Class="mt-3"><MudItem xs="12" md="5"><MudPaper Class="pa-4" Style="height:100%"><MudText Typo="Typo.subtitle1">Device and customer</MudText><MudSimpleTable Dense="true"><tbody><tr><td>Status</td><td>@_job.Status</td></tr><tr><td>Priority</td><td>@_job.Priority</td></tr><tr><td>Serial</td><td>@_job.SerialNumber</td></tr><tr><td>Condition</td><td>@_job.Condition</td></tr><tr><td>Accessories</td><td>@_job.Accessories</td></tr><tr><td>Reported fault</td><td>@_job.ReportedFault</td></tr><tr><td>Promised</td><td>@_job.PromisedOn?.ToString("d MMM yyyy")</td></tr><tr><td>Technician</td><td>@_job.AssignedToName</td></tr></tbody></MudSimpleTable></MudPaper></MudItem><MudItem xs="12" md="7"><MudPaper Class="pa-4" Style="height:100%"><div class="d-flex"><MudText Typo="Typo.subtitle1">Status history</MudText><MudSpacer/></div><MudTimeline TimelinePosition="TimelinePosition.Start">@foreach(var h in _history){<MudTimelineItem Size="Size.Small"><MudText Typo="Typo.body2"><b>@h.ToStatus</b> — @h.ChangedByName</MudText><MudText Typo="Typo.caption">@h.ChangedUtc.ToLocalTime().ToString("g") @if(!string.IsNullOrWhiteSpace(h.Note)){<text> · @h.Note</text>}</MudText></MudTimelineItem>}</MudTimeline></MudPaper></MudItem></MudGrid>
<MudPaper Class="pa-4 mt-3"><div class="d-flex"><MudText Typo="Typo.subtitle1">Technical diagnoses</MudText><MudSpacer/><AuthorizeView Policy="@RepairModule.Diagnose"><Authorized><MudButton OnClick="@(()=>_adding=true)" StartIcon="@Icons.Material.Outlined.Add">Add diagnosis</MudButton></Authorized></AuthorizeView></div>@if(_adding){<MudGrid Class="my-2"><MudItem xs="12"><MudTextField @bind-Value="_findings" Label="Findings" Lines="3"/></MudItem><MudItem xs="12" md="4"><MudTextField @bind-Value="_parts" Label="Required parts"/></MudItem><MudItem xs="12" md="4"><MudTextField @bind-Value="_labour" Label="Required labour"/></MudItem><MudItem xs="6" md="2"><MudNumericField @bind-Value="_days" Label="Est. days"/></MudItem><MudItem xs="6" md="2"><MudNumericField @bind-Value="_hours" Label="Est. hours"/></MudItem><MudItem xs="12"><MudTextField @bind-Value="_performed" Label="Work performed" Lines="2"/></MudItem></MudGrid><MudButton Variant="Variant.Filled" OnClick="SaveDiagnosis">Save diagnosis</MudButton><MudButton OnClick="@(()=>_adding=false)">Cancel</MudButton>}@foreach(var d in _diagnoses){<MudPaper Class="pa-3 mt-3" Outlined="true"><MudText><b>@d.TechnicianName</b> · @d.CreatedUtc.ToLocalTime().ToString("g")</MudText><MudText Class="mt-2">@d.Findings</MudText>@if(!string.IsNullOrWhiteSpace(d.RequiredParts)){<MudText Typo="Typo.caption">Parts: @d.RequiredParts</MudText>}@if(!string.IsNullOrWhiteSpace(d.WorkPerformed)){<MudText Typo="Typo.caption">Work: @d.WorkPerformed</MudText>}</MudPaper>}@if(_diagnoses.Count==0){<MudText Class="mt-3">No diagnosis recorded.</MudText>}</MudPaper>
<MudPaper Class="pa-4 mt-3"><div class="d-flex"><MudText Typo="Typo.subtitle1">Parts and labour</MudText><MudSpacer/><AuthorizeView Policy="@RepairModule.JobsManage"><Authorized><MudButton OnClick="@(()=>_editingWork=true)">Edit work</MudButton><MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" Href="@($"/repair/jobs/{Id}/work")" title="Open as a page"/></Authorized></AuthorizeView></div><MudTable Items="_job.WorkItems" Dense="true"><HeaderContent><MudTh>Kind</MudTh><MudTh>Description</MudTh><MudTh>Qty</MudTh><MudTh>Rate</MudTh><MudTh>Total</MudTh></HeaderContent><RowTemplate><MudTd>@context.Kind</MudTd><MudTd>@context.Description @(context.IsBillable?"":"(not billed)")</MudTd><MudTd>@context.Quantity.ToString("N2")</MudTd><MudTd>@context.UnitPrice.ToString("N2")</MudTd><MudTd>@context.LineTotal.ToString("N2")</MudTd></RowTemplate></MudTable><MudText Align="Align.Right" Typo="Typo.h6">Billable total: @_job.Total.ToString("N2")</MudText></MudPaper>
@if(_editingWork){<WorkEditor AsDialog="true" JobId="Id" Saved="Load" Closed="@(()=>{_editingWork=false;return Task.CompletedTask;})"/>}
}
@code{[Parameter]public int Id{get;set;}private Job? _job;private IReadOnlyList<RepairDiagnosis> _diagnoses=[];private IReadOnlyList<RepairStatusHistory> _history=[];private bool _adding;private bool _editingWork;private string _findings="";private string? _parts,_labour,_performed;private int? _days;private decimal? _hours;protected override Task OnParametersSetAsync()=>Load();private async Task Load(){_job=await Workshop.GetAsync(Id);_diagnoses=await Depth.DiagnosesAsync(Id);_history=await Depth.HistoryAsync(Id);}private async Task SaveDiagnosis(){var r=await Depth.AddDiagnosisAsync(Id,new(_findings,_parts,_labour,_days,_hours,_performed,null));Snackbar.Add(r.Ok?"Diagnosis recorded.":r.Error!,r.Ok?Severity.Success:Severity.Error);if(r.Ok){_adding=false;_findings="";await Load();}}}
