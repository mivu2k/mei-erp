@page "/repair/setup"
@attribute [Authorize(Policy = RepairModule.CatalogManage)]
@rendermode InteractiveServer
@inject IRepairWorkshopDepthService Depth
@inject ISnackbar Snackbar
<PageTitle>Repair setup</PageTitle>
<MudText Typo="Typo.h5">Workshop setup</MudText><MudText Typo="Typo.body2" Class="mb-4">Maintain the controlled lists used at intake and diagnosis.</MudText>
<MudGrid>@foreach(var kind in Enum.GetValues<RepairCatalogKind>()){<MudItem xs="12" md="6"><MudPaper Class="pa-4" Style="height:100%"><MudText Typo="Typo.subtitle1">@Title(kind)</MudText><div class="d-flex gap-2 my-3"><MudTextField @bind-Value="_names[kind]" Label="Name"/><MudTextField @bind-Value="_categories[kind]" Label="Category" Disabled="@(kind!=RepairCatalogKind.Symptom)"/><MudButton Variant="Variant.Filled" OnClick="@(()=>Add(kind))">Add</MudButton></div><MudTable Items="Rows(kind)" Dense="true"><HeaderContent><MudTh>Name</MudTh><MudTh>Category</MudTh><MudTh/></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@context.Category</MudTd><MudTd><MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>Remove(context.Id))"/></MudTd></RowTemplate></MudTable></MudPaper></MudItem>}</MudGrid>
@code{private readonly Dictionary<RepairCatalogKind,string> _names=Enum.GetValues<RepairCatalogKind>().ToDictionary(x=>x,_=>"");private readonly Dictionary<RepairCatalogKind,string> _categories=Enum.GetValues<RepairCatalogKind>().ToDictionary(x=>x,_=>"");private readonly Dictionary<RepairCatalogKind,IReadOnlyList<RepairCatalogItem>> _rows=[];protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){foreach(var k in Enum.GetValues<RepairCatalogKind>())_rows[k]=await Depth.CatalogAsync(k);}private IReadOnlyList<RepairCatalogItem> Rows(RepairCatalogKind k)=>_rows.GetValueOrDefault(k,[]);private static string Title(RepairCatalogKind k)=>k switch{RepairCatalogKind.DeviceType=>"Device types",RepairCatalogKind.Accessory=>"Accessories",RepairCatalogKind.Symptom=>"Symptoms",_=>"Brands"};private async Task Add(RepairCatalogKind k){var r=await Depth.AddCatalogAsync(k,_names[k],_categories[k]);Snackbar.Add(r.Ok?"Entry added.":r.Error!,r.Ok?Severity.Success:Severity.Error);if(r.Ok){_names[k]="";_categories[k]="";await Load();}}private async Task Remove(int id){var r=await Depth.RemoveCatalogAsync(id);Snackbar.Add(r.Ok?"Entry removed.":r.Error!,r.Ok?Severity.Success:Severity.Error);if(r.Ok)await Load();}}
