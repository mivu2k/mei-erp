@page "/repair/intakes/new"
@attribute [Authorize(Policy = RepairModule.IntakesManage)]
@rendermode InteractiveServer
@inject IRepairIntakeService Intakes
@inject IRepairService Workshop
@inject IRepairCustomerDirectory Directory
@inject IRepairWorkshopDepthService Depth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
<PageTitle>Book devices in</PageTitle>
<div class="d-flex align-center"><div><MudText Typo="Typo.h5">Book devices in</MudText><MudText Typo="Typo.body2">Create one intake receipt and one job per device.</MudText></div><MudSpacer/><MudButton Variant="Variant.Filled" OnClick="Receive">Receive @_devices.Count device(s)</MudButton></div>
<MudPaper Class="pa-4 my-4" Outlined="true"><MudSelect T="int" @bind-Value="_customer" Label="Customer">@foreach(var c in _customers){<MudSelectItem Value="c.Id">@c.Name @(c.Phone is null?"":$"({c.Phone})")</MudSelectItem>}</MudSelect><MudSelect T="IntakePaymentBasis" @bind-Value="_payment" Label="Payment basis" Class="mt-3">@foreach(var p in Enum.GetValues<IntakePaymentBasis>()){<MudSelectItem Value="p">@p</MudSelectItem>}</MudSelect><MudTextField @bind-Value="_notes" Label="Intake notes" Lines="2" Class="mt-3"/></MudPaper>
@foreach(var device in _devices){<MudPaper Class="pa-4 mb-3" Outlined="true"><div class="d-flex"><MudText Typo="Typo.subtitle1">Device @(_devices.IndexOf(device)+1)</MudText><MudSpacer/>@if(_devices.Count>1){<MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>_devices.Remove(device))"/>}</div><MudGrid><MudItem xs="12" md="3"><MudAutocomplete T="string" @bind-Value="device.DeviceType" Label="Device type" Required="true" SearchFunc="@((s,_)=>Search(_deviceTypes,s))" CoerceValue="true"/></MudItem><MudItem xs="6" md="2"><MudAutocomplete T="string" @bind-Value="device.Make" Label="Make" SearchFunc="@((s,_)=>Search(_brands,s))" CoerceValue="true"/></MudItem><MudItem xs="6" md="2"><MudTextField @bind-Value="device.Model" Label="Model"/></MudItem><MudItem xs="12" md="3"><MudTextField @bind-Value="device.SerialNumber" Label="Serial number"/></MudItem><MudItem xs="6" md="2"><MudSelect T="DeviceCondition" @bind-Value="device.Condition" Label="Condition">@foreach(var x in Enum.GetValues<DeviceCondition>()){<MudSelectItem Value="x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="6" md="2"><MudSelect T="RepairPriority" @bind-Value="device.Priority" Label="Priority">@foreach(var x in Enum.GetValues<RepairPriority>()){<MudSelectItem Value="x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" md="3"><MudDatePicker @bind-Date="device.Promised" Label="Promised by"/></MudItem><MudItem xs="12" md="3"><MudSelect T="string" MultiSelection="true" @bind-SelectedValues="device.Accessories" Label="Accessories">@foreach(var x in _accessories){<MudSelectItem Value="x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" md="4"><MudSelect T="string" MultiSelection="true" @bind-SelectedValues="device.Symptoms" Label="Symptoms">@foreach(var x in _symptoms){<MudSelectItem Value="x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12"><MudTextField @bind-Value="device.ReportedFault" Label="Reported fault" Required="true" Lines="2"/></MudItem></MudGrid></MudPaper>}
<MudButton OnClick="@(()=>_devices.Add(new()))" StartIcon="@Icons.Material.Outlined.Add">Add another device</MudButton>
@code{private IReadOnlyList<RepairCustomer> _customers=[];private List<string> _deviceTypes=[],_brands=[],_accessories=[],_symptoms=[];private int _customer;private IntakePaymentBasis _payment;private string? _notes;private List<Device> _devices=[new()];protected override async Task OnInitializedAsync(){_customers=await Directory.SearchAsync();_deviceTypes=(await Depth.CatalogAsync(RepairCatalogKind.DeviceType)).Select(x=>x.Name).ToList();_brands=(await Depth.CatalogAsync(RepairCatalogKind.Brand)).Select(x=>x.Name).ToList();_accessories=(await Depth.CatalogAsync(RepairCatalogKind.Accessory)).Select(x=>x.Name).ToList();_symptoms=(await Depth.CatalogAsync(RepairCatalogKind.Symptom)).Select(x=>x.Name).ToList();if(_customers.Count>0)_customer=_customers[0].Id;}private static Task<IEnumerable<string>> Search(List<string> rows,string? value)=>Task.FromResult(string.IsNullOrWhiteSpace(value)?rows.AsEnumerable():rows.Where(x=>x.Contains(value,StringComparison.OrdinalIgnoreCase)));private async Task Receive(){var devices=_devices.Select(x=>new IntakeDeviceInput(x.DeviceType,x.Make,x.Model,x.SerialNumber,x.Condition,x.ReportedFault,x.Priority,x.Promised is null?null:DateOnly.FromDateTime(x.Promised.Value),string.Join(", ",x.Accessories),string.Join(", ",x.Symptoms))).ToList();var r=await Intakes.ReceiveAsync(new(_customer,_notes,devices,_payment));Snackbar.Add(r.Ok?$"{r.Value.Number} received with {r.Value.Jobs.Count} jobs.":r.Error!,r.Ok?Severity.Success:Severity.Error);if(r.Ok)Nav.NavigateTo("/repair/intakes");}private sealed class Device{public string DeviceType{get;set;}="";public string? Make{get;set;}public string? Model{get;set;}public string? SerialNumber{get;set;}public DeviceCondition Condition{get;set;}=DeviceCondition.Good;public RepairPriority Priority{get;set;}=RepairPriority.Normal;public DateTime? Promised{get;set;}public IEnumerable<string> Accessories{get;set;}=[];public IEnumerable<string> Symptoms{get;set;}=[];public string ReportedFault{get;set;}="";}}
