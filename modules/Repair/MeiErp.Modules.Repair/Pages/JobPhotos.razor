@page "/repair/jobs/{Id:int}/photos"
@attribute [Authorize(Policy = RepairModule.JobsView)]
@rendermode InteractiveServer
@inject IRepairPhotoService Photos
@inject IRepairService Workshop
@inject ISnackbar Snackbar
<PageTitle>Repair evidence</PageTitle>
@if(_job is not null){<div class="d-flex align-center"><div><MudText Typo="Typo.h5">@_job.Number evidence</MudText><MudText Typo="Typo.body2">Before, after, damage, and diagnostic files. Files are private and permission-checked.</MudText></div><MudSpacer/><MudButton Href="@($"/repair/jobs/{Id}")">Back to job</MudButton></div><AuthorizeView Policy="@RepairModule.Diagnose"><Authorized><MudPaper Class="pa-4 my-4" Outlined="true"><MudGrid><MudItem xs="12" md="3"><MudSelect T="RepairPhotoKind" @bind-Value="_kind" Label="Evidence type">@foreach(var k in Enum.GetValues<RepairPhotoKind>()){<MudSelectItem Value="k">@k</MudSelectItem>}</MudSelect></MudItem><MudItem xs="12" md="5"><MudTextField @bind-Value="_caption" Label="Caption"/></MudItem><MudItem xs="12" md="4"><MudFileUpload T="IBrowserFile" FilesChanged="Upload"><ActivatorContent><MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Upload">Choose and upload</MudButton></ActivatorContent></MudFileUpload></MudItem></MudGrid></MudPaper></Authorized></AuthorizeView><MudGrid>@foreach(var p in _rows){<MudItem xs="12" sm="6" md="4"><MudPaper Class="pa-3" Outlined="true"><MudChip T="string" Size="Size.Small">@p.Kind</MudChip><MudText Typo="Typo.subtitle2" Class="mt-2">@p.OriginalName</MudText><MudText Typo="Typo.body2">@p.Caption</MudText><MudText Typo="Typo.caption">@((p.Length/1024m).ToString("N0")) KB · @p.UploadedByName</MudText><div class="mt-2"><MudButton Href="@($"/repair/photo/{p.Id}")" Target="_blank">View</MudButton><AuthorizeView Policy="@RepairModule.Diagnose"><Authorized><MudButton Color="Color.Error" OnClick="@(()=>Remove(p.Id))">Remove</MudButton></Authorized></AuthorizeView></div></MudPaper></MudItem>}</MudGrid>}
@code{[Parameter]public int Id{get;set;}private Job? _job;private IReadOnlyList<RepairPhoto> _rows=[];private RepairPhotoKind _kind;private string? _caption;protected override async Task OnParametersSetAsync(){_job=await Workshop.GetAsync(Id);await Load();}private async Task Load()=>_rows=await Photos.ListAsync(Id);private async Task Upload(IBrowserFile? file){if(file is null)return;try{await using var stream=file.OpenReadStream(10*1024*1024);var r=await Photos.UploadAsync(Id,_kind,file.Name,file.ContentType,file.Size,_caption,stream);Snackbar.Add(r.Ok?"Evidence uploaded.":r.Error!,r.Ok?Severity.Success:Severity.Error);if(r.Ok){_caption=null;await Load();}}catch(IOException){Snackbar.Add("The selected file exceeds 10 MB.",Severity.Error);}}private async Task Remove(int id){var r=await Photos.RemoveAsync(id);Snackbar.Add(r.Ok?"Evidence removed.":r.Error!,r.Ok?Severity.Success:Severity.Error);if(r.Ok)await Load();}}
