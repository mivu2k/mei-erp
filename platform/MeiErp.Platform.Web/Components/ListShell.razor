@*
    The frame every list page in the app sits in.

    Before this each module invented its own header, its own spacing and its
    own idea of where the New button goes, so moving between modules felt like
    moving between applications. One shell means a change to the layout
    happens once, everywhere.

    It also fixes the thing that made these pages feel empty: a bare table on
    a dark ground with nothing above it. There is now a header block, an
    optional row of figures worth knowing before reading any row, and an
    empty state that tells you what to do rather than just saying there is
    nothing.
*@

<PageTitle>@Title</PageTitle>

<div class="app-page-header d-flex flex-wrap align-center gap-3 mb-4">
    <div style="flex:1 1 320px; min-width:0">
        <div class="d-flex align-center gap-2">
            @if (Icon is not null)
            {
                <MudIcon Icon="@Icon" Color="Color.Primary" Size="Size.Medium" />
            }
            <MudText Typo="Typo.h5">@Title</MudText>
        </div>
        @if (Subtitle is not null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@Subtitle</MudText>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="d-flex align-center gap-2 flex-wrap">@Actions</div>
    }
</div>

@if (Stats is not null)
{
    @* Figures worth knowing before reading a single row - what is outstanding,
       what is waiting on somebody. Laid out to wrap rather than scroll. *@
    <div class="d-flex flex-wrap gap-3 mb-4">@Stats</div>
}

<MudPaper Outlined="true" Elevation="0" Class="app-list-surface overflow-hidden">
    @if (Toolbar is not null)
    {
        <div class="d-flex flex-wrap align-center gap-2 pa-3 border-b">@Toolbar</div>
    }

    @if (Loading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
        </div>
    }
    else if (IsEmpty)
    {
        <div class="d-flex flex-column align-center justify-center pa-12 gap-2">
            <MudIcon Icon="@(EmptyIcon ?? Icons.Material.Outlined.Inbox)"
                     Size="Size.Large" Class="mud-text-secondary" />
            <MudText Typo="Typo.subtitle1">@(EmptyTitle ?? "Nothing here yet")</MudText>
            @if (EmptyHint is not null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary text-center" Style="max-width:420px">
                    @EmptyHint
                </MudText>
            }
            @if (EmptyAction is not null)
            {
                <div class="mt-2">@EmptyAction</div>
            }
        </div>
    }
    else
    {
        @ChildContent
    }
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }

    [Parameter] public bool Loading { get; set; }

    /// <summary>Swaps the table for the empty state, so a blank grid never shows.</summary>
    [Parameter] public bool IsEmpty { get; set; }

    [Parameter] public string? EmptyIcon { get; set; }
    [Parameter] public string? EmptyTitle { get; set; }
    [Parameter] public string? EmptyHint { get; set; }
    [Parameter] public RenderFragment? EmptyAction { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Stats { get; set; }
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
