<MudPaper Outlined="true" Elevation="0" Class="app-entity-card">
    <div class="app-entity-card-head">
        <div class="app-entity-card-heading">
            @if (!string.IsNullOrWhiteSpace(Reference))
            {
                <MudText Typo="Typo.overline" Class="app-entity-reference">@Reference</MudText>
            }
            <MudText Typo="Typo.subtitle1" Class="app-entity-title">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Subtitle</MudText>
            }
        </div>
        @if (Status is not null) { <div class="app-entity-status">@Status</div> }
    </div>
    @if (Body is not null) { <div class="app-entity-card-body">@Body</div> }
    @if (Actions is not null) { <div class="app-entity-card-actions">@Actions</div> }
</MudPaper>

@code {
    [Parameter] public string? Reference { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
